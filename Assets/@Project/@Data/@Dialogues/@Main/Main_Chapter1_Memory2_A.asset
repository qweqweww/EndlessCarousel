  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Memory2_A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBC15\uC218 \uC18C\uB9AC. \uADF8\uB9AC\uACE0 \uC815\uC801."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB300\uAE30\uC2E4. \uC190\uC774 \uCC28\uAC11\uB2E4. \uBA87 \uBC88\uC744
      \uC8FC\uBB3C\uB7EC\uB3C4 \uB370\uC6CC\uC9C0\uC9C0 \uC54A\uB294\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uC774\uBC88 \uB300\uD68C\uB9CC \uC798\uD558\uBA74 \uC7A5\uD559\uAE08
      \uB098\uC628\uB300."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uADF8\uAC70 \uB098\uC624\uBA74 \uB808\uC2A8\uBE44 \uAC71\uC815\uC740
      \uC548 \uD574\uB3C4 \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC54C\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uB108 \uD558\uB098 \uBBFF\uACE0 \uC5EC\uAE30\uAE4C\uC9C0 \uC654\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC54C\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB34\uB300. \uC870\uBA85. \uC2EC\uC0AC\uC704\uC6D0\uC11D\uC758 \uD39C
      \uC18C\uB9AC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC2EC\uC0AC\uC704\uC6D0"
    text: "\uB2E4\uC74C \uCC38\uAC00\uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC138 \uBC88\uC9F8 \uB9C8\uB514\uC5D0\uC11C \uC190\uAC00\uB77D\uC774
      \uBBF8\uB044\uB7EC\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uBAA8\uB97C \uB9CC\uD07C \uC791\uC740 \uC2E4\uC218\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC54C\uC558\uB2E4. \uC2EC\uC0AC\uC704\uC6D0\uB3C4 \uC54C\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC2EC\uC0AC\uC704\uC6D0"
    text: "2\uC704."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC15\uC218\uAC00 \uC3DF\uC544\uC84C\uB2E4. \uC7A5\uD559\uAE08\uC740
      1\uC704\uC5D0\uAC8C\uB9CC \uC8FC\uC5B4\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC0C1\uC7A5\uC744 \uAC00\uBC29 \uAC00\uC7A5 \uAE4A\uC740 \uACF3\uC5D0
      \uB123\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC2E4\uD328\uD558\uBA74 \uC548 \uB418\uB294 \uC0AC\uB78C\uC774, \uC2E4\uD328\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
