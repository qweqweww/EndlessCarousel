  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Memory_A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC74\uBC18 \uD558\uB098\uAC00 \uC800\uC808\uB85C \uC6B8\uB9B0 \uAC83
      \uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC0C8\uBCBD. \uC5F0\uC2B5\uC2E4. \uD615\uAD11\uB4F1 \uD558\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC19\uC740 \uB9C8\uB514\uB97C \uBC31 \uBC88\uC9F8 \uCE58\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD2C0\uB9B0 \uACF3\uC744 \uC14C\uB2E4. \uD558\uB098. \uB458. \uC14B."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uD2C0\uB9AC\uBA74 \uC548 \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uD2C0\uB9AC\uBA74 \uC548 \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC190\uAC00\uB77D\uC774 \uC544\uD320\uB2E4. \uADF8\uB798\uB3C4 \uBA48\uCD94\uBA74
      \uC548 \uB410\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uC81C\uBD80\uD130\uC600\uB294\uC9C0 \uBAB0\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD53C\uC544\uB178 \uC18C\uB9AC\uB97C \uB4E3\uB294 \uAC8C \uC544\uB2C8\uB77C,
      \uD2C0\uB9B0 \uC18C\uB9AC\uB9CC \uB4E3\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC88B\uC544\uC11C \uCCE4\uB358 \uAC8C
      \uC5B8\uC81C\uC600\uB294\uC9C0, \uAE30\uC5B5\uB098\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD53C\uC544\uB178 \uB69C\uAED1\uC744 \uB2EB\uB294 \uC18C\uB9AC\uAC00
      \uC720\uB09C\uD788 \uD06C\uAC8C \uB4E4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
