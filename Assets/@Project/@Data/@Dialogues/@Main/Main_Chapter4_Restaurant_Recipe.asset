  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Recipe
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC8FC\uBC29 \uBCBD\uC5D0 \uB808\uC2DC\uD53C \uCE74\uB4DC\uAC00 \uD55C
      \uC7A5 \uBD99\uC5B4 \uC788\uB2E4. \uC190\uAE00\uC528\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uAE40\uCE58\uBCF6\uC74C\uBC25 \u2014 \uAE40\uCE58\uB294 \uC798\uAC8C.
      \uC124\uD0D5 \uBC18 \uC21F\uAC08. \uACC4\uB780 2\uAC1C, \uBC18\uC219. \uD0C4
      \uAC74 \uB204\uB8FD\uC9C0\uB77C\uACE0 \uC6B0\uAE38 \uAC83.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uD558\uD558. \uB9C8\uC9C0\uB9C9 \uC904 \uBB50\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uB204\uB8FD\uC9C0\uB77C\uACE0\u2026 \uC6B0\uAE38 \uAC83."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uC6C3\uC9C0 \uC54A\uC558\uB2E4. \uCE74\uB4DC\uB97C \uD55C\uCC38
      \uBCF4\uB2E4\uAC00, \uC190\uBC14\uB2E5\uC73C\uB85C \uD55C \uBC88 \uC4F8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC774\uAC70 \uB9E8\uB0A0 \uD574 \uC92C\uC5B4. \uAE40\uBCF6."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uC81C\uC77C \uC26C\uC6B4 \uAC70\uB77C\uC11C. \uCC98\uC74C \uD560 \uC904
      \uC54C\uAC8C \uB41C \uAC8C \uADF8\uAC70\uB77C\uC11C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uB098\uC911\uC5D4 \uC9C4\uC9DC \uC798\uD588\uC5B4. \uC9C4\uC9DC\uB85C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\uC88B\uC544\uD588\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB58 \uADF8\uB7F0 \uAC78 \uBB3C\uC5B4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
