  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_AfterMemory1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB85C\uBE44\uB294 \uADF8\uB300\uB85C\uC600\uB2E4. \uC0AC\uC9C4 \uC18D
      \uC544\uC774\uB3C4 \uADF8\uB300\uB85C \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: A.
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC751."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uBC29\uAE08 \uBB54\uAC00 \uBCF8 \uAC70\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC870\uAE08."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB54\uB370. \uB9D0\uD574\uBD10."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\uBCC4\uAC70 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uD53C\uC544\uB178 \uCE58\uB358 \uC560\uAC00 \uC788\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8 \uC0AC\uC9C4 \uC18D \uC560?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uBAB0\uB77C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB0E5\u2026 \uADF8\uB7F0 \uAE30\uC5B5."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uB354 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC800\uAE30, A \uC528."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\uC65C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB54C\uB294\u2026"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uD53C\uC544\uB178 \uCE58\uB294 \uAC8C \uC88B\uC558\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "A\uC758 \uC785\uC774 \uC5F4\uB838\uB2E4\uAC00 \uB2EB\uD614\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC65C \uADF8\uAC78 \uBB3C\uC5B4."
    portrait: {fileID: 21300000, guid: 78e2c16278be20748807d3facc559a28, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544, \uADF8\uB0E5\uC694. \uC798\uD588\uB294\uC9C0\uBCF4\uB2E4\u2026
      \uADF8\uAC8C \uB354 \uAD81\uAE08\uD574\uC11C\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices:
    - text: "\uC88B\uC544\uD588\uB358 \uAC83 \uAC19\uC740\uB370."
      next: {fileID: 11400000, guid: 01094814c70e21943b3c8eabd05cbd59, type: 2}
      choiceId: Chapter1_A_Memory1_Response_LikedIt
      recordAsFlag: 1
    - text: "\uB300\uB2F5 \uC548 \uD574\uB3C4 \uB3FC."
      next: {fileID: 11400000, guid: abf62d72cb83d6c49abc29d6af2e2087, type: 2}
      choiceId: Chapter1_A_Memory1_Response_NoNeedToAnswer
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
