%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Memory1_B
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC5B4\uB450\uC6B4 \uBC29. \uC791\uC740 \uCE68\uB300\uC5D0 \uC5B4\uB9B0
      B\uAC00 \uB204\uC6CC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC774\uC81C \uB208 \uAC10\uC544\uC57C\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uC544\uC9C1 \uC548 \uC878\uB824\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC544\uAE4C\uB3C4 \uADF8\uB7AC\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uADF8\uB7EC\uB2E4 \uC544\uCE68\uC5D0 \uBABB \uC77C\uC5B4\uB098\uBA74
      \uC5B4\uB5A1\uD558\uB824\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uC624\uB298\uC740 \uB9CE\uC774 \uB180\uC558\uC73C\uB2C8\uAE4C \uAE08\uBC29
      \uC798 \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\u2026\u2026\uC870\uAE08\uB9CC \uB354 \uC788\uC73C\uBA74 \uC548 \uB3FC\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC870\uAE08\uB9CC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5C4\uB9C8\uAC00 B\uC758 \uC774\uBD88\uC744 \uBAA9\uAE4C\uC9C0 \uB04C\uC5B4\uC62C\uB824
      \uC900\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "B\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC5C4\uB9C8\uB791 \uC544\uBE60\uAC00 \uB108 \uB9CC\uB098\uAE30\uAE4C\uC9C0
      \uC815\uB9D0 \uC624\uB798 \uAE30\uB2E4\uB9B0 \uAC70 \uC54C\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uB9CE\uC774 \uAE30\uB2E4\uB9AC\uACE0, \uB9CE\uC774 \uAE30\uB3C4\uD588\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uC6B0\uB9AC \uB458\uB9CC \uAE30\uB3C4\uD55C \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uB2E4\uB4E4 \uAC19\uC774 \uAE30\uB3C4\uD574 \uC92C\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uADF8\uB7EC\uACE0 \uB098\uC11C \uB124\uAC00 \uC654\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5C4\uB9C8\uAC00 B\uC758 \uBA38\uB9AC\uCE74\uB77D\uC744 \uCC9C\uCC9C\uD788
      \uC4F8\uC5B4 \uB118\uAE34\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uB10C \uC2E0\uAED8\uC11C \uC6B0\uB9AC\uD55C\uD14C
      \uBCF4\uB0B4\uC8FC\uC2E0 \uC544\uC774\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\u2026\u2026\uC81C\uAC00\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC544\uC8FC \uC18C\uC911\uD55C \uC544\uC774."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uADF8\uB798\uC11C \uC5EC\uAE30 \uC788\uB294 \uBAA8\uB450\uAC00 \uB110
      \uC815\uB9D0 \uB9CE\uC774 \uC544\uAEF4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uC120\uC0DD\uB2D8\uB3C4\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uADF8\uB7FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uC606\uBC29 \uC544\uC8FC\uBA38\uB2C8\uB3C4\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uADF8\uBD84\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\u2026\u2026\uB2E4\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uB2E4\uB4E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B4\uB9B0 B\uAC00 \uC774\uBD88 \uC548\uC5D0\uC11C \uC791\uAC8C \uC6C3\uB294\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC6B0\uB9AC B\uB3C4 \uAC10\uC0AC\uD558\uB294
      \uB9C8\uC74C \uC78A\uC73C\uBA74 \uC548 \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC0AC\uB78C\uB4E4 \uB9D0\uB3C4 \uC798 \uB4E3\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uCC29\uD558\uAC8C \uC9C0\uB0B4\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\u2026\u2026\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC544\uBE60"
    text: "\uC6B0\uB9AC \uB538\uC740 \uC798\uD560 \uC218 \uC788\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5C4\uB9C8\uAC00 B\uC758 \uC774\uB9C8\uC5D0 \uAC00\uBCCD\uAC8C \uC785\uC744
      \uB9DE\uCD98\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC798 \uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5C4\uB9C8"
    text: "\uC2E0\uAED8\uC11C \uBCF4\uB0B4\uC8FC\uC2E0 \uC6B0\uB9AC \uC544\uC774."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB9B0 B"
    text: "\uC798 \uC790\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBD88\uC774 \uAEBC\uC9C4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uB9D0\uC740 \uD2B9\uBCC4\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C \uBC88\uB9CC \uB4E4\uC5C8\uB358 \uB9D0\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC7A0\uB4E4\uAE30 \uC804\uC5D0\uB3C4, \uBC25\uC744 \uBA39\uAE30 \uC804\uC5D0\uB3C4,
      \uB204\uAD70\uAC00 B\uC758 \uBA38\uB9AC\uB97C \uC4F0\uB2E4\uB4EC\uC744 \uB54C\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC790\uC2E0\uC774 \uC624\uB798 \uAE30\uB2E4\uB9B0 \uB05D\uC5D0
      \uBC1B\uC740 \uC544\uC774\uC774\uBA70, \uBAA8\uB450\uC758 \uAE30\uB3C4 \uB05D\uC5D0
      \uC774\uACF3\uC5D0 \uC628 \uC544\uC774\uB77C\uACE0 \uB4E4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uC11C \uC0AC\uB791\uBC1B\uB294 \uAC83\uACFC \uAC10\uC0AC\uD574\uC57C
      \uD558\uB294 \uAC83\uC740 \uC5B4\uB9B0 B\uC5D0\uAC8C \uCC98\uC74C\uBD80\uD130
      \uAC19\uC740 \uB9D0\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uADF8\uB54C\uC758 B\uB294, \uADF8\uAC8C \uC774\uC0C1\uD558\uB2E4\uACE0
      \uC0DD\uAC01\uD574 \uBCF8 \uC801\uC774 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
