  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_A_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC791\uC740 \uC6D0\uB8F8. \uCC3D\uBC16\uC73C\uB85C \uCC28 \uC18C\uB9AC\uAC00
      \uB4E4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC45\uC0C1 \uC704\uC5D0\uB294 \uACE0\uC9C0\uC11C\uAC00 \uADF8\uB300\uB85C
      \uC313\uC5EC \uC788\uC5C8\uB2E4. \uC9D1\uC5D0\uC11C \uC628 \uBD80\uC7AC\uC911
      \uC804\uD654\uB3C4 \uADF8\uB300\uB85C\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC29 \uAD6C\uC11D\uC5D0 \uC911\uACE0\uB85C \uC0B0 \uB0A1\uC740 \uC804\uC790
      \uD53C\uC544\uB178\uAC00 \uD558\uB098 \uC788\uC5C8\uB2E4. \uAC74\uBC18 \uBA87
      \uAC1C\uB294 \uC18C\uB9AC\uAC00 \uACE0\uB974\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC624\uB798 \uADF8 \uC55E\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uC544\uBB34\uB3C4 \uB4E3\uC9C0 \uC54A\uB294 \uBC29\uC5D0\uC11C,
      \uAC74\uBC18 \uD558\uB098\uB97C \uB20C\uB800\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD2C0\uB9B0 \uC74C\uC774\uC5C8\uB2E4. A\uB294 \uB2E4\uC2DC \uB20C\uB800\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC774\uAC8C \uC544\uB2CC\uB370."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC870\uAE08 \uC6C3\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uD55C \uBC88
      \uB354 \uCCE4\uB2E4. \uC810\uC218\uB97C \uB9E4\uAE38 \uC0AC\uB78C\uC740 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
