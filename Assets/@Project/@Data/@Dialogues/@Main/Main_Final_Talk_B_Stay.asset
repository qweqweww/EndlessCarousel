  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_B_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uB294 \uC624\uB77D\uC2E4\uB85C \uAC00\uB294 \uAE38\uBAA9\uC5D0 \uC11C
      \uC788\uC5C8\uB2E4. \uBD88\uBE5B\uC774 \uAE5C\uBE61\uC774\uB294 \uCABD\uC744
      \uC624\uB798 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "X \uC528. \uC800\uB294\u2026 \uC5EC\uAE30 \uC788\uC744\uAC8C\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uCC98\uC74C\uC73C\uB85C \uC800\uB97C \uADF8\uB0E5 \uBC1B\uC544 \uC900
      \uACF3\uC774\uC5D0\uC694. \uB2E4\uB4E4 \uACC4\uC18D \uAC19\uC774 \uC788\uC5B4
      \uC8FC\uC168\uACE0\uC694."
    portrait: {fileID: 21300000, guid: a6c52585ce5407947bdd62f5f1dd0d5c, type: 3}
    choices: []
  - speakerName: B
    text: "\uBC16\uC5D0 \uB098\uAC00\uBA74, \uB610 \uB204\uAC00 \uC800 \uB300\uC2E0
      \uC815\uD560 \uAC83 \uAC19\uC544\uC694. \uADF8\uB9AC\uACE0 \uC81C\uAC00 \uADF8\uAC78
      \uB530\uB97C \uAC83 \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uC9C1\uC740 \uC81C\uAC00 \uBB58 \uACE0\uB97C \uC218 \uC788\uC744\uC9C0
      \uBAA8\uB974\uACA0\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\uCC9C\uCC9C\uD788 \uD574\uB3C4 \uB41C\uB2E4\uACE0 \uD558\uC168\uC796\uC544\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB798\uC11C \uC870\uAE08\uB9CC \uB354, \uCC9C\uCC9C\uD788 \uD560\uB798\uC694.
      \uC5EC\uAE30\uC11C\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC8C4\uC1A1\uD574\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: X
    text: "\uC0AC\uACFC\uD560 \uC77C \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uB124. \uADF8\uB7FC, \uC548 \uD560\uAC8C\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
