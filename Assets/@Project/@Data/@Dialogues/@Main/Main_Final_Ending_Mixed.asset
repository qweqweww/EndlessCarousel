  lines:
  - speakerName: 
    text: "\uC815\uBB38\uC740 \uB2E4\uC2DC \uB2EB\uD614\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB38\uBC16\uC758 \uC0AC\uB78C\uB4E4\uC740 \uBB38\uBC16\uC758 \uB0A0\uB4E4\uC744
      \uC0B4\uC558\uB2E4. \uBB38 \uC548\uC758 \uC0AC\uB78C\uB4E4\uC740 \uBB38 \uC548\uC758
      \uB0A0\uB4E4\uC744 \uC0B4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B4\uB290 \uCABD\uC774 \uC815\uB2F5\uC778\uC9C0\uB294 \uC544\uBB34\uB3C4
      \uC815\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD68C\uC804\uBAA9\uB9C8\uB294 \uC624\uB298\uB3C4 \uB3CC\uC558\uB2E4.
      \uADF8\uB9AC\uACE0 \uBB38\uBC16 \uC5B4\uB518\uAC00\uC5D0\uC11C\uB294, \uB204\uAD70\uAC00\uC758
      \uB0B4\uC77C\uC774 \uC2DC\uC791\uB418\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC01\uC790, \uC790\uAE30 \uC0B6\uC744 \uACE8\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2014 \uB05D \u2014"
    portrait: {fileID: 0}
    choices: []
