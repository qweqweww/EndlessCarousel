MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_D_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "D\uB294 \uB808\uC2A4\uD1A0\uB791 \uCABD \uACE8\uBAA9 \uC785\uAD6C\uC5D0
      \uC11C \uC788\uC5C8\uB2E4. \uBD88 \uCF1C\uC9C4 \uCC3D\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC548 \uB098\uAC00."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB58 \uBD10. \uC54C\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE30 \uC5B8\uB2C8 \uC788\uC5B4. \uBC25 \uD574 \uC8FC\uACE0, \uC794\uC18C\uB9AC\uD558\uACE0,
      \uBA38\uB9AC \uBB36\uC5B4 \uC918."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uB098\uAC00\uBA74 \uB610 \uC5C6\uC5B4. \uC774\uBC88\uC5D4 \uB0B4\uAC00
      \uB450\uACE0 \uB098\uAC00\uB294 \uAC70\uACE0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8\uB97C \uB450 \uBC88 \uBCF4\uB0B4\uB294 \uAC74, \uC544\uC9C1
      \uBABB \uD558\uACA0\uC5B4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB108\uB124\uAC00 \uC2EB\uC5B4\uC11C\uAC00 \uC544\uB2C8\uC57C. \uADF8\uAC74
      \uC54C\uC544 \uB46C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uAC19\uC774 \uAC00\uC790\uACE0 \uD558\uC9C0 \uB9C8. \uADF8\uB7EC\uBA74
      \uB098 \uC9C4\uC9DC \uD754\uB4E4\uB824."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\uC548 \uD560\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC74 \uACE0\uB9D9\uB2E4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
