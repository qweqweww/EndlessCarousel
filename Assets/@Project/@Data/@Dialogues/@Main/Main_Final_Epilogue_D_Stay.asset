    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624\uB298 \uBB50 \uBA39\uC744\uB798?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uAE40\uBCF6. \uACC4\uB780 \uB450 \uAC1C."
