--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_FifthTrace
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC785\uC7A5 \uC7A5\uBD80\uC758 \uB9C8\uC9C0\uB9C9 \uC7A5. \uB124 \uC904\uC758
      \uAE30\uB85D\uC774 \uB05D\uB09C \uB4A4, \uBA87 \uC7A5\uC744 \uBE44\uC6B0\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB9E8 \uB05D \uC7A5\uC5D0 \uD55C \uC904\uC774 \uB354 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE00\uC528\uB77C\uAE30\uBCF4\uB2E4 \uBC88\uC9C4 \uC790\uAD6D \uAC19\uC558\uB2E4.
      \uADF8\uB798\uB3C4 \uC77D\uC744 \uC218\uB294 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB2E4\uC12F \uBC88\uC9F8 \u2014 \uC785\uC7A5 \uAE30\uB85D \uC5C6\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB124 \uC0AC\uB78C\uC758 \uBC14\uB78C\uC774 \uD55C\uACF3\uC5D0\uC11C
      \uACB9\uCE5C \uB4A4, \uC911\uC559 \uAD11\uC7A5\uC5D0\uC11C \uCC98\uC74C \uD655\uC778\uB428.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC9C0\uB2C8\uACE0 \uC628 \uAC83: \uC5C6\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uBC14\uAE65\uC5D0 \uB0A8\uC740 \uAC83: \uC5C6\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB204\uAD6C\uC758 \uAC83\uB3C4 \uC544\uB2D8.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC774\uAC70."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uB2E4\uC12F \uBC88\uC9F8\uC608\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uC785\uC7A5 \uAE30\uB85D \uC5C6\uC74C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "\uBAA8\uB450\uAC00 X\uB97C \uBCF4\uC558\uB2E4. X\uB294 \uC7A5\uBD80\uB97C
      \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC911\uC559 \uAD11\uC7A5."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uB098 \uAC70\uAE30\uC11C \uAE7C\uC5B4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
