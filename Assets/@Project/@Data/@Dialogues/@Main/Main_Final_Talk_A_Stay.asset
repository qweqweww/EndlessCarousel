MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_A_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "A\uB294 \uACF5\uC5F0\uC7A5 \uCABD \uAE38\uC744 \uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC815\uD588\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC751. \uC5EC\uAE30 \uC788\uC744\uB798."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uBC16\uC5D0 \uB098\uAC00\uBA74 \uB2E4\uC2DC \uC810\uC218\uAC00 \uC0DD\uACA8.
      \uC21C\uC704\uB3C4, \uAE30\uB300\uB3C4."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: A
    text: "\uC544\uC9C1\uC740\u2026 \uADF8\uAC78 \uB2E4\uC2DC \uACAC\uB51C \uC790\uC2E0\uC774
      \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: A
    text: "\uC5EC\uAE30\uC120 \uD2C0\uB824\uB3C4 \uC544\uBB34\uB3C4 \uC548 \uC801\uC5B4.
      \uADF8\uAC8C \uC774\uB807\uAC8C \uD3B8\uD55C \uC904 \uBAB0\uB790\uC5B4."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uB3C4\uB9DD\uCE58\uB294 \uAC70\uB77C\uACE0 \uC0DD\uAC01\uD574\uB3C4 \uB3FC."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB807\uAC8C \uC0DD\uAC01 \uC548 \uD574."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB798."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uAD73\uC774 \uC548 \uCCD0\uB3C4 \uB41C\uB2E4\uACE0 \uD588\uC796\uC544.
      \uB124\uAC00."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB798\uC11C \uBC16\uC5D0\uC11C\uB294 \uC548 \uCE60\uB798. \uC5EC\uAE30\uC11C
      \uCE58\uACE0 \uC2F6\uC744 \uB54C\uB9CC \uCE60 \uAC70\uC57C."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uAC8C \uC9C0\uAE08 \uB0B4\uAC00 \uD560 \uC218 \uC788\uB294 \uB9CC\uD07C\uC774\uC57C."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
