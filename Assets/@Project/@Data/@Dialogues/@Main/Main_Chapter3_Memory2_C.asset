%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Memory2_C
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uADF8\uB0A0\uC758 \uC77C\uC740, \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE30\uC5B5\uC740 \uBCD1\uC6D0 \uCC9C\uC7A5\uC5D0\uC11C\uBD80\uD130 \uC2DC\uC791\uB410\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD558\uC580 \uD615\uAD11\uB4F1. \uC18C\uB3C5\uC57D \uB0C4\uC0C8. \uB204\uAD70\uAC00
      \uC6B0\uB294 \uC18C\uB9AC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uBA38\uB2C8"
    text: "C\uC57C. \uC5C4\uB9C8 \uBCF4\uC5EC?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uBA38\uB2C8"
    text: "\uB2E4\uD589\uC774\uB2E4. \uB2E4\uD589\uC774\uB2E4\u2026."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB9AC\uC758 \uAC10\uAC01\uC774 \uC774\uC0C1\uD588\uB2E4. \uC788\uB294\uB370,
      \uBA40\uC5C8\uB2E4. \uB0B4 \uAC83\uC778\uB370 \uB0A8\uC758 \uAC83 \uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uCC99\uC218\uAC00 \uB2E4\uCCE4\uC2B5\uB2C8\uB2E4. \uD5C8\uB9AC \uC870\uAE08
      \uC704\uCABD\uC774\uC5D0\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uB2E4\uD589\uD788 \uC644\uC804\uD788 \uC190\uC0C1\uB41C \uAC74 \uC544\uB2D9\uB2C8\uB2E4.
      \uC7AC\uD65C\uC744 \uAFB8\uC900\uD788 \uD558\uBA74 \uB2E4\uC2DC \uAC78\uC744
      \uC218 \uC788\uC744 \uAC70\uC608\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC2DC \uAC78\uC744 \uC218 \uC788\uB2E4. \uC5C4\uB9C8\uAC00 \uADF8
      \uB9D0\uC5D0 \uB610 \uC6B8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBA87 \uC8FC \uB4A4, \uC7AC\uD65C\uC2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD3C9\uD589\uBD09 \uB450 \uAC1C \uC0AC\uC774\uC5D0 C\uAC00 \uC11C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uCE58\uB8CC\uC0AC"
    text: "\uC190\uC5D0 \uD798 \uC8FC\uACE0. \uBB34\uAC8C \uC55E\uC73C\uB85C. \uCC9C\uCC9C\uD788."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C \uAC78\uC74C. \uBB34\uB98E\uC774 \uB5A8\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB450 \uAC78\uC74C. \uBC1C\uB05D\uC774 \uBC14\uB2E5\uC5D0 \uAC78\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC138 \uAC78\uC74C\uC9F8\uC5D0, C\uB294 \uD3C9\uD589\uBD09 \uB05D\uAE4C\uC9C0
      \uC640 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uCE58\uB8CC\uC0AC"
    text: "\uB410\uB2E4! \uBC29\uAE08 \uB05D\uAE4C\uC9C0 \uC654\uC5B4\uC694, \uB05D\uAE4C\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uD588\uC5B4\uC694. \uD588\uC5B4\uC694!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB540\uC774 \uD131 \uB05D\uC5D0\uC11C \uB5A8\uC5B4\uC84C\uB2E4. \uACE0\uC791
      2\uBBF8\uD130\uC600\uB2E4. \uADF8\uB798\uB3C4 C\uB294 \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2EC\uC774 \uBC14\uB00C\uACE0, \uD3C9\uD589\uBD09\uC774 \uC9C0\uD321\uC774\uAC00
      \uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBCF5\uB3C4 \uB05D\uAE4C\uC9C0 \uAC78\uC5C8\uB2E4. \uACC4\uB2E8 \uC138
      \uCE78\uC744 \uC62C\uB790\uB2E4. \uD654\uC7A5\uC2E4\uC5D0 \uD63C\uC790 \uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBAA8\uB450\uAC00 \uB2E4\uD589\uC774\uB77C\uACE0 \uD588\uB2E4. C\uB3C4
      \uADF8\uB807\uAC8C \uC0DD\uAC01\uD588\uB2E4. \uC815\uB9D0\uB85C \uB2E4\uD589\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4, \uC5B4\uB290 \uB0A0 C\uB294 \uBB3C\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC120\uC0DD\uB2D8. \uB2EC\uB9AC\uB294 \uAC74\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uC194\uC9C1\uD558\uAC8C \uB9D0\uD560\uAC8C\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uAC77\uB294 \uAC74 \uACC4\uC18D \uC88B\uC544\uC9C8 \uC218 \uC788\uC5B4\uC694.
      \uC9E7\uC740 \uAC70\uB9AC\uB294 \uC9C0\uD321\uC774 \uC5C6\uC774\uB3C4 \uAC78\uC744
      \uC218 \uC788\uC744 \uAC70\uACE0\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uD558\uC9C0\uB9CC \uB2E4\uB9AC \uADFC\uC721\uC774\uB791 \uAC10\uAC01\uC774
      \uC608\uC804\uCC98\uB7FC \uB3CC\uC544\uC624\uAE34 \uC5B4\uB824\uC6CC\uC694.
      \uC624\uB798 \uAC78\uC73C\uBA74 \uAE08\uBC29 \uC9C0\uCE58\uACE0, \uC9C0\uCE58\uBA74
      \uAC78\uC74C\uC774 \uD754\uB4E4\uB9B4 \uAC70\uC608\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC758\uC0AC"
    text: "\uB2EC\uB9AC\uAE30\uB294\u2026 \uB118\uC5B4\uC9C8 \uC704\uD5D8\uC774 \uB108\uBB34
      \uCEE4\uC694. \uB2E4\uC2DC \uD558\uAE34 \uC5B4\uB835\uB2E4\uACE0 \uC0DD\uAC01\uD558\uB294
      \uAC8C \uB9DE\uC544\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB807\uAD6C\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB124. \uC54C\uACA0\uC5B4\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4. \uC6B8\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB0A0 \uBC24, \uBCD1\uC2E4 \uCC3D\uBC16\uC73C\uB85C \uD559\uAD50
      \uC6B4\uB3D9\uC7A5\uC758 \uC870\uBA85\uC774 \uBCF4\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD2B8\uB799 \uC704\uC5D0\uC11C \uB204\uAD70\uAC00 \uB6F0\uACE0 \uC788\uC5C8\uB2E4.
      \uB108\uBB34 \uBA40\uC5B4\uC11C, \uB204\uAD70\uC9C0\uB294 \uBCF4\uC774\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC78\uC744 \uC218 \uC788\uC5B4\uC11C \uB2E4\uD589\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uB2E4\uC2DC\uB294 \uB6F8 \uC218 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB450 \uAC00\uC9C0\uAC00, \uAC19\uC740 \uB0A0 C \uC548\uC5D0 \uB4E4\uC5B4
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
