  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_AfterMemory2
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "A\uB294 \uC21C\uC704\uD45C \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u20262\uB4F1."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "2\uB4F1 \uD588\uC5C8\uC5B4. \uD070 \uB300\uD68C\uC5D0\uC11C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "2\uB4F1\uC774\uBA74 \uC798\uD55C \uAC70\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "1\uB4F1 \uD574\uC57C \uD588\uC5B4."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC65C?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB798\uC57C \uD588\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uADF8 \uC774\uC0C1 \uC124\uBA85\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBB50, \uB2E4\uC2DC \uD558\uBA74\u2014"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uB9D0\uC744 \uBA48\uCDC4\uB2E4. \uBB34\uC5B8\uAC00 \uB5A0\uC624\uB978
      \uB4EF\uD55C \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uB410\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB50\uC57C, \uB9D0\uD558\uB2E4 \uB9D0\uACE0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB0D0. \uB0B4\uAC00 \uD560 \uB9D0\uC774 \uC544\uB2CC \uAC83 \uAC19\uC544\uC11C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "\uC7A0\uAE50 \uC5B4\uC0C9\uD55C \uCE68\uBB35\uC774 \uD758\uB800\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uB2E4\uC2DC \uAC19\uC740 \uAC74 \uC5C6\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices:
    - text: "2\uB4F1\uB3C4 \uC798\uD55C \uAC70\uC57C."
      next: {fileID: 11400000, guid: d7787a440f293564c8b098e894efb709, type: 2}
      choiceId: Chapter1_A_Memory2_Response_StillGood
      recordAsFlag: 1
    - text: "\u2026\u2026\uADF8\uB7AC\uAD6C\uB098."
      next: {fileID: 11400000, guid: a829a3344b715064f8beada6f06696d2, type: 2}
      choiceId: Chapter1_A_Memory2_Response_Listened
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
