%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_B_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uB294 \uC624\uB77D\uC2E4\uB85C \uAC00\uB294 \uAE38\uBAA9\uC5D0 \uC11C
      \uC788\uC5C8\uB2E4. \uC8FC\uBA38\uB2C8 \uC18D \uBB34\uC5B8\uAC00\uB97C \uBA87
      \uBC88\uC774\uACE0 \uB9CC\uC9C0\uC791\uAC70\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "X \uC528."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\u2026 \uB098\uAC00 \uBCF4\uB824\uACE0\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uBB34\uC11C\uC6CC\uC694. \uC9C4\uC9DC\uB85C."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\uB098\uAC00\uBA74 \uBD80\uBAA8\uB2D8\uB3C4 \uC788\uACE0, \uBAA8\uC784
      \uC0AC\uB78C\uB4E4\uB3C4 \uC788\uACE0. \uC800\uB294 \uB3C8\uB3C4 \uC5C6\uACE0,
      \uD734\uB300\uD3F0\uB3C4 \uC5C6\uACE0, \uC544\uB294 \uC0AC\uB78C\uB3C4 \uC5C6\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\uB2E4\uC2DC \uB3CC\uC544\uC624\uB77C\uACE0 \uD558\uC2DC\uACA0\uC8E0.
      \uCC29\uD558\uAC8C \uC9C0\uB0B4\uB77C\uACE0."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uADF8\uB798\uB3C4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uBC16\uC5D0\uC11C, \uC81C\uAC00 \uC120\uD0DD\uD574 \uBCF4\uACE0 \uC2F6\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uB204\uAD6C\uB791 \uCE5C\uD574\uC9C8\uC9C0, \uBB58 \uBA39\uC744\uC9C0,
      \uC5B4\uB514\uC11C \uC0B4\uC9C0. \uC791\uC740 \uAC70\uBD80\uD130\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5EC\uAE30\uC11C \uCC98\uC74C\uC73C\uB85C \uACE8\uB77C \uBD24\uAC70\uB4E0\uC694.
      \uD1A0\uB07C \uC778\uD615\uB3C4, \uAC19\uC774 \uC788\uC744 \uC0AC\uB78C\uB3C4."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: B
    text: "X \uC528\uAC00 \uADF8\uB7AC\uC796\uC544\uC694. \uB2E4\uB978 \uC0AC\uB78C
      \uC77C\uAE4C\uC9C0 \uC81C\uAC00 \uD63C\uC790 \uC815\uD560 \uC77C\uC774 \uC544\uB2C8\uB77C\uACE0\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC \uC81C \uC77C\uC740\u2026 \uC81C\uAC00 \uC815\uD574 \uBD10\uC57C\uC8E0."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uB3CC\uC544\uAC00\uB294 \uAC8C \uC544\uB2C8\uC5D0\uC694. \uAC70\uAE30\uC11C
      \uB098\uC624\uB824\uACE0 \uAC00\uB294 \uAC70\uC608\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
