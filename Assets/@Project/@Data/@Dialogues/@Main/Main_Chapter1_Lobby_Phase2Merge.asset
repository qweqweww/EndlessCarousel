    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE30 \uC0AC\uB78C \uC5C6\uB2E4\uBA70. \uB204\uAC00 \uAC70\uB294
      \uAC74\uB370."
