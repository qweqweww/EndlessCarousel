    choices: []
  - speakerName: 
    text: "\uB0A1\uC740 \uACF5\uC911\uC804\uD654\uAC00 \uACC4\uC18D \uC6B8\uB9AC\uACE0
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
