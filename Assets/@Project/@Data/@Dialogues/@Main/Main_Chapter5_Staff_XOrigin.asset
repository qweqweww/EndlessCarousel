%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_XOrigin
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "X\uB294 \uB5A0\uC62C\uB824 \uBCF4\uC558\uB2E4. \uC774\uBC88\uC5D0\uB294
      \uB2E4\uB978 \uBC29\uBC95\uC73C\uB85C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB34\uC5B8\uAC00\uAC00 \uB3CC\uC544\uC624\uAE30\uB97C \uAE30\uB2E4\uB9AC\uB294
      \uB300\uC2E0, \uAC00\uC7A5 \uC624\uB798\uB41C \uAC83\uBD80\uD130 \uAC70\uAFB8\uB85C
      \uC9DA\uC5B4 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uC640 \uBA39\uC740 \uC800\uB141. C\uC640 \uAC78\uC740 \uAC70\uB9AC.
      B\uC640 \uD55C \uC778\uD615\uBF51\uAE30. A\uC758 \uD53C\uC544\uB178."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC804\uC5D0\uB294, \uAD11\uC7A5\uC5D0\uC11C \uB2E4 \uAC19\uC774
      \uB458\uB7EC\uBCF4\uC790\uACE0 \uC815\uD55C \uAC83."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC804\uC5D0\uB294, \uC774\uB984\uC744 \uB9D0\uD55C \uAC83. 'X.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC804\uC5D0\uB294."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD76C\uBBF8\uD55C \uC74C\uC545 \uC18C\uB9AC. \uB208\uC744 \uB728\uC790
      \uBCF4\uC774\uB358 \uB0AF\uC120 \uD48D\uACBD."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uC704\uC5D0\uC11C \uB0B4\uB824\uB2E4\uBCF4\uB358 \uB124
      \uAC1C\uC758 \uC5BC\uAD74. '\uC5B4. \uAE7C\uB124.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC804\uC740 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD750\uB9BF\uD55C \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uB2E4. \uC78A\uC5B4\uBC84\uB824\uC11C
      \uBE44\uC5B4 \uC788\uB294 \uAC83\uB3C4 \uC544\uB2C8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB0E5, \uAC70\uAE30\uC11C \uC2DC\uC791\uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uAE7C\uC744 \uB54C, \uB108\uD76C\uAC00 \uBA3C\uC800 \uC77C\uC5B4\uB098
      \uC788\uC5C8\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4? \uC751. \uC6B0\uB9AC\uB3C4 \uBC29\uAE08 \uAE7C\uB2E4\uACE0 \uD588\uC796\uC544."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uB108\uD76C\uB294 \uBC14\uAE65\uC5D0\uC11C \uB4E4\uC5B4\uC654\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB098\uB294 \uB108\uD76C\uAC00 \uB4E4\uC5B4\uC628 \uB2E4\uC74C\uC5D0,
      \uC5EC\uAE30\uC11C\u2026 \uC0DD\uACBC\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC0DD\uACBC\uB2E4\uB2C8. \uB9D0\uC744 \uBB34\uC2A8."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC7A5\uBD80\uC5D0 \uADF8\uB807\uAC8C \uC368 \uC788\uC796\uC544."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124 \uC0AC\uB78C\uC758 \uBC14\uB78C\uC774 \uACB9\uCE5C \uB4A4\uC5D0\u2026."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC X\uAC00 \uC6B0\uB9AC \uB137 \uAC70 \uC11E\uC5B4\uC11C \uC0DD\uAE34
      \uAC70\uC57C? \uC6B0\uB9AC \uC77C\uBD80?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uC6B0\uB9AC \uB2EE\uC558\uC5B4?"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC544\uB2C8. \uD558\uB098\uB3C4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "A\uCC98\uB7FC \uB9D0 \uC9E7\uC9C0\uB3C4 \uC54A\uACE0, \uB098\uCC98\uB7FC
      \uC131\uC9C8\uB3C4 \uC548 \uB354\uB7FD\uACE0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098\uCC98\uB7FC \uC2DC\uB044\uB7FD\uC9C0\uB3C4 \uC54A\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\uCC98\uB7FC\u2026 \uC0AC\uACFC\uB3C4 \uC548 \uD558\uC138\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: 
    text: "\uC7A0\uAE50 \uC6C3\uC74C \uAC19\uC740 \uC228\uC18C\uB9AC\uAC00 \uB0AC\uB2E4.
      \uD558\uC9C0\uB9CC \uAE08\uBC29 \uC870\uC6A9\uD574\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uAE30\uC5B5\uC744 \uC783\uC740 \uC904 \uC54C\uC558\uC5B4. \uB2E4\uB4E4
      \uADF8\uB7AC\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uADFC\uB370 \uC544\uB2C8\uC5C8\uC5B4. \uC783\uC5B4\uBC84\uB9B4 \uAC8C
      \uCC98\uC74C\uBD80\uD130 \uC5C6\uC5C8\uB358 \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB0B4\uAC00 \uAE30\uC5B5\uD560 \uC218 \uC788\uB294 \uC81C\uC77C \uC624\uB798\uB41C
      \uAC74, \uC5EC\uAE30\uC11C \uB208 \uB72C \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uBC14\uB85C \uB9D0\uD558\uC9C0 \uBABB\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices:
    - text: "\uADF8\uB7FC \uB098\uB294 \uAC00\uC9DC\uC778 \uAC78\uAE4C."
      next: {fileID: 11400000, guid: e87199d51d1cdfe4097fc67b400f3a07, type: 2}
      choiceId: Chapter5_X_Response_Fake
      recordAsFlag: 1
    - text: "\uADF8\uB798\uB3C4 \uC5EC\uAE30\uC11C \uC788\uC5C8\uB358 \uC77C\uC740
        \uAE30\uC5B5\uB098."
      next: {fileID: 11400000, guid: 051a6982266f6454db4dba76f61e8e25, type: 2}
      choiceId: Chapter5_X_Response_Experience
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
