%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Plaza_TicketRecord
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB9E4\uD45C\uC18C \uCC3D\uAD6C \uC544\uB798, \uC785\uC7A5\uAD8C \uBB36\uC74C\uACFC
      \uD568\uAED8 \uC587\uC740 \uC7A5\uBD80\uAC00 \uB07C\uC6CC\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD45C\uC9C0\uC5D0\uB294 '\uC785\uC7A5 \uD655\uC778'\uC774\uB77C\uACE0\uB9CC
      \uC801\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC624, \uC774\uB7F0 \uAC8C \uC788\uC5C8\uB124. \uCC98\uC74C\uC5D4 \uBABB
      \uBD24\uB294\uB370."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uB118\uACA8 \uBD10."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "\uC7A5\uBD80\uB97C \uD3BC\uCCE4\uB2E4. \uCE78\uB9C8\uB2E4 \uCC22\uC5B4
      \uB0B8 \uC785\uC7A5\uAD8C \uBC18\uCABD\uC774 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCCAB \uBC88\uC9F8 \uBC18\uCABD \uC704\uC5D0\uB294 \uD53C\uC544\uB178
      \uAC74\uBC18 \uBAA8\uC591 \uB3C4\uC7A5. \uB450 \uBC88\uC9F8\uC5D0\uB294 \uC791\uC740
      \uC2ED\uC790\uAC00 \uBAA8\uC591."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC138 \uBC88\uC9F8\uC5D0\uB294 \uC6B4\uB3D9\uD654 \uB048 \uC790\uAD6D.
      \uB124 \uBC88\uC9F8\uC5D0\uB294 \uB3D9\uADF8\uB780 \uACC4\uB780 \uD504\uB77C\uC774
      \uAC19\uC740 \uC5BC\uB8E9."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC774\uAC70 \uC6B0\uB9AC \uAC70 \uC544\uB0D0?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uAC74\uBC18, \uC2ED\uC790\uAC00, \uC6B4\uB3D9\uD654. \uADF8\uB9AC\uACE0
      \uC774\uAC74\u2026."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uACC4\uB780\uC774\uB124. \uC6C3\uAE30\uACE0 \uC788\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uD558\uB098\uC529\u2026 \uC800\uD76C\uB791 \uB2EE\uC558\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7FC X \uAC83\uB3C4 \uC788\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC12F \uBC88\uC9F8 \uCE78\uC740 \uBE44\uC5B4 \uC788\uC5C8\uB2E4.
      \uBC18\uCABD\uC9DC\uB9AC \uC785\uC7A5\uAD8C\uB3C4, \uB3C4\uC7A5\uB3C4, \uC5BC\uB8E9\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCE78\uC774 \uC788\uC5C8\uB358 \uD754\uC801\uC870\uCC28 \uC5C6\uC774,
      \uC7A5\uBD80\uB294 \uAC70\uAE30\uC11C \uB05D\uB0AC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC5C6\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uBE7C\uBA39\uC5C8\uB098 \uBCF4\uC9C0. \uB9E4\uD45C\uC18C \uC9C1\uC6D0\uC774
      \uC77C\uC744 \uB300\uCDA9 \uD588\uB4E0\uAC00."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC9C1\uC6D0\uC740\u2026 \uD55C \uBC88\uB3C4 \uBABB \uBD24\uC9C0\uB9CC\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uB300\uCDA9 \uD588\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC,
      \uBE48\uCE78\uC744 \uC624\uB798 \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB34\uC5B8\uAC00 \uB5A0\uC624\uB974\uAE30\uB97C \uAE30\uB2E4\uB838\uB2E4.
      \uC190\uC5D0 \uC954 \uD45C\uC758 \uAC10\uCD09\uC774\uB77C\uB4E0\uAC00, \uC904\uC744
      \uC11C\uB358 \uAE30\uC5B5\uC774\uB77C\uB4E0\uAC00."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uAC83\uB3C4 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uB098\uB3C4 \uD45C\uB97C \uC0C0\uB358 \uAC83 \uAC19\uC740
      \uAE30\uBD84\uC740 \uC548 \uB4E4\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC \uD45C \uC5C6\uC774 \uB4E4\uC5B4\uC654\uB098? \uBB34\uC784\uC2B9\uCC28?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uAC74 \uB108\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC65C \uB098\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uB2E4\uB978 \uB370\uB3C4 \uBCF4\uC790."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
