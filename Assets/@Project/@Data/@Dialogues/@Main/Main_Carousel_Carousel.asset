  m_Name: Main_Carousel_Carousel
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uD68C\uC804\uBAA9\uB9C8\uB294 \uC77C\uC815\uD55C \uC18D\uB3C4\uB85C \uCC9C\uCC9C\uD788
      \uB3CC\uACE0 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB9D0\uACFC \uC7A5\uC2DD\uC740 \uAE68\uB057\uD558\uACE0, \uC870\uBA85\uB3C4
      \uBAA8\uB450 \uC815\uC0C1\uC801\uC73C\uB85C \uB4E4\uC5B4\uC640 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uBA48\uCD9C \uC0DD\uAC01\uC740 \uC5C6\uC5B4 \uBCF4\uC774\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB204\uAC00 \uCF1C\uB193\uACE0 \uAC04 \uAC74\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5B4... \uADF8\uB798\uB3C4 \uAD00\uB9AC\uD558\uB294 \uC0AC\uB78C\uC774
      \uC788\uC9C0 \uC54A\uC744\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\uC788\uC73C\uBA74 \uB098\uC654\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: D
    text: "\uAF2D \uADF8\uB807\uC9C4 \uC54A\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC77C\uB2E8 \uB354 \uCC3E\uC544\uBCF4\uC790."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
