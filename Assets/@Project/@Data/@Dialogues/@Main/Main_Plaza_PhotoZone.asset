  m_Name: Main_Plaza_PhotoZone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uD654\uB824\uD558\uAC8C \uAFB8\uBA70\uC9C4 \uD3EC\uD1A0\uC874\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC6C3\uACE0 \uC788\uB294 \uB9C8\uC2A4\uCF54\uD2B8 \uC606\uC5D0 \uC791\uC740
      \uBB38\uAD6C\uAC00 \uC801\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC00\uC7A5 \uD589\uBCF5\uD55C \uC21C\uAC04\uC744 \uB0A8\uACA8\uBCF4\uC138\uC694!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC0AC\uC9C4 \uCC0D\uC5B4\uC904 \uC0AC\uB78C\uB3C4 \uC5C6\uB294\uB370."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6B0\uB9AC\uB07C\uB9AC \uCC0D\uC73C\uBA74 \uB418\uC9C0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uB410\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uC9C1 \uCC0D\uC790\uB294 \uB9D0\uB3C4 \uC548 \uD588\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uD560 \uAC83 \uAC19\uC544\uC11C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
