  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_Lockers
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBCF5\uB3C4 \uBCBD\uC5D0 \uC0AC\uBB3C\uD568 \uB2E4\uC12F \uCE78\uC774
      \uB098\uB780\uD788 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB124 \uCE78\uC740 \uBB38\uC774 \uC0B4\uC9DD \uC5F4\uB824 \uC788\uB2E4.
      \uC548\uC5D0\uB294 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC9C0\uB9CC, \uB204\uAD70\uAC00
      \uC4F4 \uD754\uC801\uC774 \uC788\uB2E4. \uC637\uAC78\uC774\uAC00 \uBE44\uB6A4\uC5B4\uC838
      \uC788\uAC70\uB098, \uBC14\uB2E5\uC5D0 \uBA3C\uC9C0\uAC00 \uC4F8\uB824 \uC788\uAC70\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC12F \uBC88\uC9F8 \uCE78\uC740 \uB2E8\uB2E8\uD788 \uB2EB\uD600
      \uC788\uB2E4. \uC774\uB984\uD45C \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB2E4\uC12F \uCE78\uC774\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5F4\uC5B4 \uBD10."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "X\uAC00 \uC190\uC7A1\uC774\uB97C \uB2F9\uACBC\uB2E4. \uBB38\uC740 \uC27D\uAC8C
      \uC5F4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC548\uC740 \uAE68\uB057\uD588\uB2E4. \uC4F4 \uD754\uC801\uB3C4, \uBA3C\uC9C0\uB3C4
      \uC5C6\uC5C8\uB2E4. \uBC29\uAE08 \uB9CC\uB4E4\uC5B4\uC9C4 \uAC83\uCC98\uB7FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uC0C8\uAC83 \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "X \uCE78\uC778\uAC00 \uBCF4\uB2E4. \uC790\uB9AC\uB294 \uC788\uC5C8\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC790\uB9AC\uB9CC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC790\uB9AC \uC788\uC73C\uBA74 \uB410\uC9C0. \uBB58 \uB354 \uBC14\uB77C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
