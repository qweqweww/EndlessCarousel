--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_C_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "C\uB294 \uD37C\uB808\uC774\uB4DC \uAC70\uB9AC\uB85C \uC774\uC5B4\uC9C0\uB294
      \uAE38 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uBC1C\uB05D\uC73C\uB85C \uBC14\uB2E5\uC744
      \uD1A1\uD1A1 \uCC3C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB098\uB294\u2026 \uC870\uAE08 \uB354 \uC788\uC744\uB798."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6C3\uAE30\uC9C0. \uCD9C\uAD6C \uCC3E\uC790\uACE0 \uC81C\uC77C \uC5F4\uC2EC\uD788
      \uB5A0\uB4E0 \uAC8C \uB098\uC600\uB294\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uC120 \uB6F8 \uC218 \uC788\uC796\uC544. \uC228\uB3C4 \uC548
      \uCC28\uACE0, \uC548 \uB118\uC5B4\uC9C0\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098\uAC00\uBA74 \uADF8\uAC8C \uB610 \uC5C6\uC5B4\uC838. \uB450 \uBC88\uC9F8\uB85C."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uC9C1 \uADF8\uAC78 \uD55C \uBC88 \uB354 \uC783\uC744 \uC790\uC2E0\uC774
      \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uC9C1 \uBB58 \uD560\uC9C0 \uC548 \uC815\uD574\uB3C4 \uB41C\uB2E4\uBA70.
      \uB124\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB798\uC11C \uC548 \uC815\uD558\uACE0, \uC870\uAE08 \uB354 \uB6F8\uB798."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC774\uAC8C \uB3C4\uB9DD\uC774\uBA74, \uBB50, \uC880 \uB3C4\uB9DD\uCE58\uC9C0."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: X
    text: "\uB3C4\uB9DD \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB807\uAC8C \uB9D0\uD574 \uC8FC\uB2C8\uAE4C \uC88B\uB124."
    portrait: {fileID: 21300000, guid: 52f78e9f4aa2a2245959f4aff1b0fcca, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
