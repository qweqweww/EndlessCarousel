%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_StaffChair
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uACC4\uC0B0\uB300 \uC548\uCABD, \uAD6C\uC11D\uC5D0 \uC791\uC740 \uC811\uC774\uC2DD
      \uC758\uC790\uAC00 \uB193\uC5EC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBCBD\uC5D0\uB294 \uADFC\uBB34\uD45C\uAC00 \uBD99\uC5B4 \uC788\uB2E4.
      \uCE78\uB9C8\uB2E4 \uC2DC\uAC04\uC774 \uC801\uD600 \uC788\uACE0, \uD55C \uCE78\uC5D0\uB9CC
      \uB3D9\uADF8\uB77C\uBBF8\uAC00 \uCCD0\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC544, \uC774 \uC758\uC790."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB0E5 \uC758\uC790\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8\uC57C. \uACC4\uC0B0\uB300 \uC548\uCABD \uC758\uC790\uB294
      \uADF8\uB0E5 \uC758\uC790\uAC00 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uAC8C \uC788\uC73C\uBA74 \uC9C4\uC9DC \uB2E4\uB974\uAC70\uB4E0.
      \uC190\uB2D8 \uC5C6\uC744 \uB54C \uC7A0\uAE50 \uC549\uC744 \uC218 \uC788\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "C \uC528, \uC774\uB7F0 \uB370\uC11C \uC77C\uD558\uC168\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uB294 \uC544\uB2C8\uACE0\u2026 \uBE44\uC2B7\uD55C \uB370."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uADFC\uBB34\uD45C\uB97C \uB4E4\uC5EC\uB2E4\uBCF4\uC558\uB2E4.
      \uC190\uAC00\uB77D\uC73C\uB85C \uCE78\uC744 \uD558\uB098\uC529 \uC9DA\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5EC\uC12F \uC2DC\uAC04\uC774\uBA74\u2026 \uB450 \uC2DC\uAC04\uB9C8\uB2E4
      \uC2ED \uBD84\uC529. \uADF8\uB7FC \uC138 \uBC88."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC190\uB2D8 \uB9CE\uC740 \uC2DC\uAC04 \uBE7C\uACE0, \uBB3C\uAC74 \uB4E4\uC5B4\uC624\uB294
      \uC2DC\uAC04 \uBE7C\uACE0\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB58 \uACC4\uC0B0\uD558\uB294\uB370."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5B8\uC81C \uC549\uC744 \uC218 \uC788\uB294\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB9D0\uD574 \uB193\uACE0 \uC6C3\uC5C8\uB2E4. D\uB294 \uC6C3\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5D0\uC774, \uADF8\uB7F0 \uC5BC\uAD74 \uD558\uC9C0 \uB9C8. \uADF8\uB0E5
      \uACC4\uC0B0\uC774\uC57C. \uACC4\uC0B0 \uC798\uD558\uBA74 \uBC84\uD2F8 \uB9CC\uD574."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uBC84\uD2F8 \uB9CC\uD588\uC5B4?"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uAE00\uC384."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uADFC\uBB34\uD45C\uC758 \uB3D9\uADF8\uB77C\uBBF8 \uCE5C \uCE78\uC744
      \uD55C\uCC38 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uC774\uC81C \uAE30\uC5B5\uB0A0 \uAC83 \uAC19\uC544."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
