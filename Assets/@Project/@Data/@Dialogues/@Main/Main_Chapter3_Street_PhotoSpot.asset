%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_PhotoSpot
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAE30\uB150\uC0AC\uC9C4\uC744 \uCC0D\uB294 \uD3EC\uD1A0 \uC2A4\uD31F.
      \uCEE4\uD2BC \uC0AC\uC774 \uBAA8\uB2C8\uD130\uC5D0 \uC624\uB298 \uCC0D\uD78C
      \uC0AC\uC9C4\uC774 \uBC88\uAC08\uC544 \uB72C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uC911 \uD55C \uC7A5\uC5D0, \uAC70\uB9AC\uB97C \uB2EC\uB9AC\uB294
      C\uAC00 \uCC0D\uD600 \uC788\uC5C8\uB2E4. \uB450 \uBC1C\uC774 \uBAA8\uB450 \uB545\uC5D0\uC11C
      \uB5A8\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC0AC\uC9C4 \uC704 \uC791\uC740 \uC804\uAD11\uD310\uC5D0 \uC22B\uC790\uAC00
      \uAE5C\uBE61\uC600\uB2E4. '\uC624\uB298\uC758 \uAE30\uB85D 11.02'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "C \uC528\uC608\uC694! \uC544\uAE4C \uB6F0\uC2E4 \uB54C \uCC0D\uD614\uB098
      \uBD10\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC640, \uB098 \uC9C4\uC9DC \uB0A0\uACE0 \uC788\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC0AC\uC9C4 \uC798 \uB098\uC654\uB124. \uC5BC\uAD74\uC740 \uC6C3\uAE30\uC9C0\uB9CC."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6C3\uAE34 \uAC8C \uC544\uB2C8\uB77C \uC9C4\uC9C0\uD55C \uAC70\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8 11.02\uB294 \uBB50\uC57C. \uBE60\uB978 \uAC70\uC57C?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uBAB0\uB77C. \uADFC\uB370\u2026"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uBE60\uB978 \uAC83 \uAC19\uC544. \uC5C4\uCCAD."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uC0C1\uD558\uB124. \uC22B\uC790 \uBCF4\uB294\uB370 \uAC00\uC2B4\uC774
      \uB9C9 \uB6F0\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\uBE60\uB978 \uAC70\uBA74 \uB410\uC796\uC544."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uADFC\uB370 \uC774\uB7F0 \uC0DD\uAC01\uC774 \uB4DC\uB294 \uAC70\uC57C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "'\uB2E4\uC74C\uC5D4 \uB354 \uC904\uC77C \uC218 \uC788\uACA0\uB2E4.'"
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC29\uAE08 \uC5C4\uCCAD \uBE60\uB974\uB2E4\uBA70."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uB2C8\uAE4C. \uC6C3\uAE30\uC9C0. \uBE60\uB974\uBA74 \uBE60\uB97C\uC218\uB85D
      \uB354 \uC904\uC774\uACE0 \uC2F6\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC6C3\uC5C8\uB2E4. \uADF8\uB7F0\uB370 \uADF8 \uC6C3\uC74C\uC740
      \uAE08\uBC29, \uC870\uAE08 \uBA3C \uACF3\uC744 \uBCF4\uB294 \uC5BC\uAD74\uB85C
      \uBC14\uB00C\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
