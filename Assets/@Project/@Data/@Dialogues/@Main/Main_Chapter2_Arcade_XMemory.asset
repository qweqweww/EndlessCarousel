--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_XMemory
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uC758 \uAE30\uC5B5\uC5D0\uB294 \uD0DC\uC5B4\uB098\uAE30 \uC804\uC758
      \uC774\uC57C\uAE30\uAE4C\uC9C0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE30\uB2E4\uB9AC\uB358 \uBD80\uBAA8\uAC00 \uC788\uC5C8\uACE0, \uAE34
      \uC2DD\uD0C1\uC774 \uC788\uC5C8\uACE0, \uACF5\uBD80\uBC29 \uB9E8 \uB4B7\uC790\uB9AC\uAC00
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB3C4 \uB5A0\uC62C\uB824 \uBCF4\uB824 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B4\uB9B0 \uC2DC\uC808. \uC9D1. \uB204\uAD70\uAC00."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC774\uBC88\uC5D0\uB294, \uBB34\uC5B8\uAC00\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB204\uAD70\uAC00\uB97C \uAE30\uB2E4\uB838\uB358 \uAC83 \uAC19\uC740
      \uB9C8\uC74C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC791\uC740 \uC190\uC744 \uC7A1\uC558\uB358 \uAC83 \uAC19\uC740, \uD639\uC740
      \uC7A1\uD614\uB358 \uAC83 \uAC19\uC740 \uAC10\uAC01."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B4\uB518\uAC00\uB85C \uB3CC\uC544\uAC00\uACE0 \uC2F6\uC5C8\uB358 \uAC83
      \uAC19\uC740 \uAE30\uBD84."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB7F0\uB370 \uB204\uAD6C\uC600\uB294\uC9C0, \uC5B4\uB514\uC600\uB294\uC9C0,
      \uC5B4\uB5A4 \uC5BC\uAD74\uC774\uC5C8\uB294\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC7A5\uBA74\uC740 \uD558\uB098\uB3C4 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC10\uC815\uB9CC \uC788\uACE0, \uADF8 \uAC10\uC815\uC744 \uB9CC\uB4E0
      \uAE30\uC5B5\uC774 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC774\uC0C1\uD558\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "X? \uBB50\uAC00?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uC950\uC5C8\uB2E4\uAC00
      \uD3C8\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uC950\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
