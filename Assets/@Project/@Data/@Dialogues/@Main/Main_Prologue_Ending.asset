  lines:
  - speakerName: D
    text: "\uC774\uCABD\uB3C4 \uB2E4 \uBCF8 \uAC70\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uB300\uCDA9."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751. \uC9C1\uC6D0\uC740 \uC5C6\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uCD9C\uAD6C\uB3C4... \uC544\uC9C1 \uBABB \uCC3E\uC558\uACE0\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB300\uC2E0 \uB2E4\uB978 \uAD6C\uC5ED\uC740 \uB354 \uC788\uB294 \uAC83
      \uAC19\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uACB0\uAD6D \uACC4\uC18D \uB3CC\uC544\uB2E4\uB140\uC57C\uACA0\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uAC8C \uC81C\uC77C \uBE60\uB974\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC \uD558\uB098\uC529 \uD655\uC778\uD574\uBCF4\uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uACC4\uC18D \uAC19\uC774 \uC6C0\uC9C1\uC774\uB294 \uAC70\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB2F9\uC5F0\uD558\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC544\uB2C8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uAD73\uC774 \uC9C0\uAE08 \uB530\uB85C \uB2E4\uB2D0 \uC774\uC720\uB3C4
      \uC5C6\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751. \uAC19\uC774 \uB2E4\uB2C8\uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC800\uB3C4 \uADF8\uAC8C \uC88B\uC544\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uADF8\uB7FC \uC815\uD574\uC84C\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC0AC\uB78C\uC744 \uCC3E\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uCD9C\uAD6C\uB3C4 \uCC3E\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC5EC\uAE30\uAC00 \uBB54\uC9C0\uB3C4 \uC54C\uC544\uBCF4\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uD560 \uAC70 \uB9CE\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uCC9C\uCC9C\uD788 \uD558\uBA74 \uB418\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uADF8\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uD558\uB098\uC529 \uCC3E\uC544\uBCF4\uC790."
    portrait: {fileID: 0}
    choices: []
