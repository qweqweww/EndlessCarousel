  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_SisterTalk1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC5B8\uB2C8\uAC00 \uC8FC\uBC29 \uC55E\uC5D0\uC11C \uC591\uD30C\uB97C
      \uC370\uACE0 \uC788\uC5C8\uB2E4. \uCE7C\uC9C8\uC774 \uBE60\uB974\uACE0 \uAC70\uCE60\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB108\uB124 \uC9C4\uC9DC D \uCE5C\uAD6C \uB9DE\uC544?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB9DE\uC544\uC694. \uC544\uB9C8."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC544\uB9C8\uB294 \uBB50\uC57C. \uC598\uAC00 \uCE5C\uAD6C\uB77C\uACE0
      \uC548 \uD574 \uC92C\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uB124\u2026 \uC544\uAE4C \uC544\uB2C8\uB77C\uACE0 \uD558\uC168\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC6D0\uB798 \uADF8\uB798. \uC88B\uC73C\uBA74 \uC88B\uB2E4\uACE0 \uBABB
      \uD558\uACE0, \uC2EB\uC73C\uBA74 \uC2EB\uB2E4\uACE0 \uC5C4\uCCAD \uD574. \uADFC\uB370
      \uC2EB\uC740 \uC0AC\uB78C\uC740 \uC606\uC5D0 \uC548 \uB46C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC606\uC5D0 \uC788\uC73C\uBA74 \uCE5C\uAD6C\uC778
      \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8. \uC4F8\uB370\uC5C6\uB294 \uC18C\uB9AC \uD558\uC9C0 \uB9C8."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC4F8\uB370\uC788\uB294 \uC18C\uB9AC\uC778\uB370?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC7AC\uBC0C\uB294 \uBD84\uC774\uB124\uC694."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uCE58? \uC598\uB9CC \uBAB0\uB77C \uC918."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uAC00 \uC591\uD30C\uB97C \uC370\uB2E4 \uB9D0\uACE0 \uB208\uC744
      \uBE44\uBCD0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC544, \uC591\uD30C \uB9E4\uC6CC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uB0B4\uAC00 \uC36C\uB2E4\uACE0 \uD588\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB10C \uC190 \uBCA0\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC548 \uBCA0\uAC70\uB4E0. \uC5B8\uC81C \uC801 \uC598\uAE30\uC57C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uCE7C\uC744 \uBC1B\uC544 \uB4E4\uC5C8\uB2E4. \uCE7C\uC9C8\uC740
      \uC5B8\uB2C8\uBCF4\uB2E4 \uB290\uB838\uC9C0\uB9CC, \uBC18\uB4EF\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624. \uB298\uC5C8\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB2F9\uC5F0\uD558\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
