    choices: []
  - speakerName: A
    text: "\uC0AC\uB78C\uC740 \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: X
    text: "\uC5EC\uAE30\uB3C4 \uB611\uAC19\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uADFC\uB370 \uC880 \uC2E0\uAE30\uD558\uB2E4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uBB50\uAC00?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uBB34\uB3C4 \uC5C6\uB294\uB370 \uACC4\uC18D \uB3CC\uC544\uAC00\uB294
      \uAC70."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\uC790\uB3D9\uC77C \uC218\uB3C4 \uC788\uC9C0."
