  lines:
  - speakerName: C
    text: "\uADF8\uB7FC, \uBA3C\uC800 \uAC04\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uB6F0\uC5B4\uC11C \uB098\uAC00 \uBCFC\uAE4C. \uB9C8\uC9C0\uB9C9\uC73C\uB85C."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC544\uB2C8\uB2E4. \uAC78\uC5B4\uC11C \uAC00\uC790. \uC5F0\uC2B5\uD574\uC57C\uC9C0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uAC78\uC5B4\uC11C \uBB38\uC744 \uC9C0\uB098\uAC14\uB2E4. \uC870\uAE08
      \uB290\uB9AC\uAC8C, \uADF8\uB798\uB3C4 \uBA48\uCD94\uC9C0 \uC54A\uACE0."
    portrait: {fileID: 0}
    choices: []
