%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Ending_AllReturn
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBA87 \uB2EC \uB4A4. \uB3C4\uC2DC \uD55C\uAD6C\uC11D\uC758 \uC791\uC740
      \uBD84\uC2DD\uC9D1."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB124 \uC0AC\uB78C\uC774 \uD55C \uD14C\uC774\uBE14\uC5D0 \uC549\uC558\uB2E4.
      \uC11C\uB85C\uB97C \uC54C\uC544\uBCF4\uB294 \uAC74 \uC774\uC0C1\uD558\uB9AC\uB9CC\uD07C
      \uC26C\uC6E0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC640. \uC9C4\uC9DC \uB2E4 \uC654\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC548 \uC62C \uC904 \uC54C\uC558\uB0D0."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\u2026 \uAE38\uC744 \uC138 \uBC88 \uC783\uC5C8\uC5B4\uC694. \uADF8\uB798\uB3C4
      \uC654\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uB098\uB3C4 \uB2A6\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: 
    text: "A\uC758 \uC190\uAC00\uB77D\uC5D0\uB294 \uBC18\uCC3D\uACE0\uAC00 \uBD99\uC5B4
      \uC788\uC5C8\uB2E4. \uAC74\uBC18\uC744 \uB108\uBB34 \uC624\uB798 \uCCE4\uB2E4\uACE0
      \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC544\uC9C1 \uBD80\uBAA8\uB2D8 \uC804\uD654\uB97C \uBC1B\uC9C0
      \uBABB\uD588\uB2E4\uACE0 \uD588\uB2E4. C\uC758 \uB2E4\uB9AC\uB294 \uADF8\uB300\uB85C\uC600\uB2E4.
      D\uB294 \uAC00\uB054 \uC5B8\uB2C8 \uAFC8\uC744 \uAFBC\uB2E4\uACE0 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD574\uACB0\uB41C \uAC83\uC740 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uBB34\uC2EC\uCF54 \uCEF5\uC744 \uB2E4\uC12F \uAC1C \uB193\uC558\uB2E4.
      \uC544\uBB34\uB3C4 \uADF8 \uB2E4\uC12F \uBC88\uC9F8 \uCEF5\uC744 \uCE58\uC6B0\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC2B5\uAD00\uC774\uC57C. \uBB58 \uBD10."
    portrait: {fileID: 21300000, guid: bf7395adac3d293499952692b509ac0e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC788\uC796\uC544. \uB2E4\uC74C \uB2EC\uC740 \uC5B4\uB54C?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uB2E4\uC74C \uB2EC."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124! \uC800 \uADF8\uB54C\uAE4C\uC9C0 \uD734\uB300\uD3F0 \uC0B4\uAC8C\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uB798. \uB2E4\uC74C \uB2EC."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC74C\uC774 \uC788\uC5C8\uB2E4. \uADF8\uAC83\uB9CC\uC73C\uB85C,
      \uC624\uB298\uC740 \uCDA9\uBD84\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2014 \uB05D \u2014"
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
