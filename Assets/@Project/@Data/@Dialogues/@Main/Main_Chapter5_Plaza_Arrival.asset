%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Plaza_Arrival
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC911\uC559 \uAD11\uC7A5\uC740 \uCC98\uC74C \uC654\uC744 \uB54C\uC640
      \uB611\uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC1D\uC740 \uC870\uBA85, \uBA40\uB9AC\uC11C \uCC9C\uCC9C\uD788 \uB3C4\uB294
      \uD68C\uC804\uBAA9\uB9C8, \uC0AC\uB78C \uC5C6\uB294 \uBCA4\uCE58."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC544, \uBC30\uBD80\uB974\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uB124\uAC00 \uC81C\uC77C \uB9CE\uC774 \uBA39\uC5C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uC5B8\uB2C8\uBD84\uC774 \uC790\uAFB8 \uD37C \uC8FC\uC154\uC11C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC5B8\uB2C8\uBD84\uC740 \uBB34\uC2A8."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\uB3C4 \uBC30\uBD88\uB7EC\uC694. \uADF8\uB807\uAC8C \uB9CE\uC774
      \uBA39\uC5B4 \uBCF8 \uAC74 \uCC98\uC74C\uC774\uC5D0\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "A\uAC00 \uAD11\uC7A5\uC744 \uD55C \uBC14\uD034 \uB458\uB7EC\uBCF4\uC558\uB2E4.
      \uADF8\uB9AC\uACE0 X\uB97C \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC774\uC81C \uB0A8\uC740 \uAC74."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544, \uB9DE\uB2E4. \uC774\uC81C \uB9C8\uC9C0\uB9C9 \uD55C \uBA85 \uB0A8\uC558\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uB098?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uB204\uAD6C\uC57C. \uC6B0\uB9AC \uB137\uC740 \uB2E4 \uCC3E\uC558\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: D
    text: "\uD53C\uC544\uB178, \uC624\uB77D\uC2E4, \uB2EC\uB9AC\uAE30, \uC800\uB141.
      \uB2E4 \uB098\uC654\uC5B4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "X \uC528 \uCC28\uB840\uC608\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "X\uB294 \uBB50\uB77C\uB3C4 \uC0DD\uAC01\uB098\uB294 \uB370 \uC5C6\uC5B4?
      \uC774\uC0C1\uD558\uAC8C \uB04C\uB9AC\uB294 \uB370\uB77C\uB4E0\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB5A0\uC62C\uB824 \uBCF4\uB824 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC774 \uADF8\uB7AC\uB358 \uAC83\uCC98\uB7FC.
      \uBB34\uC5B8\uAC00\uB97C \uBCF4\uBA74, \uBB34\uC5B8\uAC00\uAC00 \uB3CC\uC544\uC624\uAE30\uB97C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC544\uC9C1\uC740, \uC5C6\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58. \uC6B0\uB9AC\uB3C4 \uCC98\uC74C\uC5D4 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uC5C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uBB3C\uAC74 \uBCF4\uACE0 \uB5A0\uC62C\uB838\uC9C0. \uB2E4\uB4E4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uCC3E\uC73C\uBA74 \uB418\uC9C0. X\uB791 \uC5F0\uACB0\uB41C
      \uAC70."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5B4\uB514\uBD80\uD130 \uBCFC\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uC74C. \uC77C\uB2E8 \uC785\uC7A5\uAD8C \uD30C\uB294 \uB370? \uB4E4\uC5B4\uC628
      \uAE30\uB85D \uAC19\uC740 \uAC70 \uC788\uC744\uC9C0\uB3C4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8\uBA74 \uC624\uB77D\uC2E4 \uC0AC\uC9C4. \uADF8\uAC70 \uB2E4\uC12F\uC774
      \uAC19\uC774 \uCC0D\uC5C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uD68C\uC804\uBAA9\uB9C8 \uC870\uC791\uC2E4\uB3C4. \uCC98\uC74C\uC5D0
      \uB2E4 \uAC19\uC774 \uBCF8 \uB370\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uB9E4\uD45C\uC18C, \uC624\uB77D\uC2E4, \uD68C\uC804\uBAA9\uB9C8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC138 \uAD70\uB370\uB124."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: D
    text: "\uAE08\uBC29\uC774\uC57C. \uAC00\uC790."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uC774\uBC88\uC5D0\uB294 \uB2E4\uC12F\uC774 X\uB97C \uC704\uD574 \uC6C0\uC9C1\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
