%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_Core
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB2E4\uC12F\uC740 \uC190\uC7A1\uC774 \uB2EC\uB9B0 \uBCA4\uCE58 \uADFC\uCC98\uC5D0
      \uBAA8\uC600\uB2E4. C\uB294 \uC549\uC9C0 \uC54A\uACE0, \uB09C\uAC04\uC5D0 \uB4F1\uC744
      \uAE30\uB314\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC804\uC5D0 \uB098\uD55C\uD14C \uB2E4\uC2DC \uD558\uBA74 \uB41C\uB2E4\uACE0
      \uD588\uC9C0."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uB05D\uAE4C\uC9C0 \uB9D0\uB3C4 \uC548 \uD588\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uC54C\uC544."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uADF8 \uC774\uC0C1 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uAC78\uB85C
      \uCDA9\uBD84\uD558\uB2E4\uB294 \uB4EF\uC774."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uD558\uD558. \uADF8\uB54C \uB9D0 \uBA48\uCD98 \uAC70, \uC774\uAC70 \uB54C\uBB38\uC774\uC5C8\uB098
      \uBD10."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E4\uC2DC \uD558\uBA74 \uB41C\uB2E4\uB294 \uB9D0\uC774, \uB098\uD55C\uD14C\uB294
      \uC548 \uB418\uB294 \uB9D0\uC774\uC5C8\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uADFC\uB370 \uC5EC\uAE30\uC11C\uB294 \uB418\uC796\uC544. \uB2E4\uC2DC
      \uD574\uB3C4, \uB610 \uB2E4\uC2DC \uD574\uB3C4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC\u2026 C \uC528\uB294 \uC5EC\uAE30 \uC788\uACE0 \uC2F6\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC194\uC9C1\uD788?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uC870\uAE08\uC740."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30 \uC788\uC73C\uBA74 \uACC4\uC18D \uB6F8 \uC218 \uC788\uC5B4.
      \uB118\uC5B4\uC9C8 \uAC71\uC815 \uC5C6\uC774. \uBCA4\uCE58 \uACC4\uC0B0 \uC548
      \uD574\uB3C4 \uB418\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC70 \uC9C4\uC9DC \uC88B\uC740 \uAC70\uC57C. \uADF8\uAC78 \uBC14\uB77C\uB294
      \uAC8C \uBC14\uBCF4 \uAC19\uC740 \uAC74 \uC544\uB2C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751. \uBC14\uBCF4 \uAC19\uC9C0 \uC54A\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB0A8\uACE0 \uC2F6\uC73C\uBA74, \uADF8\uAC83\uB3C4 \uBB50."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: D
    text: "\uB0B4\uAC00 \uBB50\uB77C \uD560 \uAC74 \uC544\uB2C8\uACE0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC624. D\uAC00 \uCC29\uD55C \uB9D0 \uD588\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC548 \uD588\uC5B4."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC C \uC528\uB294 \uBB58 \uD558\uACE0 \uC2F6\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 8dc8459779a07b141a804f6f6a8d01c4, type: 3}
    choices: []
  - speakerName: C
    text: "\uB6F0\uACE0 \uC2F6\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8, \uB6F0\uB294 \uAC74 \uC9C0\uAE08 \uD558\uACE0 \uC788\uC796\uC544.
      \uADF8\uB7FC\u2026"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB300\uB2F5\uC744 \uCC3E\uB2E4\uAC00, \uAC70\uB9AC \uB05D\uC744
      \uBCF4\uC558\uB2E4. \uBA87 \uBC88\uC744 \uB2EC\uB824\uB3C4 \uB2E4\uC2DC \uB3CC\uC544\uC624\uB294
      \uADF8 \uB05D\uC744."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBAA8\uB974\uACA0\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30 \uC624\uACE0 \uB098\uC11C, \uB6F0\uBA74\uC11C \uACC4\uC18D
      \uC0DD\uAC01\uD588\uAC70\uB4E0. \uC774\uAC8C \uB0B4\uAC00 \uBC14\uB77C\uB358
      \uAC70\uB77C\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uADFC\uB370 \uC544\uAE4C \uC804\uAD11\uD310 \uBCF4\uB294\uB370, \uADF8
      \uC0DD\uAC01\uC774 \uB0AC\uC5B4. '\uB2E4\uC74C\uC5D4 \uB354 \uC904\uC5EC\uC57C\uC9C0.'"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uC120 \uADF8\uAC8C \uC548 \uB3FC. \uB354 \uC904\uC77C \uC218\uB3C4
      \uC5C6\uACE0, \uB2E4\uC74C \uB300\uD68C\uB3C4 \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uB2C8\uAE4C\u2026"
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uC11C\uB294 \uBB34\uC5C7\uC774\uB4E0 \uD560 \uC218 \uC788\uB294\uB370,
      \uC544\uBB34\uAC83\uB3C4 \uB420 \uC218 \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: 
    text: "\uBC14\uB78C\uC774 \uAE43\uBC1C\uC744 \uD754\uB4E4\uC5C8\uB2E4. \uAE43\uBC1C\uC740
      \uB298 \uAC19\uC740 \uBC29\uD5A5\uC73C\uB85C\uB9CC \uD754\uB4E4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBC16\uC5D0\uC11C\uB294 \uBABB \uB6F0\uC5B4. \uADF8\uAC74 \uC548 \uBC14\uB00C\uC5B4."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uB3CC\uC544\uAC00\uBA74 \uB610 \uBCA4\uCE58 \uACC4\uC0B0\uD558\uACE0,
      \uB09C\uAC04 \uC7A1\uACE0, \uC624\uB298 \uC548 \uB118\uC5B4\uC9C0\uBA74 \uB410\uB2E4
      \uD558\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uC9C4\uC9DC \uC2EB\uC5B4. \uC194\uC9C1\uD788."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uB300\uC2E0 \uBC16\uC5D0\uC11C\uB294\u2026 \uB0B4\uAC00 \uBB50\uAC00
      \uB420\uC9C0, \uC544\uC9C1 \uC548 \uC815\uD574\uC84C\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544, \uBAA8\uB974\uACA0\uB2E4. \uB9D0\uD558\uB2C8\uAE4C \uC880 \uC6C3\uAE30\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices:
    - text: "\uB2EC\uB9AC\uB294 \uAC83\uB9CC \uC55E\uC73C\uB85C \uAC00\uB294 \uAC74
        \uC544\uB2C8\uC796\uC544."
      next: {fileID: 11400000, guid: fcd9cd0f88b37254a88ce7d598c7018a, type: 2}
      choiceId: Chapter3_C_Response_Forward
      recordAsFlag: 1
    - text: "\uC544\uC9C1 \uBB58 \uD560\uC9C0\uB294 \uC815\uD558\uC9C0 \uC54A\uC544\uB3C4
        \uB418\uC9C0."
      next: {fileID: 11400000, guid: 9127c6e561da99d4397acb675b3e2ffa, type: 2}
      choiceId: Chapter3_C_Response_NoRush
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
