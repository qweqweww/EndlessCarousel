  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_B_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC624\uB77D\uC2E4\uC758 \uBD88\uBE5B\uC740 \uAEBC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uB9E4\uC77C \uC778\uD615\uBF51\uAE30\uB97C \uD588\uB2E4. \uC9D1\uAC8C\uB294
      \uC5EC\uC804\uD788 \uAC70\uC758 \uC9D1\uC9C0 \uBABB\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB099\uC11C \uAC8C\uC2DC\uD310\uC5D0\uB294 B\uC758 \uBA54\uBAA8\uC9C0\uAC00
      \uB298\uC5B4 \uAC14\uB2E4. '\uC624\uB298\uB3C4 \uAC19\uC774 \uC640\uC694.'
      '\uB0B4\uC77C\uB3C4.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC624\uB298\uC740\u2026 \uC800 \uD1A0\uB07C\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC6C3\uC5C8\uB2E4. \uC785\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC9C\uCC9C\uD788 \uD574\uB3C4 \uB41C\uB2E4\uACE0 \uD588\uB2E4. B\uB294
      \uC815\uB9D0\uB85C, \uCC9C\uCC9C\uD788 \uD558\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
