%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Arrival
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC911\uC559 \uAD11\uC7A5 \uC11C\uCABD \uACE8\uBAA9 \uB05D, \uBD88\uC774
      \uCF1C\uC9C4 \uC2DD\uB2F9\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC3D\uAC00\uC5D0 2\uC778\uC6A9 \uC2DD\uD0C1\uC774 \uC904\uC9C0\uC5B4
      \uC788\uACE0, \uC548\uCABD \uC8FC\uBC29\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uB053\uB294
      \uC18C\uB9AC\uAC00 \uB0AC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4, \uC5EC\uAE30 \uBD88 \uCF1C\uC838 \uC788\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uB0C4\uC0C8\uB3C4 \uB098\uC694. \uB204\uAC00\u2026 \uC694\uB9AC\uD558\uACE0
      \uC788\uB098 \uBD10\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: A
    text: "\uC0AC\uB78C\uC774 \uC788\uB2E4\uACE0?"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7F4 \uB9AC\uAC00. \uC5EC\uAE30 \uACC4\uC18D \uC544\uBB34\uB3C4
      \uC5C6\uC5C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uBA3C\uC800 \uBB38\uC744 \uBC00\uC5C8\uB2E4. \uB538\uB791, \uC791\uC740
      \uC885\uC774 \uC6B8\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC8FC\uBC29 \uC785\uAD6C\uC5D0 \uC55E\uCE58\uB9C8\uB97C \uB450\uB978
      \uC5EC\uC790\uAC00 \uC11C \uC788\uC5C8\uB2E4. \uAD6D\uC790\uB97C \uB4E0 \uCC44\uB85C,
      \uC774\uCABD\uC744 \uB3CC\uC544\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uB0AF\uC120 \uC5EC\uC790"
    text: "\uC5B4, \uC654\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uB0AF\uC120 \uC5EC\uC790"
    text: "\uB108 \uB610 \uBC25 \uB300\uCDA9 \uBA39\uC5C8\uC9C0. \uC5BC\uAD74\uC774
      \uB531 \uADF8\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBB38\uD131\uC5D0\uC11C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC544\uB294 \uC0AC\uB78C\uC774\uC57C?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: D?
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC5B8\uB2C8."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: 
    text: "\uBAA9\uC18C\uB9AC\uAC00 \uC544\uC8FC \uC791\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC65C \uADF8\uB807\uAC8C \uBD10? \uC0AC\uB78C \uCC98\uC74C \uBD10?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC544, \uC190\uB2D8\uB3C4 \uB370\uB824\uC654\uB124. \uCE5C\uAD6C\uC57C?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uCE5C\uAD6C\uB294 \uBB34\uC2A8\u2026."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uCE5C\uAD6C \uB9DE\uB124. \uB108 \uCE5C\uAD6C \uC544\uB2C8\uBA74 \uC774\uB807\uAC8C
      \uC6B0\uB974\uB974 \uC548 \uB2E4\uB2C8\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC544\uB2C8\uB77C\uACE0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uB798\uADF8\uB798. \uB2E4\uB4E4 \uC549\uC544. \uC544\uC9C1 \uC601\uC5C5
      \uC804\uC774\uB77C \uBA54\uB274\uB294 \uC5C6\uB294\uB370, \uBB50\uB4E0 \uD574
      \uC904 \uC218\uB294 \uC788\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC544, \uC548\uB155\uD558\uC138\uC694. \uC800\uB294 B\uB77C\uACE0 \uD574\uC694."
    portrait: {fileID: 21300000, guid: a6c52585ce5407947bdd62f5f1dd0d5c, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624, \uC608\uC758 \uBC14\uB974\uB2E4. D, \uB108\uB3C4 \uC880 \uBC30\uC6CC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB58 \uBC30\uC6CC."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uB9AC\uACE0 \uB108. \uC190 \uC53B\uACE0 \uC640."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB0B4\uAC00 \uBA87 \uC0B4\uC778\uB370."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uBA87 \uC0B4\uC774\uB4E0 \uB354\uB7FD\uAC8C \uBA39\uB294 \uAC74 \uB611\uAC19\uAC70\uB4E0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uD558\uD558. D\uAC00 \uB9D0\uB85C \uC9C0\uB294 \uAC70 \uCC98\uC74C \uBCF8\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC548 \uC84C\uC5B4."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uD234\uD234\uAC70\uB9AC\uBA74\uC11C\uB3C4, \uC815\uB9D0\uB85C
      \uC190\uC744 \uC53B\uC73C\uB7EC \uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uCF67\uB178\uB798\uB97C \uBD80\uB974\uBA70 \uB2E4\uC2DC
      \uC8FC\uBC29\uC73C\uB85C \uB4E4\uC5B4\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026D \uC5B8\uB2C8\uB798."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uB2EE\uC558\uB124. \uB9D0\uD22C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uB418\uAC8C\u2026 \uB2E4\uC815\uD558\uC2E0 \uBD84 \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB3CC\uC544\uC628 D\uB294 \uC544\uBB34 \uB9D0 \uC5C6\uC774 \uC2DD\uB2F9
      \uC548\uC744 \uB458\uB7EC\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC3D\uAC00 \uCABD, 2\uC778\uC6A9 \uC2DD\uD0C1 \uD558\uB098\uC5D0 \uC2DC\uC120\uC774
      \uC624\uB798 \uBA38\uBB3C\uB800\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC5EC\uAE30, \uC880 \uBCFC\uAC8C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uAC19\uC774 \uBCF4\uC790."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uB410\uC5B4. \uB0B4\uAC00 \uBCFC\uAC8C. \uB108\uB124\uB294 \uC549\uC544
      \uC788\uB4E0\uAC00."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uADF8\uB807\uAC8C \uB9D0\uD558\uBA74\uC11C\uB3C4 D\uB294 \uADF8\uB8F9\uC744
      \uB0B4\uBCF4\uB0B4\uC9C0\uB294 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
