%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_Rhythm
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uD654\uC0B4\uD45C\uAC00 \uC3DF\uC544\uC9C0\uB294 \uB9AC\uB4EC \uAC8C\uC784\uAE30.
      \uBC1C\uD310\uC774 \uB124 \uAC1C \uBD99\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "B, \uC774\uAC70 \uAC19\uC774 \uD558\uC790. \uD654\uC0B4\uD45C \uB098\uC624\uBA74
      \uBC1F\uC73C\uBA74 \uB3FC."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124? \uC800 \uC774\uB7F0 \uAC70 \uD574\uBCF8 \uC801\u2026."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uD558\uB294 \uAC70\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "\uC74C\uC545\uC774 \uC2DC\uC791\uB410\uB2E4. B\uB294 \uCC98\uC74C \uBA87
      \uBC15\uC790\uB97C \uB193\uCE58\uB354\uB2C8, \uAE08\uC138 \uB530\uB77C\uC7A1\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B4? \uC7E4 \uC798\uD558\uB294\uB370?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "\uB9C8\uC9C0\uB9C9 \uACE1\uC774 \uB05D\uB0AC\uC744 \uB54C, \uC810\uC218\uB294
      B\uAC00 \uC870\uAE08 \uB354 \uB192\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC84C\uB2E4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5B4\u2026 \uC774\uACBC\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: B
    text: "C \uC528, \uC624\uB77D\uC2E4 \uBC15\uC0AC\uB77C\uBA74\uC11C\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC640, \uBC29\uAE08 \uB180\uB9B0 \uAC70\uC57C?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uB2C8\uC694? \uADF8\uB0E5 \uC5EC\uCB64\uBCF8 \uAC74\uB370\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC2DC\uCE58\uBBF8\uB97C \uB5BC\uACE0 \uC6C3\uC5C8\uB2E4. D\uAC00
      \uC606\uC5D0\uC11C \uD06C\uAC8C \uC6C3\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uBC15\uC0AC \uB9DE\uC544?"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "A\uAE4C\uC9C0 \uADF8\uB7EC\uAE30\uC57C?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uD654\uBA74\uC5D0 \uB0A8\uC740 \uACE1 \uC81C\uBAA9\uC744 \uD55C\uCC38
      \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC774 \uB178\uB798\u2026 \uC5B4\uB514\uC11C \uB4E4\uC5B4 \uBCF8 \uAC83
      \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uC8FC \uC791\uC740 \uD654\uBA74\uC5D0\uC11C\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
