--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_C_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "C\uB294 \uD37C\uB808\uC774\uB4DC \uAC70\uB9AC\uB85C \uC774\uC5B4\uC9C0\uB294
      \uAE38 \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4. \uB6F0\uC9C0 \uC54A\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC624, X. \uD0C0\uC774\uBC0D \uC88B\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098 \uB098\uAC08\uB798."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098\uAC00\uBA74 \uB2E4\uC2DC \uC608\uC804\uCC98\uB7FC \uBABB \uB6F0\uACA0\uC9C0.
      \uC5EC\uAE30\uCC98\uB7FC\uC740 \uB354\uB354\uC6B1."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uBB58 \uD560\uC9C0\uB3C4 \uC544\uC9C1 \uBAA8\uB974\uACA0\uACE0. \uC9C4\uC9DC
      \uD558\uB098\uB3C4."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uADF8\uB798\uC11C \uAC00 \uBCF4\uB824\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uBAA8\uB974\uB294 \uAC70\uB791 \uB05D\uB09C \uAC74 \uB2E4\uB974\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2EC\uB9AC\uB294 \uAC83\uB9CC \uC55E\uC73C\uB85C \uAC00\uB294 \uAC74
      \uC544\uB2C8\uB77C\uBA70. \uB124\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC \uAC77\uB4E0 \uAE30\uB4E0, \uC77C\uB2E8 \uAC00 \uBCF4\uC9C0
      \uBB50."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uC11C \uD55C \uBC88 \uB354 \uB6F0\uBA74 \uB610 11\uCD08 02
      \uB098\uC624\uACA0\uC9C0. \uADF8\uAC74 \uC774\uC81C \uB410\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E4\uC74C\uC740 \uBC16\uC5D0\uC11C \uC815\uD560\uB798. \uBB50\uAC00
      \uB418\uB4E0."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
