  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Gate_D_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: D
    text: "\u2026\u2026\uAC04\uB2E4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB58 \uBD10. \uC6B8 \uAC70 \uC544\uB2C8\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBB38\uC744 \uC9C0\uB098\uAE30 \uC9C1\uC804, \uB808\uC2A4\uD1A0\uB791
      \uCABD \uACE8\uBAA9\uC744 \uD55C \uBC88 \uB3CC\uC544\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBD88\uC774 \uCF1C\uC838 \uC788\uC5C8\uB2E4. \uB204\uAD70\uAC00 \uC124\uAC70\uC9C0\uB97C
      \uD558\uB294 \uAC83 \uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB2E4\uB140\uC62C\uAC8C, \uC5B8\uB2C8."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBB38\uC744 \uC9C0\uB098\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
