  lines:
  - speakerName: X
    text: "\uC800\uD55C\uD14C \uBB34\uC2A8 \uC9D3 \uD55C \uAC74 \uC544\uB2C8\uC8E0?"
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC544\uB1E8. \uC800\uD76C\uB3C4 \uC870\uAE08 \uC804\uC5D0 \uC5EC\uAE30\uC11C
      \uAE7C\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC815\uC2E0 \uCC28\uB838\uC744 \uB54C\uB294 \uC774\uBBF8 \uB2E4 \uAC19\uC774
      \uC5EC\uAE30 \uC788\uC5C8\uACE0\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uADF8\uB807\uAC8C \uC0DD\uAC01 \uD560\uB9CC\uD558\uAE34 \uD574\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uB531\uD788 \uC99D\uBA85\uD560 \uBC29\uBC95\uC740 \uC5C6\uB124\uC694."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
