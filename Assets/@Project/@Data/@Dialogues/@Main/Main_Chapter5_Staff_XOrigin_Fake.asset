  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_XOrigin_Fake
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: X
    text: "\uADF8\uB7FC \uB098\uB294 \uAC00\uC9DC\uC778 \uAC78\uAE4C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uAC00\uC9DC\uAC00 \uB9D0\uB3C4 \uD558\uB0D0."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uBB58 \uC774\uC81C \uC640\uC11C \uAC00\uC9DC\uB798. \uAC19\uC774 \uBC25\uAE4C\uC9C0
      \uBA39\uC5B4 \uB193\uACE0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uC801\uC5B4\uB3C4 \uC5EC\uAE30 \uAC19\uC774 \uB3CC\uC544\uB2E4\uB2CC
      \uAC74 \uC9C4\uC9DC\uC796\uC544. \uC0AC\uC9C4 \uBD80\uC2A4\uC5D0\uC11C \uB2E4
      \uAC19\uC774 \uB07C\uC5B4 \uC788\uB358 \uAC83\uB3C4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC1C \uBC1F\uD78C \uAC83\uB3C4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uC800\uD55C\uD14C\uB294 X \uC528\uAC00 \uC788\uC5C8\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uC778\uD615\uBF51\uAE30 \uD560 \uB54C\uB3C4, \uAC8C\uC2DC\uD310\uC5D0
      \uC4F8 \uB54C\uB3C4. \uACC4\uC18D\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uADF8\uB798."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 11400000, guid: b72f26b015f89f84a864df2d870f7d2f, type: 2}
