  lines:
  - speakerName: 
    text: "\uBB34\uB300 \uC704\uC5D0 \uADF8\uB79C\uB4DC \uD53C\uC544\uB178 \uD55C
      \uB300\uAC00 \uB193\uC5EC \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uAC00 \uC9C4\uC9DC \uACF5\uC5F0\uC7A5\uC774\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uD145 \uBE44\uC5C8\uB124. \uAD00\uAC1D\uB3C4 \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uC870\uBA85\uC740\u2026 \uCF1C\uC838 \uC788\uB124\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "A\uC758 \uC2DC\uC120\uC774 \uD53C\uC544\uB178\uC5D0\uC11C \uB5A8\uC5B4\uC9C0\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: A?
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uB458\uB7EC\uBCF4\uC790."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
