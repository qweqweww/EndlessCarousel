%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_Arrival
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC911\uC559 \uAD11\uC7A5 \uB3D9\uCABD\uC73C\uB85C, \uACE7\uAC8C \uBED7\uC740
      \uB113\uC740 \uAC70\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC14\uB2E5\uC5D0\uB294 \uD37C\uB808\uC774\uB4DC \uD589\uB82C\uC774 \uC9C0\uB098\uAC08
      \uAE38\uC744 \uB530\uB77C \uD558\uC580 \uC120\uC774 \uB05D\uAE4C\uC9C0 \uADF8\uC5B4\uC838
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC591\uCABD\uC73C\uB85C \uAE43\uBC1C\uC774 \uB298\uC5B4\uC11C \uC788\uC5C8\uC9C0\uB9CC,
      \uD589\uB82C\uC740 \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE34 \uB610 \uBB50\uC57C. \uC5C4\uCCAD \uAE38\uB2E4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uD37C\uB808\uC774\uB4DC \uD558\uB294 \uAE38\uC778\uAC00 \uBD10\uC694.
      \uD45C\uC9C0\uD310\uC5D0 \uADF8\uB807\uAC8C \uC801\uD600 \uC788\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\uC544\uBB34\uB3C4 \uC5C6\uB294\uB370."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 8dc8459779a07b141a804f6f6a8d01c4, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uD55C \uBC1C \uC55E\uC73C\uB85C \uB098\uC130\uB2E4. \uADF8\uB9AC\uACE0
      \uD55C \uBC1C \uB354."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB2E4\uC74C\uC5D0\uB294, \uB6F0\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC57C!"
    portrait: {fileID: 21300000, guid: 21bd4aa4290022744b657525a11a3354, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uAE08\uC138 \uBA40\uC5B4\uC84C\uB2E4. \uAE43\uBC1C \uC0AC\uC774\uB97C
      \uC9C0\uB098, \uD558\uC580 \uC120\uC744 \uB530\uB77C, \uAC70\uB9AC \uB05D \uCABD\uC73C\uB85C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C\uCC38 \uB4A4\uC5D0\uC57C C\uAC00 \uBA48\uCDB0 \uC130\uB2E4. \uADF8\uB9AC\uACE0
      \uB4A4\uB97C \uB3CC\uC544\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC640."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC640\u2026 \uC774\uAC74 \uC880 \uBC18\uCE59\uC778\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: X
    text: "\uBB50\uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBAB0\uB77C. \uADF8\uB0E5\u2026 \uC5C4\uCCAD \uC88B\uC544."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uBC1C\uC774 \uB545\uC5D0 \uB2FF\uB294 \uAC8C \uD558\uB098\uD558\uB098
      \uB2E4 \uB290\uAEF4\uC838. \uBC14\uB78C\uB3C4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC6C3\uACE0 \uC788\uC5C8\uB2E4. \uC7A5\uB09C\uC2A4\uB7EC\uC6B4
      \uC6C3\uC74C\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uC815\uB9D0\uB85C \uAE30\uBED0
      \uBCF4\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uD55C \uBC88\uB9CC \uB354."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB300\uB2F5\uB3C4 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uB2E4\uC2DC
      \uB2EC\uB824 \uB098\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC57C, \uD63C\uC790 \uAC00\uBA74 \uBB50\uD558\uB0D0!"
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uD22C\uB35C\uAC70\uB9AC\uBA74\uC11C\uB3C4 C\uAC00 \uAC04 \uCABD\uC73C\uB85C
      \uAC78\uC74C\uC744 \uC62E\uACBC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uAC70\uB9AC\uB97C \uD55C \uBC14\uD034 \uB3CC\uC544 \uB2E4\uC2DC
      \uBAA8\uB450 \uC55E\uC5D0 \uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBBF8\uC548\uBBF8\uC548. \uBAB8\uC774 \uBA3C\uC800 \uB098\uAC14\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uBAB8\uC774 \uBA3C\uC800 \uB098\uAC00\uB294 \uAC8C \uC5B4\uB528\uC5B4."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uC788\uB354\uB77C\uACE0, \uADF8\uB7F0 \uAC8C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uAE30\uB2E4\uB824."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uB2E4 \uAC19\uC774 \uAC00. \uC5EC\uAE30 \uAE38\uC5B4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC624\uCF00\uC774. \uB300\uC2E0 \uB2E4\uC74C\uC5D4 \uAC19\uC774 \uB6F0\uC790."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\uC2EB\uC5B4."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E8\uD638\uD558\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: B
    text: "C \uC528, \uC815\uB9D0 \uBE60\uB974\uC2DC\uB124\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58? \uB098\uB3C4 \uBAB0\uB790\uC5B4. \uB098 \uC774\uB807\uAC8C
      \uBE68\uB790\uB098."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "B\uB3C4 \uAC19\uC774 \uB6F8\uB798? \uC800\uAE30 \uAE43\uBC1C\uAE4C\uC9C0
      \uB204\uAC00 \uBA3C\uC800 \uAC00\uB098."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC74C\u2026 \uC88B\uC544\uC694. \uADFC\uB370 C \uC528, \uC544\uAE4C \uC800\uD55C\uD14C
      \uAC8C\uC784 \uC84C\uC796\uC544\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uBC1C\uB85C \uBC1F\uB294 \uAC70\uC600\uACE0, \uC774\uAC74
      \uADF8\uB0E5 \uB6F0\uB294 \uAC70\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uAC83\uB3C4 \uBC1C\uB85C \uD558\uB294 \uAC70 \uC544\uB2C8\uC5D0\uC694?"
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC5B4. \uB9DE\uB124."
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: D
    text: "\uC84C\uB2E4, \uC84C\uC5B4."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uC9C1 \uC548 \uB6F0\uC5C8\uAC70\uB4E0?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uC77C\uB2E8 \uB458\uB7EC\uBCF4\uC790. \uBC14\uB2E5\uC5D0 \uBB50\uAC00
      \uADF8\uB824\uC838 \uC788\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uAC00 \uAC00\uB9AC\uD0A8 \uACF3, \uAC70\uB9AC \uBC14\uB2E5\uC5D0 \uCEE4\uB2E4\uB780
      \uD654\uC0B4\uD45C\uAC00 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4. \uBCC4\uC774
      \uADF8\uB824\uC9C4 \uC6D0\uC5D0\uC11C \uC2DC\uC791\uD574, \uAC70\uB9AC \uB05D
      \uC544\uCE58\uB97C \uAC00\uB9AC\uD0A4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE38\uAC00\uC758 \uD3EC\uD1A0 \uC2A4\uD31F \uC704\uC5D0\uC11C\uB294
      \uC791\uC740 \uC804\uAD11\uD310\uC774 \uAE5C\uBE61\uC774\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4, \uC800\uAC70."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uC544\uC8FC \uC870\uAE08 \uB0AE\uC544\uC84C\uB2E4.
      \uADF8\uB9AC\uACE0 \uAE08\uBC29 \uC6D0\uB798\uB300\uB85C \uB3CC\uC544\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uAC00 \uBCF4\uC790."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
