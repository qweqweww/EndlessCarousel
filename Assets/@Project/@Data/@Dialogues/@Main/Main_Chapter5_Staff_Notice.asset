%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_Notice
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBCF5\uB3C4 \uB05D \uAC8C\uC2DC\uD310\uC5D0 \uBE5B\uBC14\uB79C \uC548\uB0B4\uBB38\uC774
      \uD55C \uC7A5 \uBD99\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC774\uACF3\uC5D0 \uC624\uC2E0 \uBD84\uAED8.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC774\uACF3\uC740 \uB3CC\uC544\uAC00\uACE0 \uC2F6\uC9C0 \uC54A\uC740
      \uB9C8\uC74C\uC774 \uBA38\uBB34\uB294 \uACF3\uC785\uB2C8\uB2E4.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC6D0\uD558\uC2DC\uB358 \uAC83\uC744, \uC6D0\uD558\uC2DC\uB294 \uB9CC\uD07C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uBA38\uBB34\uB294 \uB3D9\uC548 \uBD88\uD3B8\uC774 \uC5C6\uAE30\uB97C
      \uBC14\uB78D\uB2C8\uB2E4.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB3CC\uC544\uAC00\uACE0 \uC2F6\uC9C0 \uC54A\uC740 \uB9C8\uC74C."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: B
    text: "\uC6D0\uD558\uC2DC\uB358 \uAC83\uC744\u2026 \uC6D0\uD558\uC2DC\uB294 \uB9CC\uD07C."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: C
    text: "\uBD88\uD3B8\uC774 \uC5C6\uAE30\uB97C. \uCE5C\uC808\uD558\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uB204\uAC00 \uC4F4 \uAC74\uB370."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "\uC548\uB0B4\uBB38\uC5D0\uB294 \uC4F4 \uC0AC\uB78C\uC758 \uC774\uB984\uC774
      \uC5C6\uC5C8\uB2E4. \uB0A0\uC9DC\uB3C4 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE00\uC528\uB294 \uC778\uC1C4\uB41C \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0,
      \uC190\uC73C\uB85C \uC4F4 \uAC83 \uAC19\uAE30\uB3C4 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC5EC\uAE30 \uB4E4\uC5B4\uC628 \uC774\uC720\uAC00, \uADF8\uAC70\uC600\uB2E4\uB294
      \uAC70\uC57C? \uB3CC\uC544\uAC00\uACE0 \uC2F6\uC9C0 \uC54A\uC544\uC11C?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uC544\uBB34\uB3C4
      \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
