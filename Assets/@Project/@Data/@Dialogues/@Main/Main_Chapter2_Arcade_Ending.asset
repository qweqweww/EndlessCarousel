%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_Ending
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uAC00 \uCC9C\uCC9C\uD788 \uC77C\uC5B4\uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uC544\uC8FC \uC7A0\uAE50 \uB9DD\uC124\uC774\uB2E4\uAC00,
      D \uC606\uC73C\uB85C \uAC00\uC11C \uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB50."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uB2C8\uC694. \uADF8\uB0E5, \uC5EC\uAE30 \uC11C \uC788\uC73C\uB824\uACE0\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB9D8\uB300\uB85C \uD574."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uACE0\uAC1C\uB97C \uB3CC\uB838\uC9C0\uB9CC, \uC790\uB9AC\uB97C
      \uBE44\uD0A4\uC9C0\uB294 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "C \uC528."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC778\uD615\uBF51\uAE30\u2026 \uD55C \uD310\uB9CC \uB354 \uD574\uB3C4
      \uB3FC\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2F9\uC5F0\uD558\uC9C0. \uC774\uBC88\uC5D4 \uC9C4\uC9DC \uAC70\uC758
      \uB418\uAC8C \uD574 \uC904\uAC8C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "D \uC528\uCC98\uB7FC \uAC70\uC9D3\uB9D0\uB85C\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uC57C!"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "B\uAC00 \uC18C\uB9AC \uB0B4\uC5B4 \uC6C3\uC5C8\uB2E4. \uC774\uBC88\uC5D0\uB294
      \uC785\uC744 \uAC00\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8\uB9AC\uACE0\u2026 \uC774\uBC88\uC5D4 \uC81C\uAC00 \uACE0\uB97C\uB798\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800 \uD1A0\uB07C\uC694. \uADC0\uAC00 \uD55C\uCABD\uB9CC \uC811\uD78C
      \uAC70."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uAD1C\uCC2E\uC740 \uAC70 \uACE8\uB790\uB124."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "\uC9D1\uAC8C\uB294 \uC774\uBC88\uC5D0\uB3C4 \uC544\uBB34\uAC83\uB3C4 \uC9D1\uC9C0
      \uBABB\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4 \uC544\uBB34\uB3C4 \uADF8\uB9CC\uD558\uC790\uACE0 \uD558\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC8C\uC784\uC774 \uB05D\uB098\uACE0, B\uB294 \uC0C8 \uBA54\uBAA8\uC9C0\uB97C
      \uBCBD\uC5D0 \uBD99\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB2E4\uC74C\uC5D0\uB3C4 \uAC19\uC774 \uC640\uC694.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB204\uAD6C\uC5D0\uAC8C \uC4F4 \uAC74\uC9C0\uB294 \uC801\uD600 \uC788\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "X \uC528. \uAC19\uC774 \uC368 \uC8FC\uC2E0\uB2E4\uACE0 \uD588\uB294\uB370\u2026
      \uC81C\uAC00 \uBA3C\uC800 \uC368 \uBC84\uB838\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: X
    text: "\uAD1C\uCC2E\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC \uB2E4\uC74C \uAC74\u2026 \uAC19\uC774 \uC368\uC694. \uB2E4\uC74C\uC5D0\uB3C4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: 
    text: "\uC624\uB77D\uC2E4 \uBD88\uBE5B\uC774 \uACC4\uC18D \uAE5C\uBE61\uC774\uACE0
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC00\uAE4C\uC6CC\uC9C0\uB294 \uAC74 \uC544\uC9C1 \uBB34\uC11C\uC6E0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4 B\uB294, \uC774\uBC88\uC5D0\uB294 \uBA3C\uC800 \uB04A\uC5B4\uB0B4\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
