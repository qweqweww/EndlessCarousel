%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Memory4_B
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uAC00 \uCD9C\uB825\uAD6C\uC758 \uC0AC\uC9C4\uC744 \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4.
      \uBC18\uCBE4 \uCC22\uAE34 \uC0AC\uC9C4. \uB0A8\uC740 \uCABD\uC5D0\uB294 \uC5F4\uC138
      \uC0B4\uC758 B\uB9CC \uC6C3\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "2\uC8FC\uAC00 \uC9C0\uB098\uACE0, B\uB294 \uC6D0\uB798 \uBC29\uC73C\uB85C
      \uB3CC\uC544\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC774\uBAA8"
    text: "B\uC57C, \uBC25 \uBA39\uC73C\uB7EC \uAC00\uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC0AC\uB78C\uB4E4\uC740 \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uC5C8\uB358
      \uAC83\uCC98\uB7FC \uB2E4\uC2DC \uB9D0\uC744 \uAC78\uC5C8\uB2E4. \uC5C4\uB9C8\uB3C4
      \uC608\uC804\uCC98\uB7FC \uC6C3\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC2DD\uB2F9\uC5D0\uC11C \uC81C\uC77C \uBA3C\uC800 \uADF8 \uC560\uB97C
      \uCC3E\uC558\uB2E4. \uADF8 \uC560\uC758 \uC790\uB9AC\uB294 \uBE44\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uAC54\uB294\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uC544\uC9C1 \uBC18\uC131 \uC911\uC774\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC544\uC9C1\uB3C4\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uB124\uAC00 \uACC4\uC18D \uB9C8\uC74C\uC744 \uC92C\uC796\uB2C8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uADF8 \uC544\uC774\uB3C4 \uB124\uAC00 \uC790\uAE30\uB97C \uACC4\uC18D
      \uCE5C\uAD6C\uB85C \uB300\uD574 \uC8FC\uB2C8\uAE4C, \uC790\uAE30 \uC798\uBABB\uC744
      \uC81C\uB300\uB85C \uAE68\uB2EB\uC9C0 \uBABB\uD55C \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uB458 \uB2E4 \uC11C\uB85C\uC5D0\uAC8C \uC88B\uC9C0 \uC54A\uC740 \uC601\uD5A5\uC744
      \uC900 \uAC70\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC21F\uAC00\uB77D\uC744 \uB0B4\uB824\uB193\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC81C\uAC00 \uC778\uC0AC\uD574\uC11C. \uC81C\uAC00 \uAD1C\uCC2E\uB0D0\uACE0
      \uBB3C\uC5B4\uC11C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uC11C \uADF8 \uC560\uAC00, \uC544\uC9C1\uB3C4 \uADF8 \uBC29\uC5D0
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBCF4\uACE0 \uC2F6\uC5C8\uB2E4. \uAC71\uC815\uB410\uB2E4. \uADF8\uB798\uB3C4
      B\uB294 \uCC3E\uC544\uAC00\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB610 \uCC3E\uC73C\uBA74, \uADF8 \uC560\uC758 \uBC8C\uC774 \uB354 \uAE38\uC5B4\uC9C8
      \uD14C\uB2C8\uAE4C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBA87 \uC8FC \uB4A4, \uADF8 \uC560\uB294 \uACF5\uB3D9\uCCB4 \uC548\uC5D0\uC11C
      \uC544\uC608 \uBCF4\uC774\uC9C0 \uC54A\uAC8C \uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8 \uC560\uB294\u2026 \uC5B4\uB514 \uC788\uC5B4\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uB2E4\uB978 \uACF3\uC5D0\uC11C \uB9C8\uC74C\uC744 \uBC14\uB85C\uC7A1\uACE0
      \uC788\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC778\uB3C4\uC790"
    text: "\uC774\uC81C \uB124\uAC00 \uC2E0\uACBD \uC4F8 \uC77C\uC774 \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB978 \uC2DC\uC124\uB85C \uAC04 \uAC74\uC9C0, \uAC00\uC871\uACFC
      \uB5A0\uB09C \uAC74\uC9C0, \uACF5\uB3D9\uCCB4\uB97C \uB098\uAC04 \uAC74\uC9C0.
      \uC544\uBB34\uB3C4 \uC54C\uB824 \uC8FC\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uB2E4\uC2DC\uB294 \uADF8 \uC560\uB97C \uB9CC\uB098\uC9C0 \uBABB\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uB4A4\uB85C B\uB294, \uB204\uAD70\uAC00\uAC00 \uC88B\uC544\uC9C0\uBA74
      \uBA40\uB9AC\uC11C \uB208\uC73C\uB85C\uB9CC \uB530\uB77C\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uAC00\uAE4C\uC6CC\uC9C8 \uAC83 \uAC19\uC73C\uBA74,
      \uBA3C\uC800 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
