  lines:
  - speakerName: 
    text: "\uBB34\uB300 \uC55E\uC5D0 \uAE34 \uCC45\uC0C1\uC774 \uB193\uC5EC \uC788\uB2E4.
      \uC774\uB984\uD45C \uC5C6\uB294 \uC758\uC790 \uC138 \uAC1C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC45\uC0C1 \uC704\uC5D0 \uCC44\uC810\uD45C\uAC00 \uB193\uC5EC \uC788\uB2E4.
      \uCE78\uC740 \uC804\uBD80 \uBE44\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC2EC\uC0AC\uC704\uC6D0\uC11D\uC778\uAC00?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE30\uC11C \uB300\uD68C\uB77C\uB3C4 \uD588\uB098 \uBCF4\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: X
    text: A?
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC810\uC218 \uCE78."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uBE44\uC5B4 \uC788\uB124."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
