  lines:
  - speakerName: 
    text: "\uC561\uC790 \uC18D \uC0AC\uC9C4. \uD53C\uC544\uB178 \uC55E\uC5D0 \uC549\uC740
      \uC544\uC774\uAC00 \uD65C\uC9DD \uC6C3\uACE0 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uC774\uC758 \uBC1C\uC740 \uD398\uB2EC\uC5D0 \uB2FF\uC9C0 \uC54A\uB294\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADC0\uC5FD\uB124\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uD45C\uC815 \uBD10. \uC5C4\uCCAD \uC2E0\uB0AC\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "A\uAC00 \uC0AC\uC9C4 \uC55E\uC5D0\uC11C \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC544\uB294 \uC560\uC57C?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uBAB0\uB77C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uBAA8\uB974\uB294\uB370."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uD55C\uCC38 \uB3D9\uC548 \uC0AC\uC9C4\uC5D0\uC11C \uB208\uC744
      \uB5BC\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
