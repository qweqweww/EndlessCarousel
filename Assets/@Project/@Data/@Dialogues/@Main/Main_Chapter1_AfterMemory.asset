  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_AfterMemory
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uACF5\uC5F0\uC7A5\uC740 \uC544\uAE4C\uC640 \uB611\uAC19\uC774 \uC870\uC6A9\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "A. \uAD1C\uCC2E\uC544?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uAD1C\uCC2E\uC544."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: X
    text: "\uBC29\uAE08\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uB9D0\uD558\uAE30 \uC2EB\uC5B4."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uADF8\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C\uB3D9\uC548 \uC544\uBB34\uB3C4 \uB9D0\uC744 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC774\uC0C1\uD558\uB124."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: X
    text: "\uBB50\uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC544\uBB34\uB3C4 \uC5C6\uC796\uC544."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC2EC\uC0AC\uC704\uC6D0\uB3C4 \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uC810\uC218\uB3C4 \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uB808\uC2A8\uBE44\uB3C4, \uC7A5\uD559\uAE08\uB3C4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7FC \uBB58 \uC704\uD574\uC11C \uCE58\uC9C0."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uBABB\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "A \uC528."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uCE58\uACE0 \uC2F6\uC73C\uC138\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 78e2c16278be20748807d3facc559a28, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7F0 \uAC70 \uC0DD\uAC01\uD574 \uBCF8 \uC801 \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: 78e2c16278be20748807d3facc559a28, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC B\uB294? \uB10C \uD558\uACE0 \uC2F6\uC740 \uAC70 \uC788\uC5B4?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\uB294\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB798?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uADF8\uB7F0 \uAC74\u2026 \uC798."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC6C3\uC73C\uBA70 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB0E5 \uCCD0\uB3C4 \uB418\uB294 \uAC74\uAC00."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices:
    - text: "\uCE58\uACE0 \uC2F6\uC73C\uBA74 \uCCD0."
      next: {fileID: 11400000, guid: 4d7fb4bb1f1e9964ca960bab2a0fd920, type: 2}
      choiceId: Chapter1_A_Response_PlayIfYouWant
      recordAsFlag: 1
    - text: "\uAD73\uC774 \uC548 \uCCD0\uB3C4 \uB3FC."
      next: {fileID: 11400000, guid: a08bd836956aecf499d47da4bc86bffb, type: 2}
      choiceId: Chapter1_A_Response_NoNeed
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
