%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_ParkMap
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAD00\uB9AC\uC2E4 \uBCBD\uC5D0 \uB180\uC774\uACF5\uC6D0 \uB3C4\uBA74\uC774
      \uBD99\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC911\uC559 \uAD11\uC7A5\uACFC \uD68C\uC804\uBAA9\uB9C8, \uC815\uBB38\uC740
      \uC778\uC1C4\uB41C \uC120\uC73C\uB85C \uBC18\uB4EF\uD558\uAC8C \uADF8\uB824\uC838
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB7F0\uB370 \uB098\uBA38\uC9C0 \uAD6C\uC5ED\uC740 \uB2EC\uB790\uB2E4.
      \uC190\uC73C\uB85C \uB367\uADF8\uB9B0 \uAC83\uCC98\uB7FC, \uC120\uC758 \uAD75\uAE30\uC640
      \uC0C9\uC774 \uC81C\uAC01\uAC01\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4, \uC774\uAC70 \uBD10. \uACF5\uC5F0\uC7A5, \uC544\uCF00\uC774\uB4DC,
      \uD37C\uB808\uC774\uB4DC \uAC70\uB9AC, \uB808\uC2A4\uD1A0\uB791."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E4 \uB098\uC911\uC5D0 \uADF8\uB824 \uB123\uC740 \uAC83 \uAC19\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "\uAD6C\uC5ED\uB9C8\uB2E4 \uC791\uC740 \uC22B\uC790\uAC00 \uD558\uB098\uC529
      \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uACF5\uC5F0\uC7A5 \uC606\uC5D0 '1'. \uC544\uCF00\uC774\uB4DC \uC606\uC5D0
      '2'. \uD37C\uB808\uC774\uB4DC \uAC70\uB9AC \uC606\uC5D0 '3'. \uB808\uC2A4\uD1A0\uB791
      \uC606\uC5D0 '4'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u20261."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uC785\uC7A5 \uC7A5\uBD80\uB791 \uAC19\uC740 \uC21C\uC11C\uC608\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uC774 \uC7A5\uC18C\uB4E4\uC774, \uC6B0\uB9AC\uAC00 \uB4E4\uC5B4\uC624\uACE0
      \uB098\uC11C \uC0DD\uACBC\uB2E4\uB294 \uAC70\uC57C?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6B0\uB9AC\uAC00 \uAC00\uC838\uC628 \uAC70\uB124. \uAC01\uC790."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uACF5\uC5F0\uC7A5 \uAD6C\uC5ED\uC744 \uC624\uB798 \uBCF4\uC558\uB2E4.
      \uC810\uC218\uD310 \uC5C6\uB294 \uBB34\uB300\uAC00 \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC2EC\uC0AC\uC704\uC6D0\uC11D\uC774 \uC5C6\uC5C8\uC9C0. \uAC70\uAE30."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uC911\uC559 \uAD11\uC7A5\uC774\uB791 \uD68C\uC804\uBAA9\uB9C8\uB294,
      \uCC98\uC74C\uBD80\uD130 \uC788\uC5C8\uB358 \uAC70\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751. \uC6B0\uB9AC \uB2E4 \uAC19\uC774 \uAE6C \uB370. \uADF8\uAC74 \uC778\uC1C4\uB41C
      \uC120\uC774\uC57C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
