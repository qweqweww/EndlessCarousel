%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Table
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uCC3D\uAC00\uC758 2\uC778\uC6A9 \uC2DD\uD0C1. \uC218\uC800\uAC00 \uB450
      \uBC8C \uB193\uC5EC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C\uCABD \uC758\uC790\uC5D0\uB294 \uBC29\uC11D\uC774 \uD558\uB098
      \uB354 \uAE54\uB824 \uC788\uB2E4. \uD0A4\uAC00 \uC791\uC740 \uC0AC\uB78C\uC744
      \uC704\uD55C \uAC83\uCC98\uB7FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC758\uC790\uAC00 \uD558\uB098\uB9CC \uB192\uB124\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBC25 \uBA39\uC744 \uB54C \uC2DD\uD0C1\uC774 \uC548 \uB2FF\uC558\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uB204\uAC00?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC544\uBB34\uB3C4 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBC29\uC11D\uC744 \uD55C \uBC88 \uB20C\uB7EC \uBCF4\uC558\uB2E4.
      \uD479 \uAEBC\uC84C\uB2E4\uAC00, \uCC9C\uCC9C\uD788 \uB2E4\uC2DC \uC62C\uB77C\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC774\uAC70 \uD558\uB098 \uB354 \uAE54\uC544 \uC8FC\uACE0, \uC0DD\uC0C9\uC740
      \uC5C4\uCCAD \uB0C8\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "\uB204\uAC00."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBAB0\uB77C\uB3C4 \uB3FC."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "\uC8FC\uBC29\uC5D0\uC11C \uC5B8\uB2C8\uC758 \uBAA9\uC18C\uB9AC\uAC00 \uB4E4\uB824\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "D! \uC218\uC800 \uB193\uC558\uC73C\uBA74 \uBB3C\uB3C4 \uC880 \uB5A0 \uB194!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB0B4\uAC00 \uC65C!"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB124\uAC00 \uC81C\uC77C \uAC00\uAE5D\uC796\uC544!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uD22C\uB35C\uAC70\uB9AC\uBA70 \uBB3C\uBCD1\uC744 \uC9D1\uC5B4
      \uB4E4\uC5C8\uB2E4. \uCEF5\uC740 \uB450 \uAC1C\uB9CC \uCC44\uC6E0\uB2E4. \uADF8\uB7EC\uB2E4
      \uBA48\uCE6B\uD558\uACE0, \uB098\uBA38\uC9C0 \uCEF5\uB3C4 \uC804\uBD80 \uCC44\uC6E0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
