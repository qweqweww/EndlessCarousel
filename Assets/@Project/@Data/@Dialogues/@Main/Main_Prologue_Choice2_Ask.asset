  lines:
  - speakerName: X
    text: "\uADF8\uB7F0\uB370, \uC774\uB984\uAE4C\uC9C0 \uAF2D \uB9D0\uD574\uC57C
      \uD558\uB098\uC694?"
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC5B4..."
    portrait: {fileID: 21300000, guid: 3239e825068e553449dade0b3ea760df, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC2EB\uC73C\uBA74 \uAD73\uC774 \uB9D0 \uC548 \uD558\uC154\uB3C4 \uB3FC\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB124. \uAF2D \uBCF8\uBA85\uC77C \uD544\uC694\uB3C4 \uC5C6\uACE0\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC800\uD76C\uAC00 \uBD80\uB97C \uC218 \uC788\uB294 \uC774\uB984\uB9CC
      \uD558\uB098 \uC54C\uB824\uC8FC\uC2DC\uBA74 \uB3FC\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices:
    - text: "\uC7A5\uB09C\uC2A4\uB7EC\uC6B4 \uAC00\uBA85\uC744 \uB304\uB2E4."
      next: {fileID: 11400000, guid: 2bf12e4f45381e24b98fbe42c47c0555, type: 2}
      choiceId: Prologue_Name_Joke
      recordAsFlag: 1
    - text: "\uADF8\uB7F4\uB4EF\uD55C \uAC00\uBA85\uC744 \uB304\uB2E4."
      next: {fileID: 11400000, guid: 6c4424c94555c5c439b6a0ca2478b5c4, type: 2}
      choiceId: Prologue_Name_Fake
      recordAsFlag: 1
    - text: "\uACB0\uAD6D \uBCF8\uBA85\uC744 \uBC1D\uD78C\uB2E4."
      next: {fileID: 11400000, guid: bdf4be3fe7a579047b492b882eb41742, type: 2}
      choiceId: Prologue_Name_Real
      recordAsFlag: 1
