  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_XOrigin_Merge
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: C
    text: "\uADFC\uB370 \uCD9C\uC0DD\uC9C0\uAC00 \uB180\uC774\uACF5\uC6D0\uC778 \uC0AC\uB78C\uC740
      \uCC98\uC74C \uBCF4\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC57C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8, \uC9C4\uC9DC\uB85C. \uBA4B\uC788\uC796\uC544. \uC0DD\uC77C\uB3C4
      \uC6B0\uB9AC\uAC00 \uB2E4 \uC54C\uACE0."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC74 \uADF8\uB807\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\uB124\uAC00 \uC5C6\uC5C8\uB358 \uAC74 \uACFC\uAC70\uACE0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uC9C0\uAE08\uC740 \uC788\uC796\uC544."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uADF8\uB807\uAC8C\uB9CC \uB9D0\uD558\uACE0, \uC7A5\uBD80\uB97C
      \uB36E\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB36E\uC778 \uC7A5\uBD80\uB97C \uBCF4\uC558\uB2E4. \uB2E4\uC12F
      \uBC88\uC9F8 \uC904\uC5D0 \uBB34\uC5C7\uC774 \uC801\uD600 \uC788\uC5C8\uB294\uC9C0\uB294
      \uC774\uBBF8 \uC54C\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC \uC7A5\uBD80\uB97C \uB36E\uC740 \uAC83\uC740 A\uC600\uB2E4.
      \uADF8\uB9AC\uACE0 X\uB294 \uADF8\uAC83\uC744 \uAE30\uC5B5\uD560 \uAC83\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uC544\uC9C1 \uC548 \uBCF8 \uB370\uAC00 \uD558\uB098 \uB0A8\uC558\uC5B4\uC694.
      \uC800\uCABD \uBB38."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "\uBCF5\uB3C4 \uB05D, \uAD00\uB9AC\uC2E4 \uB9DE\uC740\uD3B8\uC5D0 \uB179\uC0C9
      \uD45C\uC2DC\uB4F1\uC774 \uCF1C\uC9C4 \uBB38\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
