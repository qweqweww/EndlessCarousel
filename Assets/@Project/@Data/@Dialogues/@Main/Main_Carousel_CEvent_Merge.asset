  lines:
  - speakerName: C
    text: "\uBB54\uAC00 \uC775\uC219\uD55C \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uB9C9\uC0C1 \uB5A0\uC62C\uB9AC\uB824 \uD558\uBA74 \uC544\uBB34\uAC83\uB3C4
      \uC548 \uB098\uC624\uB294\uB370."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC774\uC0C1\uD558\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uAD1C\uCC2E\uC544?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uBD88\uD3B8\uD55C \uAC74 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC624\uD788\uB824 \uBC18\uB300\uC778 \uAC83 \uAC19\uAE30\uB3C4 \uD558\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uBC18\uB300?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC544\uB0D0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098\uC911\uC5D0 \uC0DD\uAC01\uB098\uBA74 \uB9D0\uD574\uC904\uAC8C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
