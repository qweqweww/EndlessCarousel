  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_RankBoard
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC8C\uC2DC\uD310\uC5D0 \uC21C\uC704\uD45C\uAC00 \uBD99\uC5B4 \uC788\uB2E4.
      '\uC804\uAD6D \uD559\uC0DD \uD53C\uC544\uB178 \uCF69\uCFE0\uB974 \u2014 \uBCF8\uC120
      \uACB0\uACFC'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "1\uC704 \uCE78\uB9CC \uC774\uB984\uC774 \uBE44\uC5B4 \uC788\uB2E4. 2\uC704\uBD80\uD130
      \uC544\uB798\uB294 \uC804\uBD80 \uC9C0\uC6CC\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "1\uB4F1\uB9CC \uBE44\uC5B4 \uC788\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC18\uB300 \uC544\uB2C8\uC57C? \uBCF4\uD1B5 \uAF34\uB4F1\uC744 \uC9C0\uC6B0\uC9C0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "1\uB4F1\uB9CC \uB0A8\uB294 \uAC70\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC774\uB7F0 \uB370\uC11C\uB294. 1\uB4F1\uB9CC \uB0A8\uC544."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uB098\uBA38\uC9C0\uB294 \uC544\uBB34\uB3C4 \uAE30\uC5B5 \uC548 \uD574."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC21C\uC704\uD45C\uC758 \uB450 \uBC88\uC9F8 \uC904\uC744 \uC190\uAC00\uB77D\uC73C\uB85C
      \uC9DA\uC5C8\uB2E4\uAC00 \uB5D0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
