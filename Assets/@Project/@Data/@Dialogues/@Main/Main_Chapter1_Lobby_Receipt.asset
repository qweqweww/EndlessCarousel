  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_Receipt
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBD84\uC2E4\uBB3C \uBCF4\uAD00\uD568. \uC5F4\uB9B0 \uC11C\uB78D \uC548\uC5D0
      \uC811\uD78C \uC885\uC774 \uBA87 \uC7A5\uC774 \uB4E4\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC804\uBD80 \uAC19\uC740 \uD53C\uC544\uB178 \uD559\uC6D0\uC758 \uC601\uC218\uC99D\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB808\uC2A8\uBE44 \u2014 \uBBF8\uB0A9\uBD84 \uD3EC\uD568'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uBBF8\uB0A9\uBD84\u2026"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uB3C8 \uC598\uAE30\uB294 \uB180\uC774\uACF5\uC6D0\uC5D0\uC11C \uBCF4\uACE0
      \uC2F6\uC9C0 \uC54A\uC740\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uB0B4\uB824\uB194."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: X
    text: A?
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uAC70. \uADF8\uB0E5 \uB0B4\uB824\uB194."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: 
    text: "X\uB294 \uC885\uC774\uB97C \uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC11C\uB78D\uC774 \uB2EB\uD788\uB294 \uC18C\uB9AC\uAC00 \uB0A0
      \uB54C\uAE4C\uC9C0 \uADF8\uCABD\uC744 \uBCF4\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
