%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_ParadeFloat
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB9D0 \uBAA8\uC591 \uC7A5\uC2DD\uC744 \uC5B9\uC740 \uD37C\uB808\uC774\uB4DC
      \uD50C\uB85C\uD2B8. \uAE43\uBC1C\uB3C4, \uBCC4 \uC7A5\uC2DD\uB3C4 \uC804\uBD80
      \uB2EC\uB824 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC14\uD034 \uC55E\uC5D0\uB294 \uBC1B\uCE68\uBAA9\uC774 \uB07C\uC6CC\uC838
      \uC788\uC5C8\uB2E4. \uD55C \uBC88\uB3C4 \uC6C0\uC9C1\uC778 \uC801 \uC5C6\uB294
      \uAC83\uCC98\uB7FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC774\uAC70 \uD37C\uB808\uC774\uB4DC \uCC28\uC796\uC544. \uC65C \uC5EC\uAE30
      \uC11C \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uCD9C\uBC1C \uC2DC\uAC04\uC744 \uAE30\uB2E4\uB9AC\uB294 \uAC78\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uAE4C \uBC29\uC1A1\uC5D0\uC11C\uB3C4 '\uC7A0\uC2DC \uD6C4 \uCD9C\uBC1C\uD569\uB2C8\uB2E4'\uB77C\uACE0
      \uD588\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8 '\uC7A0\uC2DC \uD6C4'\uAC00 \uACC4\uC18D \uC7A0\uC2DC \uD6C4\uC778\uAC00
      \uBD10."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uD50C\uB85C\uD2B8 \uC606\uC744 \uD55C \uBC14\uD034 \uB3CC\uC558\uB2E4.
      \uBC14\uD034\uC5D0\uB294 \uD759 \uD55C \uC810 \uBB3B\uC5B4 \uC788\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC6C0\uC9C1\uC774\uB824\uACE0 \uB9CC\uB4E0 \uAC74\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uAE43\uBC1C\uB3C4 \uB2EC\uACE0, \uBCC4\uB3C4 \uB2EC\uACE0, \uB2E4 \uC900\uBE44\uB3FC
      \uC788\uB294\uB370. \uACC4\uC18D \uC5EC\uAE30 \uC11C \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uCC28 \uC598\uAE30 \uB9DE\uC9C0?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751? \uC751. \uCC28 \uC598\uAE30\uC9C0."
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC6C3\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uBC14\uD034 \uC55E\uC758
      \uBC1B\uCE68\uBAA9\uC744 \uBC1C\uB05D\uC73C\uB85C \uD55C \uBC88 \uAC74\uB4DC\uB824
      \uBCF4\uC558\uB2E4. \uBC1B\uCE68\uBAA9\uC740 \uAFC8\uCA4D\uB3C4 \uD558\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
