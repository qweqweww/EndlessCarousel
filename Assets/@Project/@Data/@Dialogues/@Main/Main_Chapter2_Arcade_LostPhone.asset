%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_LostPhone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uCE74\uC6B4\uD130 \uC606 \uBD84\uC2E4\uBB3C \uBC14\uAD6C\uB2C8. \uC7A5\uAC11
      \uD55C \uC9DD, \uC6B0\uC0B0, \uADF8\uB9AC\uACE0 \uD654\uBA74\uC5D0 \uAE08\uC774
      \uAC04 \uC624\uB798\uB41C \uD734\uB300\uD3F0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC774\uAC83\uB3C4 \uD734\uB300\uD3F0\uC774\uC5D0\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uC5C4\uCCAD \uC61B\uB0A0 \uAC70\uB124. \uC774\uAC78\uB85C \uC778\uD130\uB137\uB3C4
      \uD558\uACE0, \uC0AC\uC9C4\uB3C4 \uCC0D\uACE0, \uCE5C\uAD6C\uB4E4\uC774\uB791
      \uB2E8\uCCB4\uB85C \uCC44\uD305\uB3C4 \uD558\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uB2E8\uCCB4\uB85C\u2026 \uCC44\uD305\uC774\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uBC18 \uC560\uB4E4 \uB2E4 \uAC19\uC774 \uC788\uB294 \uBC29 \uAC19\uC740
      \uAC70. \uBC24\uC0C8 \uB5A0\uB4E4\uACE0 \uADF8\uB798."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7EC\uB2E4 \uBAA8\uB974\uB294 \uC0AC\uB78C\uC774\uB791\uB3C4 \uC598\uAE30\uD558\uACE0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uBAA8\uB974\uB294 \uC0AC\uB78C\uC774\uB791\uC694? \uC778\uD130\uB137\uC73C\uB85C\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uAC19\uC740 \uAC00\uC218 \uC88B\uC544\uD558\uB294 \uC0AC\uB78C\uB4E4\uB07C\uB9AC\uB77C\uB4E0\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uC138\uC0C1\uC5D0."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uCE5C\uAD6C \uC9D1 \uAC00\uC11C \uC790\uBA74\uC11C \uBC24\uC0C8 \uADF8\uB7EC\uAE30\uB3C4
      \uD558\uACE0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uCE5C\uAD6C \uC9D1\uC5D0\uC11C\u2026 \uC790\uB3C4 \uB3FC\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC83\uB3C4 \uBAB0\uB77C?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uBAB0\uB790\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uAE08 \uAC04 \uD734\uB300\uD3F0\uC744 \uB450 \uC190\uC73C\uB85C
      \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCF1C\uC9C0\uC9C0 \uC54A\uB294 \uAE4C\uB9CC \uD654\uBA74\uC5D0, B\uC758
      \uC5BC\uAD74\uC774 \uBE44\uCCE4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7F0\uB370\u2026 \uC774\uB7F0 \uAC70, \uBCF8 \uC801\uC740 \uC788\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
