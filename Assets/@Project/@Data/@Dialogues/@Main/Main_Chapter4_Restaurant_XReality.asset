%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_XReality
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "X\uB294 \uC21F\uAC00\uB77D\uC744 \uB4E0 \uCC44\uB85C \uC2DD\uD0C1\uC744
      \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBAA8\uB450\uAC00 \uBB34\uC5B8\uAC00\uB97C \uAC00\uC9C0\uACE0 \uC774\uACF3\uC5D0
      \uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uC5D0\uAC8C\uB294 \uD53C\uC544\uB178\uC640 \uBB34\uB300, 1\uB4F1\uC774\uC5B4\uC57C
      \uD588\uB358 \uC9D1\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uC5D0\uAC8C\uB294 \uAE34 \uC2DD\uD0C1\uACFC \uACF5\uB3D9\uCCB4, \uCC98\uC74C\uC73C\uB85C
      \uC0DD\uAE34 \uCE5C\uAD6C\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uC5D0\uAC8C\uB294 \uD2B8\uB799\uACFC \uBCD1\uC6D0, \uD3B8\uC758\uC810
      \uACC4\uC0B0\uB300\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uC5D0\uAC8C\uB294 \uC624\uB9AC \uC55E\uCE58\uB9C8\uC640 \uBA48\uCD98
      \uC2DC\uACC4, \uACC4\uB780 \uB450 \uAC1C\uC9DC\uB9AC \uC800\uB141\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB3CC\uC544\uAC00\uAE30 \uD798\uB4E0 \uACF3\uC77C\uC9C0\uB3C4 \uBAB0\uB790\uB2E4.
      \uC88B\uC740 \uACF3\uC774 \uC544\uB2D0\uC9C0\uB3C4 \uBAB0\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4 \uBD84\uBA85\uD788, \uADF8\uB4E4\uC774 \uC0B4\uC558\uB358
      \uACF3\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uD55C\uD14C\uB3C4 \uB3CC\uC544\uAC08 \uACF3\uC774 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB3C4. C\uB3C4. D\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uADF8\uB7F0\uB370 \uB098\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB5A0\uC62C\uB824 \uBCF4\uB824 \uD588\uB2E4. \uC9D1. \uC2DD\uD0C1. \uB204\uAD70\uAC00
      \uCC28\uB824 \uC900 \uC800\uB141."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC774\uBC88\uC5D0\uB3C4, \uC544\uBB34\uAC83\uB3C4 \uB5A0\uC624\uB974\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD750\uB9BF\uD55C \uAC83\uC870\uCC28 \uC5C6\uC5C8\uB2E4. \uC78A\uC740
      \uAC83\uC774 \uC544\uB2C8\uB77C, \uCC98\uC74C\uBD80\uD130 \uBE44\uC5B4 \uC788\uB294
      \uAC83\uCC98\uB7FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB0B4 \uD604\uC2E4\uC740\u2026 \uC5B4\uB514\uC5D0 \uC788\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "X? \uC548 \uBA39\uC5B4? \uC2DD\uB294\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC751. \uBA39\uC744\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uAE40\uCE58\uBCF6\uC74C\uBC25\uC744 \uD55C \uC21F\uAC08 \uB5A0\uBA39\uC5C8\uB2E4.
      \uC9F0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uB9DB\uC744 \uAE30\uC5B5\uD560 \uC218 \uC788\uC744\uC9C0, X\uB294
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
