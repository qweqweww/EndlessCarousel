  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_C_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBCD1\uC6D0 \uBCF5\uB3C4. C\uB294 \uB09C\uAC04\uC744 \uC7A1\uACE0 \uAC78\uC5C8\uB2E4.
      \uC5F4\uB450 \uAC78\uC74C\uB9C8\uB2E4 \uD55C \uBC88\uC529 \uC26C\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB9AC\uB294 \uC5EC\uC804\uD788 \uAE08\uBC29 \uBB34\uAC70\uC6CC\uC84C\uB2E4.
      \uAE30\uC801 \uAC19\uC740 \uAC74 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBCF5\uB3C4 \uB05D \uAC8C\uC2DC\uD310\uC5D0 \uC885\uC774 \uD55C \uC7A5\uC774
      \uBD99\uC5B4 \uC788\uC5C8\uB2E4. '\uC9C4\uB85C \uC0C1\uB2F4 \u2014 \uB9E4\uC8FC
      \uC218\uC694\uC77C'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC0C1\uB2F4\uC774\uB77C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC885\uC774\uB97C \uD55C\uCC38 \uBCF4\uB2E4\uAC00, \uD734\uB300\uD3F0\uC73C\uB85C
      \uC0AC\uC9C4\uC744 \uCC0D\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC08\uC9C0 \uC548 \uAC08\uC9C0\uB294 \uC544\uC9C1 \uBAB0\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBB50, \uAC00\uC11C \uC0DD\uAC01\uD558\uC9C0."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB2E4\uC2DC \uAC78\uC5C8\uB2E4. \uB2E4\uC74C \uC5F4\uB450 \uAC78\uC74C
      \uCABD\uC73C\uB85C."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
