--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_AfterMemory3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uB294 \uC9C4\uC5F4\uB300 \uC720\uB9AC\uC5D0 \uC190\uC744 \uB304 \uCC44
      \uC11C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC57C. \uC5BC\uAD74 \uC65C \uADF8\uB798."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124? \uC544, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC5D0\uC694."
    portrait: {fileID: 21300000, guid: 3239e825068e553449dade0b3ea760df, type: 3}
    choices: []
  - speakerName: B
    text: "\uC870\uAE08\u2026 \uC5B4\uC9C0\uB7EC\uC6E0\uC5B4\uC694. \uBD88\uBE5B\uC774
      \uB9CE\uC544\uC11C\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: D
    text: "\uC549\uC744\uB798? \uC74C\uB8CC\uC218 \uBF51\uC544 \uC904\uAE4C?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uAD1C\uCC2E\uC544\uC694. \uACE0\uB9C8\uC6CC\uC694, D \uC528."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC6C3\uC5C8\uB2E4. \uD558\uC9C0\uB9CC \uC544\uAE4C\uCC98\uB7FC
      C\uC758 \uC18C\uB9E4\uB97C \uC7A1\uC9C0\uB294 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "B, \uC544\uAE4C \uADF8 \uD0A4\uB9C1 \uB9D0\uC778\uB370. \uC6B0\uB9AC \uB2E4\uC12F\uC774
      \uD558\uB098\uC529 \uD558\uBA74 \uB418\uC796\uC544. \uB458\uC774 \uD558\uB098\uC529
      \uB9D0\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uB2E4\uC12F\uC774\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uC548 \uB420 \uAC70 \uC5C6\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7EC\uB124\uC694. \uC548 \uB420 \uAC74\u2026 \uC5C6\uB124\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "\uADF8\uB54C, \uBD80\uC2A4 \uC548\uCABD\uC5D0\uC11C \uAE30\uACC4 \uB3CC\uC544\uAC00\uB294
      \uC18C\uB9AC\uAC00 \uB4E4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uCC0D\uC9C0 \uC54A\uC740 \uC2A4\uD2F0\uCEE4 \uC0AC\uC9C4\uAE30\uAC00,
      \uC0AC\uC9C4 \uD55C \uC7A5\uC744 \uBC49\uC5B4\uB0C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4? \uC800\uAC70 \uC65C \uD63C\uC790 \uB098\uC640?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
