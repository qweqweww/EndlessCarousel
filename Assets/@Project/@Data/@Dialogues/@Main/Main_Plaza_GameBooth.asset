  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Plaza_GameBooth
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAD11\uC7A5 \uD55C\uCABD\uC5D0 \uC791\uC740 \uAC8C\uC784 \uBD80\uC2A4\uAC00
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC810\uC218\uD310 \uC704\uC5D0\uB294 '\uC624\uB298\uC758 \uCD5C\uACE0
      \uC810\uC218'\uB77C\uB294 \uBB38\uAD6C\uAC00 \uC801\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC774\uB7F0 \uAC83\uB3C4 \uC788\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uD574\uBCFC\uB798?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC65C \uB098\uD55C\uD14C \uBB3C\uC5B4."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uC81C\uC77C \uBA3C\uC800 \uBCF4\uACE0 \uC788\uC5C8\uC796\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uBD24\uB2E4\uACE0 \uD558\uACE0 \uC2F6\uC740 \uAC74 \uC544\uB2C8\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: D
    text: "\uB10C \uD560\uB798?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\uC548 \uD574."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uB798? \uC2EB\uC73C\uBA74 \uB9D0\uACE0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC810\uC218\uD310\uC744 \uC7A0\uC2DC \uBC14\uB77C\uBCF4\uB2E4\uAC00
      \uC2DC\uC120\uC744 \uB3CC\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 11400000, guid: 676ed5e62e76260409f29236d96ecbe0, type: 2}
  skipNextIfFlag: Prologue_PlazaComplete
