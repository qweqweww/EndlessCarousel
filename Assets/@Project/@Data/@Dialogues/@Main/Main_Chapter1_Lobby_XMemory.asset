--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_XMemory
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB2E4\uB4E4 \uC7A0\uC2DC \uB85C\uBE44 \uC758\uC790\uC5D0 \uC549\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uBC29\uAE08 \uB4E4\uC740 \uC774\uC57C\uAE30\uB97C \uB5A0\uC62C\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uC758 \uAE30\uC5B5\uC5D0\uB294 \uC7A5\uC18C\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC70\uC2E4\uC774 \uC788\uC5C8\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD559\uC6D0\uC774 \uC788\uC5C8\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB300\uD68C\uC7A5\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC774\uB984\uC744 \uBD80\uB974\uB294 \uC0AC\uB78C\uC774 \uC788\uC5C8\uACE0,
      \uB3C8 \uC774\uC57C\uAE30\uB97C \uD558\uB294 \uBAA9\uC18C\uB9AC\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB098\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB5A0\uC62C\uB824\uBCF4\uB824 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC9D1. \uD559\uAD50. \uAC00\uC871. \uC544\uBB34 \uB2E8\uC5B4\uB098 \uBD99\uC7A1\uC544
      \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD558\uC9C0\uB9CC \uC544\uBB34\uAC83\uB3C4 \uC774\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "X? \uBB34\uC2A8 \uC0DD\uAC01\uD574?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC544\uBB34\uAC83\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC9C4\uC9DC\uB85C, \uC544\uBB34\uAC83\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB54C, \uC7A0\uACA8 \uC788\uB358 \uC548\uCABD \uBB38\uC774 \uC18C\uB9AC
      \uC5C6\uC774 \uC5F4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uBB38\uC774\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: 
    text: "\uBB38 \uB108\uBA38\uB85C \uBB34\uB300 \uC870\uBA85\uC774 \uC0C8\uC5B4
      \uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB4E4\uC5B4\uC624\uB77C\uB294 \uAC70\uB124. \uCE5C\uC808\uD558\uAE30\uB3C4
      \uD558\uC9C0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uAC00\uC790."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
