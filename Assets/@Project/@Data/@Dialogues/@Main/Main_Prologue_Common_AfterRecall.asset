  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Prologue_Common_AfterRecall
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: X
    text: "\u2026\u2026\uC800\uB3C4 \uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uB2E4 \uBE44\uC2B7\uD55C \uAC70\uB124\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7F0 \uAC83 \uAC19\uB124\uC694."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC... \uC774\uC81C \uC5B4\uB5BB\uAC8C \uD560\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC8FC\uBCC0\uBD80\uD130 \uB458\uB7EC\uBD10\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uACC4\uC18D \uC5EC\uAE30 \uC788\uB294\uB2E4\uACE0 \uB2F5\uC774 \uB098\uC624\uC9C4
      \uC54A\uC744 \uAC83 \uAC19\uACE0\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uB3D9\uC758\uD569\uB2C8\uB2E4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC800\uB3C4\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB2E4 \uAC19\uC774 \uC6C0\uC9C1\uC774\uBA74 \uC870\uAE08 \uB290\uB9AC\uAE34
      \uD558\uACA0\uC9C0\uB9CC\u2014"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC0C1\uAD00\uC5C6\uC796\uC544\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB124?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE30\uAC00 \uC5B4\uB518\uC9C0\uB3C4 \uBAA8\uB974\uB294\uB370 \uAD73\uC774
      \uD769\uC5B4\uC9C8 \uD544\uC694 \uC788\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC11C\uB85C \uCC3E\uB294 \uAC8C \uB354 \uADC0\uCC2E\uC796\uC544\uC694."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC83\uB3C4 \uADF8\uB807\uB124\uC694."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC5B4... \uC800\uB3C4 \uAC19\uC774 \uC788\uB294 \uAC8C \uC88B\uC744 \uAC83
      \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7FC \uAC19\uC774 \uAC00\uC8E0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB2E4\uB4E4 \uBE44\uC2B7\uD55C \uCC98\uC9C0\uC778\uB370\u2026\u2026 \uB9D0
      \uD3B8\uD558\uAC8C \uD560\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC8C \uD3B8\uD558\uACA0\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC5B4... \uC800\uB294 \uC774\uAC8C \uD3B8\uD574\uC11C\uC694."
    portrait: {fileID: 21300000, guid: a6c52585ce5407947bdd62f5f1dd0d5c, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB798. B\uB294 \uD3B8\uD55C \uB300\uB85C \uD574."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uADF8\uB798."
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
