  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Basket
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC8FC\uBC29 \uC785\uAD6C \uC606\uC5D0 \uC7A5\uBC14\uAD6C\uB2C8 \uD558\uB098\uAC00
      \uB193\uC5EC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC548\uC5D0\uB294 \uB300\uD30C \uD55C \uB2E8, \uACC4\uB780 \uD55C \uD310,
      \uC2A4\uD338 \uD55C \uD1B5. \uC601\uC218\uC99D\uC774 \uAF42\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC624, \uC7A5 \uBD10 \uC654\uB098 \uBCF4\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uACC4\uB780\uC774 \uB9CE\uB124\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uACC4\uB780 \uB450 \uAC1C\uC529 \uC4F0\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uC601\uC218\uC99D\uC744 \uBE7C \uBCF4\uC558\uB2E4. \uB0A0\uC9DC\uAC00
      \uC801\uD600 \uC788\uC5B4\uC57C \uD560 \uC790\uB9AC\uAC00 \uBC88\uC838\uC11C
      \uC77D\uC744 \uC218 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC2A4\uD338 \uBE44\uC2F8\uB2E4\uACE0 \uB9E8\uB0A0 \uBC18
      \uD1B5\uB9CC \uC37C\uC73C\uBA74\uC11C."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: A
    text: "\uC624\uB298\uC740 \uD55C \uD1B5\uC774\uB124."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uB7EC\uAC8C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
