%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Memory3_D
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uADF8\uB0A0 \uC624\uD6C4. D\uB294 \uC5F4\uC5EC\uC12F \uC0B4\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uD604\uAD00\uC5D0\uC11C \uC2E0\uBC1C\uC744 \uC2E0\uACE0
      \uC788\uC5C8\uB2E4. \uD3C9\uC18C\uBCF4\uB2E4 \uC624\uB798 \uAC78\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC800\uB141 \uBB50 \uBA39\uACE0 \uC2F6\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uAE40\uBCF6."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB610?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uACC4\uB780 \uB450 \uAC1C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC54C\uC558\uC5B4. \uC624\uB294 \uAE38\uC5D0 \uC2A4\uD338 \uC0AC \uC62C\uAC8C.
      \uC624\uB298\uC740 \uD55C \uD1B5 \uB2E4 \uB123\uC5B4 \uC904\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC6EC\uC77C\uC774\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624\uB298\uC740 \uADF8\uB7F0 \uB0A0\uC774\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uBB34\uC2A8 \uB0A0\uC778\uB370."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\u2026\u2026\uB05D\uB0B4\uB294 \uB0A0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uC6C3\uC5C8\uB2E4. \uC870\uAE08 \uAE34\uC7A5\uD55C
      \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "7\uC2DC\uAE4C\uC9C0 \uC62C\uAC8C. \uC219\uC81C \uD558\uACE0 \uC788\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC751. \uC798 \uC598\uAE30\uD574."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uAC71\uC815 \uB9C8. \uC5B8\uB2C8 \uBB34\uC12D\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB38\uC774 \uB2EB\uD614\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uC219\uC81C\uB97C \uD588\uB2E4. \uD558\uB2E4 \uB9D0\uACE0 \uD734\uB300\uD3F0
      \uAC8C\uC784\uC744 \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "6\uC2DC. \uBC25\uC1A5\uC5D0 \uBC25\uC744 \uC548\uCCE4\uB2E4. \uC5B8\uB2C8\uAC00
      \uC2DC\uD0A4\uC9C0 \uC54A\uC558\uB294\uB370\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "7\uC2DC. \uC2DD\uD0C1\uC5D0 \uC218\uC800\uB97C \uB450 \uBC8C \uB193\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "7\uC2DC 20\uBD84."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB610 \uB2A6\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "7\uC2DC 40\uBD84. \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0C8\uB2E4. '\uC5B8\uC81C
      \uC640. \uBC30\uACE0\uD30C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2F5\uC774 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "8\uC2DC. \uC804\uD654\uB97C \uAC78\uC5C8\uB2E4. \uC804\uC6D0\uC774 \uAEBC\uC838
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBC30\uD130\uB9AC \uB098\uAC14\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "9\uC2DC. \uBC25\uC1A5\uC758 \uBCF4\uC628 \uBD88\uBE5B\uB9CC \uCF1C\uC838
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "10\uC2DC. D\uB294 \uD604\uAD00 \uC55E\uC5D0 \uC549\uC544 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD734\uB300\uD3F0\uC774 \uC6B8\uB838\uB2E4. \uBAA8\uB974\uB294 \uBC88\uD638\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uACBD\uCC30"
    text: "D \uC528 \uB418\uC2DC\uC8E0. \uC5B8\uB2C8\uBD84 \uC77C\uB85C \uC5F0\uB77D\uB4DC\uB838\uC2B5\uB2C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uB4A4\uC758 \uB9D0\uC740 \uC798 \uB4E4\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB4E4\uB9B0 \uAC74 \uBA87 \uB2E8\uC5B4\uBFD0\uC774\uC5C8\uB2E4. \uB0A8\uC790\uCE5C\uAD6C.
      \uB2E4\uD23C. \uBCD1\uC6D0. \uB2A6\uC5C8\uB2E4\uB294 \uB9D0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC2DD\uD0C1 \uC704\uC5D0\uB294 \uC218\uC800 \uB450 \uBC8C\uC774 \uADF8\uB300\uB85C
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE40\uCE58\uBCF6\uC74C\uBC25\uC740 \uB9CC\uB4E4\uC5B4\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBA70\uCE60 \uB4A4, \uC5B8\uB2C8\uC758 \uCE5C\uAD6C\uAC00 \uC7A5\uB840\uC2DD\uC7A5
      \uAD6C\uC11D\uC5D0\uC11C \uB9D0\uD574 \uC8FC\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8\uC758 \uCE5C\uAD6C"
    text: "\uADF8 \uC0AC\uB78C\uC774 \uACC4\uC18D \uADF8\uB7AC\uB300. \uB3D9\uC0DD
      \uC880 \uADF8\uB9CC \uCC59\uAE30\uB77C\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8\uC758 \uCE5C\uAD6C"
    text: "\uC5B8\uB2C8\uB294 \uC2EB\uB2E4\uACE0 \uD588\uACE0. \uADF8\uB798\uC11C
      \uB05D\uB0B4\uC790\uACE0 \uD55C \uAC70\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uACE0\uAC1C\uB97C \uB044\uB355\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uC544\uC8FC \uC870\uC6A9\uD788, \uD63C\uC790 \uACB0\uB860\uC744
      \uB0B4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB098 \uB54C\uBB38\uC774\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC0DD\uAC01\uC740 \uADF8\uB0A0 \uC774\uD6C4\uB85C D \uC548\uC5D0\uC11C
      \uB0B4\uB824\uB193\uC744 \uC218 \uC5C6\uB294 \uAC83\uC774 \uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
