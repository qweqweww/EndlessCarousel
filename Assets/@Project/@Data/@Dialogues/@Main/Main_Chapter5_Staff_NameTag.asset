  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_NameTag
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAD00\uB9AC\uC2E4 \uC11C\uB78D \uC548\uC5D0 \uBA85\uCC30\uC774 \uD558\uB098
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD50C\uB77C\uC2A4\uD2F1 \uD14C\uB450\uB9AC \uC548, \uC774\uB984 \uCE78\uC774
      \uBE44\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBA85\uCC30\uC774\uB124. \uC774\uB984\uC774 \uC548 \uC368 \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uC9C1\uC6D0 \uAC70\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "X\uAC00 \uBA85\uCC30\uC744 \uC9D1\uC5B4 \uB4E4\uC5C8\uB2E4. \uAC00\uBCBC\uC6E0\uB2E4.
      \uC544\uBB34\uAC83\uB3C4 \uC4F0\uC5EC \uC788\uC9C0 \uC54A\uC544\uC11C, \uC624\uD788\uB824
      \uBB34\uC5C7\uC774\uB4E0 \uC4F8 \uC218 \uC788\uC744 \uAC83 \uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "X \uC528, \uAC70\uAE30 X\uB77C\uACE0 \uC4F0\uC2DC\uBA74 \uB418\uACA0\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: X
    text: "X\uB294 \uC774\uB984\uC774\uC57C?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uB124? \uC774\uB984\uC774\uC8E0. \uC800\uD76C\uAC00 \uACC4\uC18D
      \uADF8\uB807\uAC8C \uBD88\uB800\uB294\uB370\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uB9DE\uC544. \uCC98\uC74C\uC5D0 X\uB77C\uACE0 \uD588\uC796\uC544. \uADF8\uB54C\uBD80\uD130
      X\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uCC98\uC74C\uC5D0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uBA85\uCC30\uC744 \uC11C\uB78D\uC5D0 \uB2E4\uC2DC \uB123\uC5C8\uB2E4.
      \uBE48\uCE78\uC778 \uCC44\uB85C."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
