  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_TwoCups
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uCC3D\uAC00 \uC2DD\uD0C1 \uC704\uC5D0 \uCEF5 \uB450 \uAC1C. \uD558\uB098\uB294
      \uB9BD\uC2A4\uD2F1 \uC790\uAD6D\uC774 \uC0B4\uC9DD \uBB3B\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uB3C4 2\uC778\uC11D\uC774\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC774 \uC2DD\uB2F9\uC740 \uB458\uC774 \uC549\uB294 \uC790\uB9AC\uAC00
      \uB9CE\uC740 \uAC83 \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: D
    text: "\uB9BD\uC2A4\uD2F1 \uBC14\uB974\uB294 \uAC70 \uC9C4\uC9DC \uBABB\uD588\uC5B4.
      \uB9E8\uB0A0 \uC090\uC838\uB098\uAC00\uC11C."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: D
    text: "\uCC98\uC74C \uB370\uC774\uD2B8\uD560 \uB54C \uB0B4\uAC00 \uD574 \uC92C\uAC70\uB4E0.
      \uADF8\uAC83\uB3C4 \uC5C9\uB9DD\uC774\uC5C8\uC9C0\uB9CC."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: C
    text: "\uC624, D\uAC00 \uD574 \uC92C\uB2E4\uACE0?"
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B4. \uC5C4\uCCAD \uC6C3\uC5C8\uC5B4. \uB458 \uB2E4."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uCEF5\uC744 \uB4E4\uC5B4 \uB9BD\uC2A4\uD2F1 \uC790\uAD6D\uC744
      \uC5C4\uC9C0\uB85C \uBB38\uC9C8\uB800\uB2E4. \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
