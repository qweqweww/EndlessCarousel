%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Carousel_ControlLog
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC870\uC791\uC2E4 \uACC4\uAE30\uD310 \uC606\uC5D0 \uC6B4\uD589 \uC77C\uC9C0\uAC00
      \uAC78\uB824 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB0A0\uC9DC \uCE78\uC740 \uBE44\uC5B4 \uC788\uACE0, \uC2DC\uAC04\uACFC
      \uC9E7\uC740 \uBA54\uBAA8\uB9CC \uC801\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC6B4\uD589 \uC77C\uC9C0\uB124. \uCC98\uC74C \uC654\uC744 \uB550 \uC2A4\uC704\uCE58\uB9CC
      \uBD24\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB50\uB77C\uACE0 \uC368 \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "'\uCCAB \uBC88\uC9F8 \uD0D1\uC2B9\uAC1D \uD655\uC778. \uD68C\uC804 \uC18D\uB3C4
      \uC720\uC9C0.'"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "'\uB450 \uBC88\uC9F8 \uD0D1\uC2B9\uAC1D \uD655\uC778.' '\uC138 \uBC88\uC9F8.'
      '\uB124 \uBC88\uC9F8.'"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: 
    text: "\uBA54\uBAA8\uB294 \uB124 \uC904\uC774\uC5C8\uB2E4. \uADF8 \uC544\uB798\uB85C\uB294
      \uAC19\uC740 \uBB38\uC7A5\uB9CC \uBC18\uBCF5\uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uD68C\uC804 \uC720\uC9C0. \uD68C\uC804 \uC720\uC9C0. \uD68C\uC804 \uC720\uC9C0.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uB124 \uBC88\uC9F8\uAE4C\uC9C0\uB124."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6B0\uB9AC \uB137\uC774 \uB4E4\uC5B4\uC628 \uC21C\uC11C\uC778\uAC00?
      \uD68C\uC804\uBAA9\uB9C8\uB294 \uCC98\uC74C\uC5D0 \uB2E4 \uAC19\uC774 \uBD24\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "X\uB294?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC12F \uBC88\uC9F8 \uD0D1\uC2B9\uAC1D\uC740 \uC801\uD600 \uC788\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB300\uC2E0 \uD398\uC774\uC9C0 \uADC0\uD241\uC774\uC5D0, \uC5F0\uD544\uB85C
      \uADF8\uC740 \uB4EF\uD55C \uD750\uB9B0 \uC120\uC774 \uD558\uB098 \uC788\uC5C8\uB2E4.
      \uC544\uBB34 \uAE00\uC790\uB3C4 \uC544\uB2CC \uC120."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uD68C\uC804\uBAA9\uB9C8\uB97C \uB3CC\uC544\uBCF4\uC558\uB2E4.
      \uCC98\uC74C \uC774\uACF3\uC5D0\uC11C \uB4E4\uC5C8\uB358 \uC74C\uC545\uC774
      \uC544\uC9C1\uB3C4 \uD758\uB7EC\uB098\uC624\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC800 \uC18C\uB9AC\uB97C \uCC98\uC74C \uB4E4\uC5C8\uC744 \uB54C. \uADF8
      \uBC14\uB85C \uC804\uC5D0, \uBB34\uC5C7\uC774 \uC788\uC5C8\uB294\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uAC83\uB3C4 \uB5A0\uC624\uB974\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC77C\uC9C0 \uC4F0\uB294 \uC0AC\uB78C\uB3C4 \uB300\uCDA9\uC774\uB124.
      \uB9E4\uD45C\uC18C\uB791 \uB611\uAC19\uC774."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5EC\uAE30 \uC0AC\uB78C\uB4E4 \uB2E4 \uC77C \uBABB \uD574."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uC0AC\uB78C\uC740\u2026 \uC544\uBB34\uB3C4 \uC5C6\uC5C8\uB294\uB370\uB3C4\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
