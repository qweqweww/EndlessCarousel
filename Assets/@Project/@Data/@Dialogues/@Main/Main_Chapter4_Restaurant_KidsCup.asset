  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_KidsCup
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC2DD\uAE30 \uC120\uBC18 \uAD6C\uC11D\uC5D0 \uC791\uC740 \uD50C\uB77C\uC2A4\uD2F1
      \uCEF5\uC774 \uD558\uB098 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC190\uC7A1\uC774\uAC00 \uB450 \uAC1C \uB2EC\uB9B0 \uC5B4\uB9B0\uC774\uC6A9
      \uCEF5. \uBC14\uB2E5\uC5D0 \uC774\uB984\uD45C\uB97C \uB5C0 \uC790\uAD6D\uC774
      \uB0A8\uC544 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC5B4\uB9B0\uC774\uC6A9 \uCEF5\uC774\uB124\uC694. \uC5EC\uAE30 \uC544\uC774
      \uC190\uB2D8\uB3C4 \uC624\uB098 \uBD10\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uC774\uAC70 \uC190\uC7A1\uC774 \uD558\uB098 \uAE68\uBB3C\uC5B4\uC11C
      \uC790\uAD6D \uB0AC\uC744\uAC78."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uCEF5\uC744 \uB3CC\uB824 \uBCF4\uC558\uB2E4. \uC815\uB9D0\uB85C
      \uD55C\uCABD \uC190\uC7A1\uC774\uC5D0 \uC791\uC740 \uC774\uBE68 \uC790\uAD6D\uC774
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4, \uC9C4\uC9DC\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBC84\uB9AC\uB77C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "\uC548 \uBC84\uB838\uB124."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "\uB204\uAC00 \uC774\uB7F0 \uAC78 \uC548 \uBC84\uB824. \uC9C4\uC9DC."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uCEF5\uC744 \uC120\uBC18 \uB9E8 \uC548\uCABD\uC5D0 \uB2E4\uC2DC
      \uB123\uC5C8\uB2E4. \uC544\uC8FC \uC870\uC2EC\uC2A4\uB7FD\uAC8C."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
