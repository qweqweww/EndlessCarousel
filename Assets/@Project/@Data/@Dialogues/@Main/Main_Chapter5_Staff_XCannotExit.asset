%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_XCannotExit
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: X
    text: "\u2026\u2026\uB098\uB294."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBAA8\uB450\uAC00 X\uB97C \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uBC14\uAE65\uC5D0 \uB0A8\uACA8 \uB454 \uAC8C \uC5C6\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC7A5\uBD80\uC5D0\uB3C4 \uADF8\uB807\uAC8C \uC368 \uC788\uC5C8\uACE0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: X
    text: "\uC815\uBB38\uC73C\uB85C \uB098\uAC00\uB3C4, \uB3CC\uC544\uAC08 \uB0B4\uAC00
      \uC5C6\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB108\uD76C\uAC00 \uB098\uAC00\uB294 \uBC29\uBC95\uC73C\uB85C\uB294,
      \uB098\uB294 \uBABB \uB098\uAC00."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 8dc8459779a07b141a804f6f6a8d01c4, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uAC74\u2026."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "\uC815\uC801\uC774 \uAE38\uC5C8\uB2E4. \uD615\uAD11\uB4F1\uC774 \uD55C
      \uBC88 \uAE5C\uBE61\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uBC29\uBC95 \uD558\uB098 \uCC3E\uC740 \uAC70\uC796\uC544."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uB124 \uAC74 \uC544\uC9C1 \uBAA8\uB974\uB294 \uAC70\uACE0."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uC870\uAE08 \uB354 \uCC3E\uC544\uBD10\uB3C4 \uB418\uC796\uC544\uC694.
      \uC544\uC9C1 \uB2E4 \uBCF8 \uAC83\uB3C4 \uC544\uB2C8\uACE0\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uCD9C\uAD6C \uCC3E\uC558\uB2E4\uACE0 \uC624\uB298 \uB098\uAC00\uC57C
      \uD558\uB294 \uAC74 \uC544\uB2C8\uC9C0. \uC544\uBB34\uB3C4 \uC624\uB298 \uB098\uAC04\uB2E4\uACE0
      \uC548 \uD588\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uD63C\uC790 \uACB0\uB860 \uB0B4\uB9AC\uC9C0 \uB9C8."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC6B0\uB9AC \uC544\uC9C1 \uC5EC\uAE30 \uC788\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \"\uC6B0\uB9AC\uB3C4 \uC548 \uB098\uAC08\uAC8C\"\uB77C\uACE0
      \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uC815\uBB38 \uCABD\uC73C\uB85C \uB6F0\uC5B4\uAC00\uC9C0\uB3C4
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB4E4 \uBC14\uAE65\uC5D0 \uBB34\uC5B8\uAC00\uB97C \uB450\uACE0
      \uC654\uB2E4. \uADF8\uAC83\uC740 \uC27D\uAC8C \uB0B4\uB824\uB193\uC744 \uC218
      \uC788\uB294 \uAC83\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4 \uC9C0\uAE08\uC740, \uB2E4\uC12F \uBAA8\uB450 \uC774
      \uC881\uC740 \uBCF5\uB3C4\uC5D0 \uC11C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC77C\uB2E8 \uB098\uAC00\uC790. \uC5EC\uAE30 \uD615\uAD11\uB4F1
      \uB208 \uC544\uD30C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uB098\uAC04\uB2E4\uB294 \uAC8C \uADF8 \uB098\uAC04\uB2E4\uB294 \uAC70
      \uC544\uB2C8\uC9C0?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB2C8\uC57C. \uAD11\uC7A5\uC73C\uB85C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uAC00\uC790."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
