MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_AfterMemory1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uB294 \uC0AC\uC9C4\uC744 \uC190\uC5D0 \uB4E0 \uCC44 \uAC00\uB9CC\uD788
      \uC11C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC57C. \uAD1C\uCC2E\uC544?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544, \uB124! \uAD1C\uCC2E\uC544\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB0E5\u2026 \uC5C4\uB9C8\uAC00 \uC790\uC8FC \uD574 \uC8FC\uB358
      \uC774\uC57C\uAE30\uAC00 \uC0DD\uAC01\uB0AC\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uBB34\uC2A8 \uC774\uC57C\uAE30?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC81C\uAC00\u2026 \uC544\uC8FC \uC624\uB798 \uAE30\uB2E4\uB9B0 \uC544\uC774\uC600\uB300\uC694.
      \uC2E0\uAED8\uC11C \uBCF4\uB0B4 \uC8FC\uC2E0 \uC544\uC774\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC640. \uC5C4\uCCAD \uD658\uC601\uBC1B\uC558\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uB2E4\uB4E4 \uC800\uB97C \uC608\uBED0\uD574 \uC8FC\uC168\uC5B4\uC694.
      \uC0AC\uB78C\uC774 \uC544\uC8FC \uB9CE\uC740 \uACF3\uC774\uC5C8\uAC70\uB4E0\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uB300\uAC00\uC871\uC774\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uADF8\uB7F0 \uC148\uC774\uC5D0\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC7A0\uAE50 \uB9D0\uC744 \uACE0\uB974\uB2E4\uAC00, X \uCABD\uC744
      \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC800\uAE30, X \uC528."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: B
    text: "\uBC14\uAE65\uC5D0\uC11C\uB294\u2026 \uACF5\uBD80 \uB05D\uB098\uACE0\uB3C4
      \uCE5C\uAD6C\uB97C \uB530\uB85C \uB9CC\uB098\uB294 \uAC8C, \uD3C9\uBC94\uD55C
      \uAC70\uC608\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices:
    - text: "\uC751, \uADF8\uAC8C \uD3C9\uBC94\uD55C \uAC70\uC57C."
      next: {fileID: 11400000, guid: db46d2ca5dcf7874487603a01967f9d1, type: 2}
      choiceId: Chapter2_X_Response_Ordinary
      recordAsFlag: 1
    - text: "\uB098\uB3C4 \uC798 \uBAB0\uB77C. \uC5EC\uAE30\uC120 \uB2E4 \uCC98\uC74C\uC774\uC57C."
      next: {fileID: 11400000, guid: 28740968cdce976458f5541e8ae40f20, type: 2}
      choiceId: Chapter2_X_Response_FirstTimeToo
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
