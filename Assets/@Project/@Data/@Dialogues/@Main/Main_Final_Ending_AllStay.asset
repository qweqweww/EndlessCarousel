  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Ending_AllStay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB180\uC774\uACF5\uC6D0\uC758 \uB0A0\uB4E4\uC740 \uACC4\uC18D\uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD53C\uC544\uB178\uB294 \uC5B8\uC81C\uB098 \uC870\uC728\uB418\uC5B4 \uC788\uC5C8\uACE0,
      \uC624\uB77D\uC2E4\uC758 \uBD88\uBE5B\uC740 \uAEBC\uC9C0\uC9C0 \uC54A\uC558\uACE0,
      \uD558\uC580 \uC120\uC740 \uBC18\uB4EF\uD588\uACE0, \uC800\uB141\uC740 \uB9E4\uC77C
      \uCC28\uB824\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC12F\uC740 \uD589\uBCF5\uD588\uB2E4. \uADF8\uAC74 \uAC70\uC9D3\uC774
      \uC544\uB2C8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD68C\uC804\uBAA9\uB9C8\uB294 \uAC19\uC740 \uC18D\uB3C4\uB85C, \uAC19\uC740
      \uC790\uB9AC\uB97C \uB3CC\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC624\uB298\uACFC \uB611\uAC19\uC740 \uB0B4\uC77C\uC774 \uC654\uB2E4.
      \uADF8\uB2E4\uC74C \uB0A0\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD589\uBCF5\uC740 \uACC4\uC18D\uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uB9CC, \uC0C8\uB85C\uC6B4 \uB2E4\uC74C\uC740 \uC624\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2014 \uB05D \u2014"
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
