MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_Prize
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC720\uB9AC \uC9C4\uC5F4\uB300 \uC548\uC5D0 \uACBD\uD488\uC774 \uB193\uC5EC
      \uC788\uB2E4. \uB9E8 \uC704 \uCE78\uC5D0 \uC791\uC740 \uD0A4\uB9C1 \uC138\uD2B8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBCC4 \uBAA8\uC591 \uB450 \uAC1C\uAC00 \uD55C \uC30D\uC73C\uB85C \uBB36\uC5EC
      \uC788\uB2E4. '\uC6B0\uC815 \uD0A4\uB9C1 \u2014 \uB458\uC774 \uD558\uB098\uC529'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC774\uAC70 \uCE5C\uAD6C\uB07C\uB9AC \uD558\uB098\uC529 \uB098\uB220
      \uAC16\uB294 \uAC70\uC57C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uB458\uC774\uC11C\uB9CC\u2026 \uB098\uB220 \uAC16\uB294 \uAC70\uC608\uC694?
      \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uC740\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC8C \uC88B\uC740 \uAC70\uC9C0. \uB458\uB9CC\uC758 \uAC70\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uB458\uB9CC\uC758 \uAC70\u2026."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: D
    text: "\uC720\uCE58\uD558\uB2E4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "D\uAC00 \uC81C\uC77C \uAC16\uACE0 \uC2F6\uC5B4 \uD558\uB294 \uD45C\uC815\uC778\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uB2C8\uAC70\uB4E0!"
    portrait: {fileID: 21300000, guid: 21bd4aa4290022744b657525a11a3354, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uD0A4\uB9C1\uC744 \uC624\uB798 \uBC14\uB77C\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC6C3\uACE0 \uC788\uB358 \uC785\uAF2C\uB9AC\uAC00, \uC544\uC8FC \uCC9C\uCC9C\uD788
      \uB0B4\uB824\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
