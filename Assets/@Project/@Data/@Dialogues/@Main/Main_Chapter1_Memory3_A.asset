%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Memory3_A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "A\uAC00 \uBA3C\uC800 \uC218\uD654\uAE30\uB97C \uB4E4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC7A1\uC74C. \uADF8\uB9AC\uACE0 \uC775\uC219\uD55C \uBAA9\uC18C\uB9AC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uACB0\uACFC \uB098\uC654\uC5B4? \uC5B4\uB5BB\uAC8C \uB410\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC544\uC9C1."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC70\uC9D3\uB9D0\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uB2E4\uC74C \uB2EC \uB808\uC2A8\uBE44\uB294 \uC870\uAE08\uB9CC \uAE30\uB2E4\uB824
      \uB2EC\uB77C\uACE0 \uD588\uC5B4. \uC774\uBC88\uC5D4 \uAF2D\uC774\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC751. \uC54C\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC7A5\uBA74\uC774 \uBC14\uB010\uB2E4. \uBC24. \uB2EB\uD78C \uBC29\uBB38
      \uB108\uBA38."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uB610 \uBE4C\uB838\uC5B4? \uADF8 \uB3C8\uC744 \uC5B4\uB5BB\uAC8C \uAC1A\uC73C\uB824\uACE0!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uC9C0\uAE08 \uADF8\uB9CC\uB450\uBA74 \uC9C0\uAE08\uAE4C\uC9C0 \uB4E4\uC5B4\uAC04
      \uAC74 \uB2E4 \uBB50\uAC00 \uB418\uB294\uB370!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC774\uC5B4\uD3F0\uC744 \uAF42\uACE0 \uBA54\uD2B8\uB85C\uB188
      \uC18C\uB9AC\uB9CC \uB4E4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC7A5\uBA74\uC774 \uBC14\uB010\uB2E4. \uB2E4\uC74C \uB300\uD68C \uC811\uC218\uCC98."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC9C0\uB09C\uBC88 \uACB0\uACFC\uC694? \u2026\u20261\uB4F1\uC774\uC5C8\uC5B4\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB610 \uAC70\uC9D3\uB9D0\uC774\uC5C8\uB2E4. \uD55C \uBC88 \uC2DC\uC791\uD558\uB2C8
      \uBA48\uCD9C \uC218\uAC00 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD53C\uC544\uB178 \uC55E\uC5D0 \uC549\uB294 \uC774\uC720\uAC00 \uBC14\uB00C\uC5B4
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC88B\uC544\uC11C\uAC00 \uC544\uB2C8\uB77C, \uADF8\uB9CC\uB458 \uC218
      \uC5C6\uC5B4\uC11C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC218\uD654\uAE30 \uB108\uBA38\uC5D0\uC11C \uC2E0\uD638\uC74C\uB9CC \uAE38\uAC8C
      \uC774\uC5B4\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
