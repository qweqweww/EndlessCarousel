  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Prologue_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC0C9\uC0C9\uC758 \uC870\uBA85 \uC544\uB798, \uB180\uC774\uAE30\uAD6C\uB4E4\uC774
      \uCC9C\uCC9C\uD788 \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC74C\uC545\uC740 \uD750\uB974\uACE0 \uC788\uB294\uB370 \uC0AC\uB78C
      \uAE30\uCC99\uC740 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026."
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC5EC\uAE34\u2026\u2026"
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB180\uC774\uACF5\uC6D0?"
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC544, \uC815\uC2E0 \uB4DC\uC168\uC5B4\uC694?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uAD1C\uCC2E\uC73C\uC138\uC694? \uC5B4\uC9C0\uB7FD\uAC70\uB098, \uC5B4\uB514
      \uC544\uD508 \uB370\uB294 \uC5C6\uACE0\uC694?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    previewImage: {fileID: 0}
    choices:
    - text: "\u2026\u2026\uB204\uAD6C\uC138\uC694?"
      next: {fileID: 11400000, guid: f5383f5be94d8fd42b64ae9d1c4a8859, type: 2}
      choiceId: Prologue_Q1_Who
      recordAsFlag: 1
    - text: "\uC800\uD55C\uD14C \uBB34\uC2A8 \uC9D3 \uD55C \uAC74 \uC544\uB2C8\uC8E0?"
      next: {fileID: 11400000, guid: e9b89e4599e06824d9efd64fb13279a2, type: 2}
      choiceId: Prologue_Q1_Suspect
      recordAsFlag: 1
    - text: "\uC5EC\uAE30\uAC00 \uC5B4\uB518\uC9C0 \uC544\uC138\uC694?"
      next: {fileID: 11400000, guid: d88ab381e80f44a41b2be56499201efa, type: 2}
      choiceId: Prologue_Q1_Where
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
