%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Prologue_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBC1D\uAC8C \uCF1C\uC9C4 \uC870\uBA85\uACFC \uBA40\uB9AC\uC11C \uC6C0\uC9C1\uC774\uB294
      \uB180\uC774\uAE30\uAD6C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB7F0\uB370 \uC774\uC0C1\uD560 \uC815\uB3C4\uB85C \uC8FC\uBCC0\uC740
      \uC870\uC6A9\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC74C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC5EC\uAE34 \uC5B4\uB514\uC9C0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uB180\uC774\uACF5\uC6D0\u2026\u2026?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC5B4. \uAE7C\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uC5B4... \uAD1C\uCC2E\uC73C\uC138\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uB108\uD76C\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC6B0\uB9AC\uB3C4 \uBC29\uAE08 \uAE7C\uC5B4."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uC751. \uC0C1\uD669\uC740 \uBE44\uC2B7\uD574."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uB108\uB3C4 \uC65C \uC5EC\uAE30 \uC788\uB294\uC9C0 \uBAA8\uB974\uB294
      \uAC70\uC9C0?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC544\uB9C8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uADF8... \uC800\uD76C\uB3C4 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uACA0\uC5B4\uC11C\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uC77C\uB2E8 \uB2E4\uCE5C \uC0AC\uB78C\uC740 \uC5C6\uB294 \uAC83 \uAC19\uACE0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uADF8\uAC74 \uB2E4\uD589\uC774\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uC77C\uB2E8 \uC774\uB984\uBD80\uD130 \uB9D0\uD560\uAE4C?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: '?'
    text: "\uACC4\uC18D '\uB108', '\uAC70\uAE30'\uB77C\uACE0 \uD560 \uC21C \uC5C6\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: A.
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5B4... \uC800\uB294 B\uC608\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uB09C C. \uC798 \uBD80\uD0C1\uD574."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uB098\uB294 D."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB50... \uC77C\uB2E8\uC740 \uC798 \uBD80\uD0C1\uD574."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026X."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC88B\uC544. \uC774\uC81C \uC774\uB984\uC73C\uB85C \uBD80\uB974\uBA74
      \uB418\uACA0\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uAC74 \uC880 \uD3B8\uD558\uACA0\uB2E4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uB108 \uC740\uADFC \uAE0D\uC815\uC801\uC774\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uB7F4 \uB54C\uC77C\uC218\uB85D \uB354 \uADF8\uB798\uC57C\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB798\uC11C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: A
    text: "\uC5EC\uAE30\uAC00 \uC5B4\uB518\uC9C0\uB294?"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\uBAB0\uB77C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uAE4C\uBD80\uD130 \uBD24\uB294\uB370 \uC0AC\uB78C\uB3C4 \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC5B4... \uB180\uC774\uAE30\uAD6C\uB294 \uC6C0\uC9C1\uC774\uACE0 \uC788\uB294\uB370\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices:
    - text: "\uADF8\uB7FC \uB204\uAD70\uAC00 \uC6B4\uC601\uD558\uACE0 \uC788\uB294
        \uAC78\uAE4C?"
      next: {fileID: 11400000, guid: ade0f9c1c87d830438cda295bea49115, type: 2}
      choiceId: Prologue_Choice_Observe
      recordAsFlag: 1
    - text: "\uC77C\uB2E8 \uC9C1\uC811 \uB458\uB7EC\uBCF4\uC790."
      next: {fileID: 11400000, guid: 52beb78bf03a6674ca89eb473784838a, type: 2}
      choiceId: Prologue_Choice_Act
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
