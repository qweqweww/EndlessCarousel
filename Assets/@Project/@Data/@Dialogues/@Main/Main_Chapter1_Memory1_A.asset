--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Memory1_A
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC0AC\uC9C4 \uC18D \uC6C3\uC74C\uC18C\uB9AC\uAC00 \uB4E4\uB9B0 \uAC83
      \uAC19\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC624\uB798\uB41C \uC5C5\uB77C\uC774\uD2B8 \uD53C\uC544\uB178. \uC881\uC740
      \uAC70\uC2E4 \uD55C\uCABD."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC791\uC740 \uC190\uC774 \uAC74\uBC18\uC744 \uB450\uB4DC\uB9B0\uB2E4.
      \uC5C9\uB9DD\uC778 \uBC15\uC790. \uADF8\uB798\uB3C4 \uBA48\uCD94\uC9C0 \uC54A\uB294\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uB610 \uCE58\uB2C8? \uBC25 \uBA39\uC5B4\uC57C\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC870\uAE08\uB9CC \uB354!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC19\uC740 \uACE1\uC744 \uC5F4 \uBC88, \uC2A4\uBB34 \uBC88."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD2C0\uB9AC\uBA74 \uC6C3\uC5C8\uB2E4. \uB2E4\uC2DC \uCE58\uBA74 \uB410\uC73C\uB2C8\uAE4C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC120\uC0DD\uB2D8"
    text: "\uC5B4\uBA38\uB2D8, \uC774 \uC544\uC774 \uADC0\uAC00 \uC88B\uC544\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC120\uC0DD\uB2D8"
    text: "\uC7AC\uB2A5 \uC788\uC5B4\uC694. \uC81C\uB300\uB85C \uC2DC\uD0A4\uBA74
      \uD06C\uAC8C \uB420 \uC218\uB3C4 \uC788\uC5B4\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uC815\uB9D0\uC694?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB0A0 \uC800\uB141, \uC2DD\uD0C1 \uC704\uAC00 \uC720\uB09C\uD788
      \uBC1D\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B4\uB978\uC758 \uBAA9\uC18C\uB9AC"
    text: "\uC6B0\uB9AC \uC560\uAC00 \uC7AC\uB2A5\uC774 \uC788\uB300."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC98\uC74C\uC73C\uB85C \uBC1B\uC740 \uC0C1\uC740 \uC7A5\uB824\uC0C1\uC774\uC5C8\uB2E4.
      \uAC00\uC871 \uBAA8\uB450\uAC00 \uBC15\uC218\uB97C \uCCE4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uB2E4\uC74C\uC5D4 \uB354 \uD070 \uC0C1 \uBC1B\uC744\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uB9D0\uC744 \uD588\uC744 \uB54C, A\uB294 \uC815\uB9D0\uB85C \uC2E0\uC774
      \uB098 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
