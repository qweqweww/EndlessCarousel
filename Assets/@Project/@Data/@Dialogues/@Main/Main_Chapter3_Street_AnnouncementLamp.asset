%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_AnnouncementLamp
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC00\uB85C\uB4F1 \uAE30\uB465\uC5D0 \uD655\uC131\uAE30\uAC00 \uB9E4\uB2EC\uB824
      \uC788\uB2E4. \uC9C0\uC9C0\uC9C1, \uC7A1\uC74C\uC774 \uB098\uB354\uB2C8 \uC548\uB0B4
      \uBC29\uC1A1\uC774 \uD758\uB7EC\uB098\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uBC29\uC1A1"
    text: "\uC7A0\uC2DC \uD6C4 \uD37C\uB808\uC774\uB4DC\uAC00 \uCD9C\uBC1C\uD569\uB2C8\uB2E4.
      \uCD9C\uBC1C\uC120 \uB4A4\uB85C \uBB3C\uB7EC\uC11C \uC8FC\uC138\uC694."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uD37C\uB808\uC774\uB4DC? \uC544\uBB34\uB3C4 \uC5C6\uB294\uB370 \uB204\uAC00
      \uCD9C\uBC1C\uD574."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: "\uBC29\uC1A1"
    text: "\uC81C\uC790\uB9AC\uC5D0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uC758 \uBAB8\uC774 \uBA3C\uC800 \uC6C0\uC9C1\uC600\uB2E4. \uBCC4 \uC6D0\uC758
      \uD558\uC580 \uC120 \uC55E\uC5D0\uC11C \uBAB8\uC744 \uC219\uC5EC, \uC190\uB05D\uC744
      \uC120 \uBC14\uB85C \uB4A4\uC5D0 \uC9DA\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB204\uAC00 \uAC00\uB974\uCCD0 \uC900 \uAC83\uB3C4 \uC544\uB2CC\uB370,
      \uC790\uC138\uAC00 \uC774\uC0C1\uD558\uAC8C \uBC18\uB4EF\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uBC29\uC1A1"
    text: "\uCC28\uB837."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC5C9\uB369\uC774\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uC62C\uB838\uB2E4.
      \uBAB8 \uC804\uCCB4\uAC00 \uC55E\uC73C\uB85C \uAE30\uC6B8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026\uADF8\uB9AC\uACE0 \uBC29\uC1A1\uC774 \uB04A\uACBC\uB2E4.
      \uCD9C\uBC1C \uC2E0\uD638\uB294 \uC6B8\uB9AC\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB50 \uD558\uB0D0?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5B4?"
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098 \uC774\uAC70 \uC5B4\uB5BB\uAC8C \uC54C\uC9C0?"
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: X
    text: "\uBAB8\uC774 \uAE30\uC5B5\uD558\uB294 \uAC70 \uC544\uB0D0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7F0\uAC00 \uBD10. \uBA38\uB9AC\uB294 \uBAA8\uB974\uACA0\uB294\uB370,
      \uC190\uC774 \uC54C\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uB2E4\uC74C\uC5D0 '\uD0D5' \uC18C\uB9AC\uAC00 \uB098\uC57C \uD558\uB294\uB370.
      \uC18C\uB9AC\uAC00 \uC548 \uB098\uB2C8\uAE4C \uCD9C\uBC1C\uC744 \uBABB \uD558\uACA0\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC6C3\uC73C\uBA74\uC11C \uC77C\uC5B4\uB0AC\uC9C0\uB9CC, \uD55C\uB3D9\uC548
      \uD655\uC131\uAE30\uB97C \uC62C\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC2E0\uD638\uAC00 \uC788\uC5B4\uC57C \uB6F0\uB294\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uADF8\uB7F0 \uAC70 \uAC19\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
