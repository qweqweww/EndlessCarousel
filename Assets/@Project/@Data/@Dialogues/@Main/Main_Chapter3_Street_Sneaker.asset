%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_Sneaker
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC720\uB9AC \uC9C4\uC5F4\uC7A5 \uC548\uC5D0 \uC6B4\uB3D9\uD654 \uD55C
      \uCF24\uB808\uAC00 \uB193\uC5EC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uD37C\uB808\uC774\uB4DC \uB2EC\uB9AC\uAE30 \uB300\uD68C 1\uB4F1 \uACBD\uD488'\uC774\uB77C\uB294
      \uD33B\uB9D0\uC774 \uBD99\uC5B4 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC608\uC05C \uC2E0\uBC1C\uC774\uB124\uC694. \uBC14\uB2E5\uC774 \uC5C4\uCCAD
      \uAC00\uBCBC\uC6CC \uBCF4\uC5EC\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uAC70 \uC2A4\uD30C\uC774\uD06C\uB2E4. \uBC14\uB2E5\uC5D0 \uC9D5
      \uBC15\uD78C \uAC70."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC9D5? \uC2E0\uBC1C\uC5D0?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uD2B8\uB799\uC5D0\uC11C \uBBF8\uB044\uB7EC\uC9C0\uC9C0 \uB9D0\uB77C\uACE0.
      \uADFC\uB370 \uC774\uAC74 \uADF8\uB0E5 \uC7A5\uC2DD\uC6A9 \uAC19\uB2E4. \uB048\uB3C4
      \uC548 \uBB36\uC5EC \uC788\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uB108 \uC2E0\uBC1C \uC598\uAE30\uD560 \uB54C \uB9D0 \uBE68\uB77C\uC9C0\uB294
      \uAC70 \uC54C\uC544?"
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: C
    text: "\uB0B4\uAC00?"
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B4. \uC544\uAE4C \uC624\uB77D\uC2E4 \uC598\uAE30\uD560 \uB54C\uBCF4\uB2E4
      \uBE68\uB77C."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uADF8\uB7F0\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uB300\uD68C 1\uB4F1 \uACBD\uD488\uC774\uB798."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: C
    text: "\uB300\uD68C\uB294 \uBB34\uC2A8. \uB6F0\uB294 \uC0AC\uB78C\uC774 \uB098\uBC16\uC5D0
      \uC5C6\uB294\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "1\uB4F1 \uD655\uC815\uC774\uB124. \uAC1C\uC774\uB4DD."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB18D\uB2F4\uCC98\uB7FC \uB9D0\uD588\uC9C0\uB9CC, \uC9C4\uC5F4\uC7A5
      \uC720\uB9AC\uC5D0 \uC190\uBC14\uB2E5\uC744 \uD55C \uBC88 \uB300\uC5C8\uB2E4\uAC00
      \uB5D0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
