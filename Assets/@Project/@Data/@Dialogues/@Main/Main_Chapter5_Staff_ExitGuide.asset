%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_ExitGuide
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB179\uC0C9 \uD45C\uC2DC\uB4F1 \uC544\uB798 \uBB38\uC5D0\uB294 \uC190\uC7A1\uC774\uAC00
      \uC5C6\uC5C8\uB2E4. \uB300\uC2E0 \uC548\uB0B4\uD310\uC774 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC548\uB0B4\uD310\uC5D0\uB294 \uB3C4\uBA74 \uC18D \uC815\uBB38\uC774
      \uADF8\uB824\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB3CC\uC544\uAC00\uC2E4 \uBD84\uC740 \uC815\uBB38\uC73C\uB85C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC815\uBB38\uC740 \uBC14\uAE65\uC5D0 \uB0A8\uACA8 \uB454 \uC790\uAE30
      \uC790\uC2E0\uC5D0\uAC8C\uB85C \uC774\uC5B4\uC9D1\uB2C8\uB2E4.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC5B8\uC81C\uB4E0, \uC6D0\uD558\uC2E4 \uB54C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC815\uBB38."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uCC98\uC74C\uBD80\uD130 \uC788\uB358 \uADF8 \uBB38? \uB298 \uB2EB\uD600
      \uC788\uB358 \uAC70."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uBC14\uAE65\uC5D0 \uB0A8\uACA8 \uB454\u2026 \uC790\uAE30 \uC790\uC2E0."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uC7A5\uBD80\uC5D0 \uC788\uC5C8\uC9C0. '\uBC14\uAE65\uC5D0 \uB0A8\uC740
      \uAC83: \uC788\uC74C.'"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC6B0\uB9AC \uBAB8 \uB9D0\uD558\uB294 \uAC70\uC57C? \uBCD1\uC6D0
      \uCE68\uB300 \uAC19\uC740 \uB370 \uB204\uC6CC \uC788\uB294?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uB204\uC6CC \uC788\uB294\uC9C0 \uC11C \uC788\uB294\uC9C0 \uC5B4\uB5BB\uAC8C
      \uC54C\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uADF8\uB807\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "\uC815\uBB38\uC740 \uB3CC\uC544\uAC08 \uACF3\uC774 \uC788\uB294 \uC0AC\uB78C\uC5D0\uAC8C
      \uC5F4\uB9AC\uB294 \uBB38\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC14\uAE65\uC5D0\uB294 \uAC01\uC790\uC758 \uBAB8\uC774 \uC788\uC5C8\uB2E4.
      \uAC01\uC790\uC758 \uC0B6\uC774, \uAC01\uC790\uC758 \uACFC\uAC70\uAC00 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7FC\u2026 \uC800\uD76C \uB098\uAC08 \uC218 \uC788\uB294 \uAC70\uC608\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uBC29\uBC95\uC740 \uCC3E\uC558\uB124."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "\uC7A0\uAE50, \uB204\uAD6C\uB3C4 \uAE30\uBED0\uD558\uC9C0\uB3C4 \uC2AC\uD37C\uD558\uC9C0\uB3C4
      \uC54A\uC558\uB2E4. \uB2E4\uB4E4 \uBB34\uC5B8\uAC00\uB97C \uACC4\uC0B0\uD558\uB294
      \uC5BC\uAD74\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uC548\uB0B4\uD310\uC758 \uD55C \uC904\uC744 \uB2E4\uC2DC \uC77D\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uBC14\uAE65\uC5D0 \uB0A8\uACA8 \uB454 \uC790\uAE30 \uC790\uC2E0\uC5D0\uAC8C\uB85C.'"
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
