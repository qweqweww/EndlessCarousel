  lines:
  - speakerName: X
    text: "\u2026\u2026\uB204\uAD6C\uC138\uC694?"
    portrait: {fileID: 0}
    previewImage: {fileID: 0}
    choices: []
  - speakerName: '?'
    text: "\uC800\uD76C\uB3C4 \uC870\uAE08 \uC804\uC5D0 \uC5EC\uAE30\uC11C \uAE7C\uC5B4\uC694."
