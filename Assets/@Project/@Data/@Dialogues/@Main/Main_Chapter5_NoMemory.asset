%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_NoMemory
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC138 \uAD70\uB370\uB97C \uBAA8\uB450 \uB3CC\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uC5D0\uAC8C\uB294 \uAC74\uBC18\uC774 \uC788\uC5C8\uB2E4. B\uC5D0\uAC8C\uB294
      \uC2ED\uC790\uAC00\uAC00, C\uC5D0\uAC8C\uB294 \uC6B4\uB3D9\uD654 \uB048\uC774,
      D\uC5D0\uAC8C\uB294 \uACC4\uB780 \uC5BC\uB8E9\uC774 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uC5D0\uAC8C\uB294, \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC774\uC0C1\uD558\uB124."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB50\uAC00. \uBE7C\uBA39\uC740 \uAC70\uB77C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "\uC138 \uBC88 \uB2E4?"
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC6B0\uB9AC \uB550 \uBB50 \uD558\uB098\uB9CC \uBD10\uB3C4 \uB9C9 \uC3DF\uC544\uC84C\uC796\uC544.
      \uD2B8\uB799\uC774\uB4E0 \uBCD1\uC6D0\uC774\uB4E0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "X\uB294 \uD558\uB098\uB3C4 \uC548 \uAC78\uB824."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uD639\uC2DC\u2026 \uC544\uC9C1 \uC548 \uAC00 \uBCF8 \uACF3\uC5D0 \uC788\uB294
      \uAC74 \uC544\uB2D0\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC548 \uAC00 \uBCF8 \uACF3\uC774\uB77C. \uC9C1\uC6D0 \uAD6C\uC5ED \uAC19\uC740
      \uB370?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uC9C1\uC6D0 \uAD6C\uC5ED?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB9E4\uD45C\uC18C \uB4A4\uC5D0 '\uAD00\uACC4\uC790 \uC678 \uCD9C\uC785
      \uAE08\uC9C0' \uBB38 \uC788\uC5C8\uC796\uC544. \uCC98\uC74C\uC5D0 \uC9C1\uC6D0
      \uCC3E\uB294\uB2E4\uACE0 \uD588\uB2E4\uAC00 \uBABB \uCC3E\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uAC00 \uBCF4\uBA74 \uB418\uC796\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: B
    text: "\uB4E4\uC5B4\uAC00\uB3C4\u2026 \uB420\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uC9C1\uC6D0\uC774 \uC5C6\uB294\uB370 \uB204\uAC00 \uBB50\uB77C \uD574."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: A
    text: "\uAC00\uC790."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4. \uB2E4\uB9CC \uC774\uBC88\uC5D0\uB294,
      \uAC00\uC7A5 \uBA3C\uC800 \uAC78\uC74C\uC744 \uC62E\uACBC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
