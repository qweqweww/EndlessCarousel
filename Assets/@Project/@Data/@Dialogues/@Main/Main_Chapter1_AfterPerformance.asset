%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_AfterPerformance
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB9C8\uC9C0\uB9C9 \uC74C\uC774 \uCC9C\uCC9C\uD788 \uC0AC\uB77C\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC15\uC218\uB294 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC810\uC218\uB97C \uBD80\uB974\uB294 \uBAA9\uC18C\uB9AC\uB3C4 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC2DC \uD558\uB77C\uACE0 \uC7AC\uCD09\uD558\uB294 \uC0AC\uB78C\uB3C4
      \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uD55C\uB3D9\uC548 \uAC74\uBC18 \uC704\uC5D0 \uC190\uC744 \uC62C\uB824\uB454
      \uCC44 \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC5B4\uB560\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uBAB0\uB77C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uADFC\uB370."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uD2C0\uB838\uB294\uB370, \uC544\uBB34 \uC77C\uB3C4 \uC5C6\uB124."
    portrait: {fileID: 21300000, guid: 78e2c16278be20748807d3facc559a28, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB7EC\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC774\uC0C1\uD558\uB2E4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC624\uB79C\uB9CC\uC774\uB124."
    portrait: {fileID: 21300000, guid: f1c749ec53789e24284806aa1c95dc04, type: 3}
    choices: []
  - speakerName: X
    text: "\uBB50\uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uADF8\uB0E5 \uCE58\uB294 \uAC70."
    portrait: {fileID: 21300000, guid: f1c749ec53789e24284806aa1c95dc04, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uCC9C\uCC9C\uD788 \uAC74\uBC18\uC5D0\uC11C \uC190\uC744 \uB5D0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "A \uC528."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uAE4C\uBCF4\uB2E4\u2026 \uD3B8\uD574 \uBCF4\uC600\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uB108\uB294?"
    portrait: {fileID: 21300000, guid: 203a15641f386d44f9c87e170550501f, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124?"
    portrait: {fileID: 21300000, guid: 3239e825068e553449dade0b3ea760df, type: 3}
    choices: []
  - speakerName: A
    text: "\uD558\uACE0 \uC2F6\uC740 \uAC70."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\uB294\u2026"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC798 \uBAA8\uB974\uACA0\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uADF8\uB807\uAC8C \uB9D0\uD558\uACE0, \uC11C\uB458\uB7EC \uACE0\uAC1C\uB97C
      \uC219\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB798\uB3C4 \uC798 \uCE58\uB358\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\uD3C9\uAC00\uD558\uC9C0 \uB9C8."
    portrait: {fileID: 21300000, guid: a9466375a7b305f4190784b069a8dcda, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544."
    portrait: {fileID: 21300000, guid: 7a937c782a3b6674ba04cefe228423d3, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC83\uB3C4 \uD3C9\uAC00\uC778\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB7EC\uB124."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: D
    text: "\uB2E4\uC74C\uC5D0 \uB610 \uCE58\uBA74 \uB418\uACA0\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC65C \uB2E4\uC74C\uC774 \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: 78e2c16278be20748807d3facc559a28, type: 3}
    choices: []
  - speakerName: D
    text: "\uC788\uC744 \uC218\uB3C4 \uC788\uC9C0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uB300\uB2F5\uC744 \uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 \uBA3C\uC800
      \uBB38 \uCABD\uC73C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uAC00\uC790. \uC5EC\uAE30 \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uADC0\uAC00
      \uC774\uC0C1\uD574."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "B\uC640 C\uAC00 D\uC758 \uB4A4\uB97C \uB530\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uBCF4\uB2E4 \uC870\uAE08 \uB2A6\uAC8C
      \uC77C\uC5B4\uB0AC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB38\uC744 \uB098\uC11C\uAE30 \uC804, A\uAC00 \uC7A0\uC2DC \uAC78\uC74C\uC744
      \uBA48\uCDC4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uB294 \uD55C \uBC88 \uD53C\uC544\uB178\uB97C \uB3CC\uC544\uBD24\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB34\uB300 \uC704\uC758 \uD53C\uC544\uB178\uB294 \uB69C\uAED1\uC774
      \uC5F4\uB9B0 \uCC44 \uADF8\uB300\uB85C\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC65C?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: 
    text: "A\uAC00 \uBA3C\uC800 \uBC16\uC73C\uB85C \uB098\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uACF5\uC5F0\uC7A5\uC744 \uB098\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "A\uC5D0\uAC8C\uB294 \uB3CC\uC544\uBCFC \uC218 \uC788\uB294 \uAE30\uC5B5\uC774
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC88B\uC558\uB358 \uAC83\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC2EB\uC5C8\uB358 \uAC83\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC2E4\uD328\uD588\uB358 \uAC83\uB3C4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB098\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB5A0\uC62C\uB824\uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC774\uBC88\uC5D0\uB3C4
      \uC774\uC5B4\uC9C0\uB294 \uAC83\uC740 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
