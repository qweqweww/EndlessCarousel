--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_AfterMemory1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: C
    text: "\u2026\u2026\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: C?
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB098 \uC721\uC0C1\uBD80\uC600\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B4?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E8\uAC70\uB9AC. 100\uBBF8\uD130\uB791 200\uBBF8\uD130."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uAE30\uC5B5\uB0AC\uC5B4. \uD2B8\uB799\uC774\uB791, \uCF54\uCE58\uB2D8\uC774\uB791,
      \uC2A4\uD0C0\uD305 \uBE14\uB85D\uC774 \uBC1C\uC5D0 \uB2FF\uB294 \uB290\uB08C\uC774\uB791."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB798\uC11C \uADF8\uB807\uAC8C \uBE60\uB974\uC168\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uBE60\uB974\uAE34. \uADF8\uB54C \uAE30\uB85D 11\uCD08 31\uC774\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uAE4C 11\uCD08 02\uC600\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB2C8\uAE4C. \uC5EC\uAE30\uC11C \uC5C4\uCCAD \uBE68\uB77C\uC84C\uC5B4.
      \uBC18\uCE59\uC774\uB77C\uB2C8\uAE4C."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB798\uC11C \uCD9C\uBC1C \uC790\uC138\uB3C4 \uC54C\uC558\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. 4\uBC88 \uB808\uC778. \uB0B4\uAC00 \uC81C\uC77C \uC88B\uC544\uD558\uB358
      \uC790\uB9AC."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB54C\uB294 \uB9E8\uB0A0 '\uB2E4\uC74C \uB300\uD68C', '\uB2E4\uC74C
      \uAE30\uB85D' \uADF8\uB7AC\uC5B4. \uC6C3\uAE30\uC9C0. 1\uB4F1\uB3C4 \uC544\uB2C8\uC5C8\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "1\uB4F1 \uC544\uB2C8\uC5B4\uB3C4 \uADF8\uB807\uAC8C \uC5F4\uC2EC\uD788
      \uD574?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. 1\uB4F1 \uD558\uB824\uACE0 \uD55C \uAC8C \uC544\uB2C8\uB77C\u2026
      \uADF8\uB0E5 \uC5B4\uC81C\uBCF4\uB2E4 \uBE68\uB77C\uC9C0\uB294 \uAC8C \uC88B\uC558\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "0.04\uCD08. \uADF8\uAC70 \uD558\uB098 \uC904\uC774\uBA74 \uC77C\uC8FC\uC77C
      \uB0B4\uB0B4 \uAE30\uBD84 \uC88B\uC558\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uAC70, \uC88B\uC740 \uAC70\uB124."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC624, A\uAC00 \uCE6D\uCC2C\uD588\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\uCE6D\uCC2C \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: 203a15641f386d44f9c87e170550501f, type: 3}
    choices: []
  - speakerName: C
    text: "\uCE6D\uCC2C\uC778\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB2E4\uC74C\uC740?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB2E4\uC74C \uAE30\uB85D\uC740."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 8dc8459779a07b141a804f6f6a8d01c4, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC7A0\uAE50 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uAC74 \uAE30\uC5B5 \uC548 \uB098. \uC544\uC9C1."
    portrait: {fileID: 21300000, guid: 8c5fe1d8e0493904d9a9c148a436c224, type: 3}
    choices: []
  - speakerName: C
    text: "\uBB50, \uADF8\uB7F4 \uC218\uB3C4 \uC788\uC9C0. \uC55E\uC73C\uB85C \uAC00
      \uBCF4\uC790."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uBA3C\uC800 \uAC78\uC5C8\uB2E4. \uC774\uBC88\uC5D0\uB294 \uB6F0\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB300\uC2E0 \uAC70\uB9AC \uC606 \uBCA4\uCE58 \uCABD\uC744 \uD55C \uBC88
      \uB3CC\uC544\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
