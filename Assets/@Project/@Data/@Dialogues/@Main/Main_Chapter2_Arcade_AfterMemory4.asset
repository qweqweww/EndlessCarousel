%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_AfterMemory4
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "B\uB294 \uCC22\uC5B4\uC9C4 \uC0AC\uC9C4\uC744 \uD55C\uCC38 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC0AC\uC9C4 \uC18D \uBE48\uC790\uB9AC. \uADF8\uB9AC\uACE0 \uC9C0\uAE08,
      \uC790\uAE30 \uACC1\uC5D0 \uC11C \uC788\uB294 \uB124 \uC0AC\uB78C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uC81C\uBD80\uD130\uC600\uC744\uAE4C. \uC774 \uC0AC\uB78C\uB4E4\uC774,
      \uB2E4\uB978 \uC0AC\uB78C\uB4E4\uBCF4\uB2E4 \uC870\uAE08 \uB354 \uC88B\uC544\uC9C4
      \uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "B? \uC0AC\uC9C4 \uBB50\uC600\uC5B4?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uBB34\uAC83\uB3C4 \uC544\uB2D9\uB2C8\uB2E4. \uC624\uB798\uB41C
      \uC0AC\uC9C4\uC774\uC5D0\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: D
    text: "\uC57C, \uC774\uC81C \uC778\uD615\uBF51\uAE30 \uD55C \uD310 \uB354 \uD558\uC790.
      \uC774\uBC88\uC5D4 \uB0B4\uAC00 \uC7A1\uC544 \uC904\uAC8C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\u2026 \uAD1C\uCC2E\uC2B5\uB2C8\uB2E4. \uC800\uB294 \uC548 \uD574\uB3C4
      \uB3FC\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: D
    text: "\uAD1C\uCC2E\uAE34 \uBB50\uAC00. \uC544\uAE4C\uB294 \uD55C \uBC88\uB9CC
      \uB354 \uD558\uC790\uBA70."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "D \uC528 \uD63C\uC790 \uD558\uC2DC\uB294 \uAC8C \uB354 \uC7AC\uBC0C\uC744
      \uAC70\uC608\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uD55C \uAC78\uC74C \uBB3C\uB7EC\uC130\uB2E4. D\uAC00 \uB0B4\uBBFC
      \uC190\uC774 \uD5C8\uACF5\uC5D0 \uB0A8\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "B, \uAC8C\uC2DC\uD310\uC740? X\uB791 \uAC19\uC774 \uC4F4\uB2E4\uBA70."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uAC74\u2026 \uB2E4\uC74C\uC5D0 \uD560\uAC8C\uC694. \uC8C4\uC1A1\uD569\uB2C8\uB2E4."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: 
    text: "\uC0AC\uACFC\uD560 \uC77C\uC774 \uC544\uB2C8\uC5C8\uB2E4. \uADF8\uB798\uB3C4
      B\uB294 \uACE0\uAC1C\uB97C \uC219\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC874\uB313\uB9D0\uC774 \uCC98\uC74C \uB9CC\uB0AC\uC744 \uB54C\uCC98\uB7FC
      \uB531\uB531\uD574\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC800\uB294 \uD63C\uC790 \uC788\uC5B4\uB3C4 \uAD1C\uCC2E\uC544\uC694.
      \uC2E0\uACBD \uC4F0\uC9C0 \uB9C8\uC138\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uC624\uB77D\uC2E4 \uC548\uCABD \uAD6C\uC11D\uC73C\uB85C \uAC78\uC5B4\uAC14\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB50\uC57C."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uB098 \uBB50 \uD588\uC5B4? \uC544\uAE4C\uAE4C\uC9C4 \uC798 \uB180\uC558\uC796\uC544."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: C
    text: "\uB108 \uC544\uBB34\uAC83\uB3C4 \uC548 \uD588\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uC65C \uD53C\uD558\uB294\uB370."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: A
    text: "\uC9C0\uAE08 \uBAB0\uC544\uBD99\uC774\uBA74 \uB354 \uBA40\uC5B4\uC838."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB204\uAC00 \uBAB0\uC544\uBD99\uC778\uB300."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uADF8\uB807\uAC8C \uB9D0\uD558\uBA74\uC11C\uB3C4, B \uCABD\uC73C\uB85C
      \uAC00\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAD6C\uC11D\uC5D0 \uC549\uC740 B\uB294 \uC774\uB530\uAE08 \uACE0\uAC1C\uB97C
      \uB4E4\uC5B4 \uC774\uCABD\uC744 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uB208\uC774
      \uB9C8\uC8FC\uCE58\uAE30 \uC804\uC5D0 \uB2E4\uC2DC \uC219\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
