--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Apron
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uBCBD \uACE0\uB9AC\uC5D0 \uB0A1\uC740 \uC55E\uCE58\uB9C8\uAC00 \uAC78\uB824
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC00\uC2B4\uAED8\uC5D0 \uB178\uB780 \uC624\uB9AC \uADF8\uB9BC. \uB048
      \uD55C\uCABD\uC740 \uBA87 \uBC88\uC774\uB098 \uB2E4\uC2DC \uAFF0\uB9E8 \uC790\uAD6D\uC774
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC624\uB9AC\uB124. \uADC0\uC5FD\uB2E4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uC548 \uADC0\uC5EC\uC6CC. \uCD0C\uC2A4\uB7FD\uC9C0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7FC \uC65C \uADF8\uB807\uAC8C \uBD10?"
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uAFF0\uB9E8 \uC790\uAD6D\uC744 \uC190\uB05D\uC73C\uB85C \uB530\uB77C\uAC14\uB2E4.
      \uBC14\uB290\uC9C8\uC774 \uC090\uB6A4\uBE7C\uB6A4\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC774\uAC70, \uB048 \uB04A\uC5B4\uC84C\uC744 \uB54C \uAFF0\uB9E8 \uAC70."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC14\uB290\uC9C8 \uC9C4\uC9DC \uBABB\uD588\uAC70\uB4E0. \uC190\uAC00\uB77D
      \uCC14\uB9AC\uACE0 \uC5C4\uCCAD \uC9DC\uC99D \uB0B4\uBA74\uC11C."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB798\uB3C4 \uB05D\uAE4C\uC9C0 \uAFF0\uB9E4\uC168\uB124\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC84\uB9AC\uB77C\uB2C8\uAE4C \uC548 \uBC84\uB9AC\uB354\uB77C. \uC0C8\uB85C
      \uC0AC\uBA74 \uB3C8 \uB4E0\uB2E4\uACE0."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: 
    text: "\uC8FC\uBC29\uC5D0\uC11C \uC5B8\uB2C8\uAC00 \uACE0\uAC1C\uB97C \uB0B4\uBC00\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC57C, \uADF8\uAC70 \uB0B4 \uAC70\uC57C. \uB9CC\uC9C0\uC9C0 \uB9C8."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC548 \uB9CC\uC84C\uC5B4."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB9CC\uC84C\uC796\uC544. \uC190 \uC790\uAD6D \uB0AC\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uADF8\uAC8C \uC5B4\uB5BB\uAC8C \uBCF4\uC5EC!"
    portrait: {fileID: 21300000, guid: 21bd4aa4290022744b657525a11a3354, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC5B8\uB2C8 \uB208\uC740 \uB2E4 \uBCF4\uC5EC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uC55E\uCE58\uB9C8\uB97C \uD671 \uB193\uC558\uB2E4. \uADF8\uB7F0\uB370
      \uADC0\uAC00 \uBE68\uAC30\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
