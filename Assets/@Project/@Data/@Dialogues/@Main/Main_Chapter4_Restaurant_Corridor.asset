%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Corridor
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC8FC\uBC29 \uB4A4 \uBCF5\uB3C4. \uBE44\uC0C1\uAD6C \uD45C\uC2DC\uB4F1\uB9CC
      \uCD08\uB85D\uC0C9\uC73C\uB85C \uCF1C\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBCBD\uC5D0 \uB4F1\uC744 \uB300\uACE0 \uBC14\uB2E5\uC5D0 \uC549\uC544
      \uC788\uC5C8\uB2E4. \uBB34\uB98E\uC744 \uC138\uC6B0\uACE0, \uC5BC\uAD74\uC740
      \uBCF4\uC774\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB530\uB77C\uC624\uC9C0 \uB9D0\uB77C\uACE0 \uD588\uC796\uC544."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uB9D0\uC740 \uB4E4\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uAC00."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: B
    text: "\uD63C\uC790 \uC788\uACE0 \uC2F6\uC73C\uC2DC\uBA74, \uADF8\uB807\uAC8C
      \uD558\uC154\uB3C4 \uB3FC\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uC800\uD76C \uC800\uCABD\uC5D0 \uC788\uC744\uAC8C\uC694. \uC9C4\uC9DC\uB85C."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: 
    text: "\uADF8\uB8F9\uC774 \uB3CC\uC544\uC11C\uB824 \uD560 \uB54C\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC57C."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: 
    text: "\uBAA8\uB450 \uBA48\uCDC4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uAC00\uC9C0 \uB9D0\uB4E0\uAC00."
    portrait: {fileID: 21300000, guid: bf7395adac3d293499952692b509ac0e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC544\uBB34 \uB9D0 \uC5C6\uC774 D \uC606\uC5D0 \uC549\uC558\uB2E4.
      A\uB294 \uC870\uAE08 \uB5A8\uC5B4\uC9C4 \uBCBD\uC5D0 \uAE30\uB314\uB2E4. B\uB294
      \uB9DE\uC740\uD3B8\uC5D0 \uCABC\uADF8\uB824 \uC549\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uBCF5\uB3C4 \uB05D\uC5D0 \uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD55C\uCC38 \uB3D9\uC548 \uC544\uBB34\uB3C4 \uB9D0\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uAC54\uAC00."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8\uD55C\uD14C, \uB098 \uC880 \uADF8\uB9CC \uCC59\uAE30\uB77C\uACE0
      \uD588\uB300."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8\uB294 \uC2EB\uB2E4\uACE0 \uD588\uACE0."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB798\uC11C \uD5E4\uC5B4\uC9C0\uB824\uACE0 \uD588\uACE0."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uB7EC\uB2E4 \uC8FD\uC5C8\uC5B4."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: 
    text: "\uB9D0\uC774 \uB04A\uACBC\uB2E4. D\uB294 \uC228\uC744 \uD55C \uBC88 \uD06C\uAC8C
      \uB4E4\uC774\uC26C\uACE0, \uC544\uBB34\uB807\uC9C0 \uC54A\uC740 \uCC99 \uC774\uC5B4
      \uB9D0\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC6C3\uAE30\uC9C0. \uAE40\uBCF6 \uD574 \uC900\uB2E4\uACE0 \uB098\uAC14\uB294\uB370."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uB0B4\uAC00 \uC5C6\uC5C8\uC73C\uBA74 \uC2F8\uC6B8 \uC774\uC720\uB3C4
      \uC5C6\uC5C8\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB0E5 \uB458\uC774 \uC798 \uC0AC\uADC0\uB2E4\uAC00, \uC798 \uD5E4\uC5B4\uC9C0\uB4E0\uAC00,
      \uACB0\uD63C\uD558\uB4E0\uAC00 \uD588\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC5B8\uB2C8\uAC00 \uB098 \uB54C\uBB38\uC5D0 \uC8FD\uC740
      \uAC70\uC796\uC544."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uBC14\uB85C \uB300\uB2F5\uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8 \uC0AC\uB78C\uC774 \uD55C \uC9D3\uC774\uC796\uC544."
    portrait: {fileID: 21300000, guid: 034b6cc566d963d4786c674e2f8a3647, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uADF8 \uB9D0\uB9CC \uD588\uB2E4. \uB354 \uB367\uBD99\uC774\uC9C0
      \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC54C\uC544. \uC544\uB294\uB370."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uADF8\uB807\uAC8C \uC0DD\uAC01\uD558\uAC8C \uB418\uB294 \uAC74,
      \uC54C\uC544\uC694."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: B
    text: "\uB204\uAC00 \uD55C \uC77C\uC778\uB370\uB3C4, \uB0B4\uAC00 \uC788\uC5B4\uC11C
      \uADF8\uB807\uAC8C \uB41C \uAC83 \uAC19\uC740 \uAC70."
    portrait: {fileID: 21300000, guid: f58f64fac19eb7145ae9c407270a3497, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 573c992b11a9e1a4e85e8bf6c16595d2, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30 \uC788\uACE0 \uC2F6\uC740 \uAC83\uB3C4 \uC774\uD574\uB3FC."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5B8\uB2C8 \uC788\uC796\uC544. \uBC25 \uD574 \uC900\uB2E4\uC796\uC544.
      \uB098 \uAC19\uC544\uB3C4 \uC548 \uB098\uAC00."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB108\uB3C4 \uADF8\uB7AC\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uB098\uB3C4 \uADF8\uB7AC\uC5B4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC88B\uB2E4\uACE0 \uC5EC\uAE30 \uC788\uC5B4\uC57C \uD558\uB294 \uAC83\uB3C4
      \uC544\uB2C8\uACE0, \uC88B\uB2E4\uACE0 \uB5A0\uB098\uC57C \uD558\uB294 \uAC83\uB3C4
      \uC544\uB2C8\uACE0. \uADF8\uAC74 \uC544\uC9C1 \uBAB0\uB77C\uB3C4 \uB3FC."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB54 \uC18C\uB9AC\uC57C, \uADF8\uAC8C."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uB098\uB3C4 \uBAB0\uB77C. \uADF8\uB0E5 \uADF8\uB807\uB2E4\uACE0."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uC9E7\uAC8C \uC6C3\uC5C8\uB2E4. \uC6C3\uC74C\uC778\uC9C0 \uC228\uC778\uC9C0
      \uBAA8\uB97C \uC18C\uB9AC\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026X. \uB108\uB294 \uC65C \uC544\uBB34 \uB9D0\uB3C4 \uC548 \uD574."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices:
    - text: "\uC5B8\uB2C8\uD55C\uD14C \uC9C1\uC811 \uBB3C\uC5B4\uBCFC\uB798?"
      next: {fileID: 11400000, guid: 6707e996028afbe4eb0477d33330cf3f, type: 2}
      choiceId: Chapter4_D_Response_AskHer
      recordAsFlag: 1
    - text: "\uC9C0\uAE08 \uB2F9\uC7A5 \uB2F5\uC744 \uC815\uD558\uC9C0 \uC54A\uC544\uB3C4
        \uB3FC."
      next: {fileID: 11400000, guid: 8f82ad36383b6a74eaa5aaeed1011e71, type: 2}
      choiceId: Chapter4_D_Response_NoRush
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
