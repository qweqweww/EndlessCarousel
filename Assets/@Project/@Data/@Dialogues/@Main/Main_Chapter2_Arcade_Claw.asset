%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter2_Arcade_Claw
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC720\uB9AC \uC0C1\uC790 \uC548\uC5D0 \uC778\uD615\uC774 \uAC00\uB4DD\uD558\uB2E4.
      \uC704\uC5D0\uB294 \uC9D1\uAC8C\uAC00 \uB9E4\uB2EC\uB824 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC774\uAC74\u2026 \uC5B4\uB5BB\uAC8C \uD558\uB294 \uAC70\uC608\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uAC78 \uC9C4\uC9DC \uBAB0\uB77C?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uCC98\uC74C \uBD10\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC9C4\uC9DC\uAD6C\uB098."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uC7A0\uAE50 B\uC758 \uC5BC\uAD74\uC744 \uBCF4\uB354\uB2C8, \uB9D0\uD22C\uB97C
      \uBC14\uAFE8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB3D9\uC804 \uB123\uACE0, \uC774\uAC78\uB85C \uC9D1\uAC8C\uB97C \uC6C0\uC9C1\uC5EC.
      \uC778\uD615 \uC704\uC5D0\uC11C \uBC84\uD2BC \uB204\uB974\uBA74 \uB0B4\uB824\uAC00."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uADFC\uB370 \uAC70\uC758 \uC548 \uC9D1\uD600."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC548 \uC9D1\uD788\uB294\uB370\u2026 \uC65C \uD574\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uAC8C. \uC65C \uD560\uAE4C?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uD574\uBCF4\uBA74 \uC54C\uC544."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uB3D9\uC804 \uD558\uB098\uB97C B\uC758 \uC190\uC5D0 \uC950\uC5EC
      \uC8FC\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "B\uB294 \uD55C\uCC38 \uB9DD\uC124\uC774\uB2E4\uAC00 \uB3D9\uC804\uC744
      \uB123\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC9D1\uAC8C\uAC00 \uB0B4\uB824\uAC00, \uD1A0\uB07C \uC778\uD615\uC758
      \uADC0\uB97C \uC2A4\uCE58\uACE0, \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC774 \uC62C\uB77C\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC544\u2026."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uAE5D\uB2E4! \uAC70\uC758 \uB410\uB294\uB370."
    portrait: {fileID: 21300000, guid: 87236f2975df09c46a26e7bb24f15f01, type: 3}
    choices: []
  - speakerName: B
    text: "\uAC70\uC758\u2026 \uB41C \uAC70\uC608\uC694?"
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: D
    text: "\uC5B4. \uC644\uC804 \uAC70\uC758."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "D\uAC00 \uAC70\uC9D3\uB9D0\uD558\uB294 \uAC70\uC57C. \uD558\uB098\uB3C4
      \uC548 \uB410\uC5B4."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: B
    text: "\uD478\uD761."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: 
    text: "B\uAC00 \uC6C3\uC74C\uC744 \uD130\uB728\uB838\uB2E4. \uC6C3\uACE0 \uB098\uC11C
      \uC2A4\uC2A4\uB85C\uB3C4 \uB180\uB780 \uB4EF \uC785\uC744 \uAC00\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC8C4\uC1A1\uD574\uC694. \uADF8\uAC8C\u2026 \uB108\uBB34 \uC9C4\uC9C0\uD558\uAC8C
      \uB9D0\uC500\uD558\uC154\uC11C."
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uC6C3\uC9C0 \uB9C8. \uC9C4\uC9C0\uD588\uAC70\uB4E0."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: B
    text: "\uD55C \uBC88\uB9CC \uB354 \uD574\uBD10\uB3C4 \uB3FC\uC694?"
    portrait: {fileID: 21300000, guid: 29ab07840ba16ca46aa3431f1e7938ca, type: 3}
    choices: []
  - speakerName: X
    text: "\uD574."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB450 \uBC88\uC9F8\uB3C4 \uC2E4\uD328\uC600\uB2E4. B\uB294 \uB610 \uC6C3\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
