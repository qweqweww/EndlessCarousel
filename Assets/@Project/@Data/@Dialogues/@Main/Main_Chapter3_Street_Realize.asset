%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_Realize
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uCD9C\uBC1C\uC120 4\uBC88 \uCE78. C\uAC00 \uC228\uC744 \uACE0\uB974\uACE0
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uB2C8, \uC228\uC744 \uACE0\uB974\uB294 \uC2DC\uB289\uC744 \uD558\uACE0
      \uC788\uC5C8\uB2E4. \uC228\uC740 \uD558\uB098\uB3C4 \uCC28\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5B4, \uC654\uC5B4?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uBA87 \uBC88 \uB6F0\uC5C8\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBAB0\uB77C. \uC5F4 \uBC88? \uC2A4\uBB34 \uBC88?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uD558\uB098\uB3C4 \uC548 \uD798\uB4E4\uC5B4. \uC9C4\uC9DC\uB85C. \uB2E4\uB9AC\uB3C4
      \uC548 \uBB34\uAC81\uACE0, \uC228\uB3C4 \uC548 \uCC28."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30 \uC88B\uC740\uB370."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC9C4\uC9DC \uC88B\uC544. \uAC70\uC9D3\uB9D0 \uC544\uB2C8\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uB7FC \uC65C \uADF8\uB7F0 \uC5BC\uAD74\uC774\uC57C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uADFC\uB370 \uC880 \uC774\uC0C1\uD558\uB124."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uAE30\uB85D\uC774 \uC548 \uBC14\uB00C\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "11\uCD08 02\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uB9E4\uBC88. \uB300\uCDA9 \uB6F0\uC5B4\uB3C4, \uC9C4\uC9DC \uC5F4\uC2EC\uD788
      \uB6F0\uC5B4\uB3C4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uCC98\uC74C\uC5D4 \uC5C4\uCCAD \uC88B\uC558\uC5B4. \uB0B4\uAC00 11\uCD08
      02\uB77C\uB2C8. \uC61B\uB0A0\uC5D0 \uAFC8\uAFB8\uB358 \uC22B\uC790\uBCF4\uB2E4
      \uBE68\uB77C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uADFC\uB370 \uBA87 \uBC88 \uB6F0\uB2C8\uAE4C, \uB354 \uC904\uC77C \uC218\uAC00
      \uC5C6\uB354\uB77C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uB354 \uB298\uC9C0\uB3C4 \uC54A\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB9AC\uACE0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB9AC\uACE0 \uC800 \uB05D\uAE4C\uC9C0 \uAC00\uBA74, \uC774\uC0C1\uD558\uAC8C
      \uB610 \uC5EC\uAE30\uC57C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uAC70\uB9AC \uB05D\uC744 \uAC00\uB9AC\uCF30\uB2E4. \uAE43\uBC1C\uC774
      \uB298\uC5B4\uC120 \uAE38\uC774, \uBA40\uB9AC\uC11C \uD750\uB9BF\uD558\uAC8C
      \uD718\uC5B4\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBD84\uBA85 \uACC4\uC18D \uC55E\uC73C\uB85C \uB6F0\uC5C8\uB294\uB370,
      \uC815\uC2E0 \uCC28\uB9AC\uBA74 \uC774 \uCD9C\uBC1C\uC120 \uC55E\uC5D0 \uC11C
      \uC788\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC8C \uBB50\uC57C. \uBB34\uC12D\uAC8C."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uBB34\uC12D\uC9C4 \uC54A\uC544. \uADF8\uB0E5."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uB300\uD68C \uB0A0\uC9DC\uAC00 \uC801\uD78C \uC885\uC774\uAC00 \uC5C6\uC5B4.
      \uCF54\uCE58\uB2D8\uB3C4 \uC5C6\uACE0. \uB2E4\uC74C \uC2DC\uC98C\uB3C4 \uC5C6\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uAE30\uB85D\uC740 \uB9E4\uC77C '\uC624\uB298\uC758 \uAE30\uB85D'\uC774\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uCD9C\uBC1C\uC120\uC744 \uBC1C\uB05D\uC73C\uB85C \uBB38\uC9C8\uB800\uB2E4.
      \uD558\uC580 \uC120\uC740 \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026C."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uC7A0\uAE50 \uC598\uAE30\uD558\uC790."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
