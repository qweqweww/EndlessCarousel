  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_X_Search_Alone
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB124 \uC0AC\uB78C\uC774 \uB5A0\uB09C \uB4A4, X\uB294 \uAD11\uC7A5 \uBC18\uB300\uD3B8\uC73C\uB85C
      \uAC78\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC9C0\uB3C4\uC5D0 \uC5C6\uB294 \uAE38. \uC544\uC9C1 \uC544\uBB34\uB3C4
      \uAC00 \uBCF4\uC9C0 \uC54A\uC740 \uB180\uC774\uACF5\uC6D0 \uC548\uCABD."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uAE38 \uB05D\uC5D0 \uBB34\uC5C7\uC774 \uC788\uB294\uC9C0\uB294
      \uC54C \uC218 \uC5C6\uC5C8\uB2E4. \uC544\uBB34\uAC83\uB3C4 \uC5C6\uC744\uC9C0\uB3C4
      \uBAB0\uB790\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC9C0\uAE08 \uC5C6\uB2E4\uB294 \uAC70\uB791, \uC601\uC6D0\uD788 \uC5C6\uB2E4\uB294
      \uAC74 \uB2E4\uB974\uB2C8\uAE4C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uAC78\uC5C8\uB2E4. \uCC98\uC74C\uC73C\uB85C, \uC544\uBB34\uB3C4
      \uC815\uD574 \uC8FC\uC9C0 \uC54A\uC740 \uBC29\uD5A5\uC73C\uB85C."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
