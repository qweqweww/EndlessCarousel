  lines:
  - speakerName: 
    text: "\uD68C\uC804\uBAA9\uB9C8 \uC55E\uC758 \uB300\uAE30 \uC904\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC904\uC744 \uC815\uB9AC\uD558\uB294 \uAC00\uC774\uB4DC \uBD09\uACFC
      \uC548\uB0B4 \uD45C\uC9C0\uD310\uC774 \uAC00\uC9C0\uB7F0\uD788 \uB193\uC5EC
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC0AC\uB78C\uB9CC \uC788\uC73C\uBA74 \uC9C4\uC9DC \uD3C9\uBC94\uD55C
      \uB180\uC774\uACF5\uC6D0\uC778\uB370."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uADF8\uB7EC\uAC8C\uC694..."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC0AC\uB78C\uC774 \uC5C6\uB2E4\uB294 \uAC8C \uC81C\uC77C \uC548 \uD3C9\uBC94\uD558\uC9C0\uB9CC."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADF8\uAC74 \uADF8\uB807\uC9C0."
