%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_EndArch
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC70\uB9AC \uB05D, \uBCC4 \uC7A5\uC2DD\uC774 \uB2EC\uB9B0 \uCEE4\uB2E4\uB780
      \uC544\uCE58\uAC00 \uC11C \uC788\uB2E4. \uD37C\uB808\uC774\uB4DC \uD589\uB82C\uC774
      \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uC9C0\uB098\uAC00\uB294 \uBB38\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uCE58 \uB108\uBA38\uB85C \uD68C\uC804\uBAA9\uB9C8 \uC9C0\uBD95\uC774
      \uD750\uB9BF\uD558\uAC8C \uBCF4\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uAC00 \uB05D\uC774\uC57C? \uACB0\uC2B9\uC120 \uAC19\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC544\uCE58 \uC544\uB798\uAE4C\uC9C0 \uB2E8\uC228\uC5D0 \uB2EC\uB824\uAC14\uB2E4.
      \uADF8\uB9AC\uACE0 \uB3CC\uC544\uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB3C4\uCC29!"
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uB798\uC11C? \uBB50 \uC5C6\uC5B4?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5C6\uB124. \uD14C\uC774\uD504\uB3C4 \uC5C6\uACE0, \uBC15\uC218\uB3C4
      \uC5C6\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB05D\uAE4C\uC9C0 \uC654\uB294\uB370. \uD558\uB098\uB3C4 \uC548 \uD798\uB4E4\uACE0,
      \uB05D\uB09C \uB290\uB08C\uB3C4 \uC548 \uB098."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: B
    text: "\uC544\uCE58 \uB108\uBA38\uB85C \uAC00\uBA74, \uB2E4\uC2DC \uAD11\uC7A5\uC774\uC5D0\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58. \uC800\uCABD\uC73C\uB85C \uAC00\uBA74 \uAD11\uC7A5\uC774\uACE0,
      \uC774\uCABD\uC73C\uB85C \uB3CC\uC544\uAC00\uBA74 \uB610 \uCD9C\uBC1C\uC120\uC774\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC544\uCE58 \uAE30\uB465\uC5D0 \uC190\uC744 \uC9DA\uC5C8\uB2E4.
      \uBB34\uC5B8\uAC00\uB97C \uD655\uC778\uD558\uB4EF\uC774, \uC624\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uB05D\uAE4C\uC9C0 \uC654\uB2E4\uB294 \uB9D0, \uC5B4\uB514\uC11C
      \uB4E4\uC5C8\uB358 \uAC83 \uAC19\uC740\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\uB204\uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uBAB0\uB77C. \uB204\uAC00 \uC5C4\uCCAD \uAE30\uBED0\uD558\uBA74\uC11C.
      '\uB05D\uAE4C\uC9C0 \uC654\uC5B4\uC694, \uB05D\uAE4C\uC9C0.'"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
