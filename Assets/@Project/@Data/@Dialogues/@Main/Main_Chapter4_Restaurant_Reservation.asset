  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_Reservation
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC785\uAD6C \uC606 \uC608\uC57D \uBCF4\uB4DC. \uB0A0\uC9DC\uC640 \uC2DC\uAC04\uC774
      \uBD84\uD544\uB85C \uC801\uD600 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uAE08\uC694\uC77C 7\uC2DC \u2014 2\uC778'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC704\uC5D0 \uC904\uC774 \uADF8\uC5B4\uC838 \uC788\uACE0, \uC606\uC5D0
      \uB2E4\uC2DC \uC801\uD600 \uC788\uB2E4. '6\uC2DC \uBC18\uC73C\uB85C \uB2F9\uAE40
      \u2014 2\uC778'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8 \uC704\uC5D0\uB3C4 \uC904. '\uCDE8\uC18C'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uC608\uC57D\uC744 \uC5EC\uB7EC \uBC88 \uBC14\uAFE8\uB124\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uB0A0\uC9DC \uC7A1\uAE30 \uD798\uB4E4\uC5C8\uB098 \uBCF4\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u20266\uC2DC \uBC18\uC774\uBA74 \uB0B4 \uD559\uC6D0 \uB05D\uB098\uAE30
      \uC804\uC774\uB124."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC544\uB2C8. \uADF8\uB0E5."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBD84\uD544 \uAC00\uB8E8\uAC00 \uBB3B\uC740 \uC190\uAC00\uB77D\uC744
      \uBC14\uC9C0\uC5D0 \uB2E6\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC790\uAFB8 \uC2DC\uAC04\uC744 \uB2F9\uAE30\uB354\uB77C. \uB0B4\uAC00
      \uC9D1\uC5D0 \uC624\uAE30 \uC804\uC73C\uB85C."
    portrait: {fileID: 21300000, guid: 256f72b9db763414f835c1f7e1cbd70c, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
