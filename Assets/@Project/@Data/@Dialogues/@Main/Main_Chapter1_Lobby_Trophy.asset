  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter1_Lobby_Trophy
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC720\uB9AC \uC9C4\uC5F4\uC7A5 \uC548\uC5D0 \uC791\uC740 \uD2B8\uB85C\uD53C\uAC00
      \uB193\uC5EC \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC1B\uCE68\uC5D0 \uC0C8\uACA8\uC9C4 \uAE00\uC790\uB294 '\uC7A5\uB824\uC0C1'."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC7A5\uB824\uC0C1\uC774\uBA74 \uC88B\uC740 \uAC70\uC57C?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uC0C1\uC740 \uC0C1\uC774\uC9C0."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: A
    text: "\uC81C\uC77C \uC544\uB798."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: A
    text: "\uC7A5\uB824\uC0C1. \uC0C1 \uC911\uC5D0\uC11C\uB294 \uC81C\uC77C \uC544\uB798\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uC798 \uC544\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB0E5."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: 
    text: "A\uB294 \uC9C4\uC5F4\uC7A5 \uC720\uB9AC\uC5D0 \uBE44\uCE5C \uC790\uAE30
      \uC5BC\uAD74\uC744 \uC7A0\uAE50 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
