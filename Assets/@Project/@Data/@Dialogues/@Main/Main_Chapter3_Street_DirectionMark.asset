%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_DirectionMark
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC70\uB9AC \uBC14\uB2E5\uC5D0 \uCEE4\uB2E4\uB780 \uD654\uC0B4\uD45C\uAC00
      \uADF8\uB824\uC838 \uC788\uB2E4. \uBCC4\uC774 \uADF8\uB824\uC9C4 \uC6D0\uC5D0\uC11C
      \uC2DC\uC791\uD574, \uAC70\uB9AC \uB05D \uC544\uCE58 \uCABD\uC744 \uAC00\uB9AC\uD0A4\uACE0
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC6D0 \uB458\uB808\uC5D0\uB294 \uD558\uC580 \uC120\uC774 \uB465\uAE00\uAC8C
      \uADF8\uC5B4\uC838 \uC788\uB2E4. \uD37C\uB808\uC774\uB4DC \uD589\uB82C\uC774
      \uCD9C\uBC1C\uD558\uB294 \uC790\uB9AC\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uD37C\uB808\uC774\uB4DC \uCD9C\uBC1C\uD558\uB294 \uB370\uC778\uAC00 \uBCF4\uB124.
      \uD654\uC0B4\uD45C \uC5C4\uCCAD \uD06C\uB2E4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uAC70 \uBCF4\uB2C8\uAE4C \uB610 \uB6F0\uACE0 \uC2F6\uC5B4\uC9C0\uB294\uB370."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC29\uAE08 \uB6F0\uACE0 \uC654\uC796\uC544."
    portrait: {fileID: 21300000, guid: 450c4bef8511b444b8094cf7719cd3eb, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uB2C8\uAE4C. \uC774\uC0C1\uD558\uC9C0."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: C
    text: "\uD654\uC0B4\uD45C\uAC00 \uC55E\uB9CC \uAC00\uB9AC\uD0A4\uC796\uC544.
      \uC800\uAE30\uAE4C\uC9C0 \uAC00\uB77C\uACE0."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uB7F0 \uAC70 \uBCF4\uBA74 \uBAB8\uC774 \uBA3C\uC800 \uADFC\uC9C8\uADFC\uC9C8\uD574."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: B
    text: "\uC55E\uC73C\uB85C\uB9CC \uAC00\uB294 \uAE38\uC774\uB124\uC694. \uB3CC\uC544\uC624\uB294
      \uD654\uC0B4\uD45C\uB294 \uC5C6\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58. \uC55E\uC73C\uB85C\uB9CC."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uBCC4 \uC6D0 \uB458\uB808\uC758 \uD558\uC580 \uC120\uC744 \uBC1C\uB05D\uC73C\uB85C
      \uD55C \uBC88 \uBC1F\uC544 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5EC\uAE30\uAC00 \uCD9C\uBC1C\uC120\uC774\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
