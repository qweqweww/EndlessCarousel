  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_XChoice
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB124 \uC0AC\uB78C\uC758 \uB300\uB2F5\uC744 \uBAA8\uB450 \uB4E4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uAD11\uC7A5 \uD55C\uAC00\uC6B4\uB370, \uCC98\uC74C \uB208\uC744
      \uB5B4\uB358 \uC790\uB9AC\uB85C \uB3CC\uC544\uC654\uB2E4. \uB124 \uC0AC\uB78C\uC774
      \uD558\uB098\uB458 \uB2E4\uAC00\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB2E4 \uB4E4\uC5C8\uC9C0?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\uC774\uC81C \uB108."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: B
    text: "X \uC528\uB294\u2026 \uC5B4\uB5BB\uAC8C \uD558\uC2E4 \uAC70\uC608\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uC815\uBB38\uC740 \uBABB \uC4F4\uB2E4\uBA70. \uADF8\uB7FC \uBB50 \uD560
      \uAC74\uB370."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "X\uB294 \uC815\uBB38\uC744 \uBCF4\uC558\uB2E4. \uADF8\uB9AC\uACE0 \uD68C\uC804\uBAA9\uB9C8\uB97C,
      \uAD11\uC7A5\uC744, \uB124 \uC0AC\uB78C\uC744 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE30\uC5B5\uD560 \uC218 \uC788\uB294 \uAC00\uC7A5 \uC624\uB798\uB41C
      \uC7A5\uBA74\uC740 \uC5EC\uAE30\uC600\uB2E4. \uADF8 \uB4A4\uC758 \uBAA8\uB4E0
      \uAC83\uB3C4 \uC5EC\uAE30\uC11C \uC2DC\uC791\uB418\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices:
    - text: "\uC5EC\uAE30\uC5D0 \uB0A8\uB294\uB2E4"
      next: {fileID: 11400000, guid: 532aa0334ace41140b1cbaac8ae06246, type: 2}
      choiceId: Final_X_Stay
      recordAsFlag: 1
    - text: "\uB2E4\uB978 \uBC29\uBC95\uC744 \uCC3E\uC544\uBCF8\uB2E4"
      next: {fileID: 11400000, guid: 5b21043b58a0e0c4a823ab8ac09987af, type: 2}
      choiceId: Final_X_Search
      recordAsFlag: 1
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
