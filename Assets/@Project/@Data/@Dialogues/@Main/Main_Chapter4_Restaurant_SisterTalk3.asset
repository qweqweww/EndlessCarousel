%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Restaurant_SisterTalk3
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uC2DC\uB044\uB7FD\uAC8C \uC6CD\uC744 \uD754\uB4E4\uACE0
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC5B4, \uC654\uB2E4. \uD654\uC7A5\uC2E4 \uB418\uAC8C \uC624\uB798 \uAC14\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uBB50\uC57C. \uB2E4 \uAC19\uC774 \uAC14\uB2E4 \uC654\uC5B4? \uB108\uB124
      \uD654\uC7A5\uC2E4\uB3C4 \uAC19\uC774 \uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB124. \uAC19\uC774 \uAC00\uC694."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uCE5C\uD558\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uC870\uB9AC\uB300 \uC606\uC5D0 \uC130\uB2E4. \uD55C\uCC38 \uC5B8\uB2C8\uC758
      \uC190\uC744 \uBCF4\uB2E4\uAC00, \uC785\uC744 \uC5F4\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC751."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB9CC\uC57D\uC5D0\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\uB9CC\uC57D\uC5D0 \uB098 \uB54C\uBB38\uC5D0, \uB204\uAD74 \uD3EC\uAE30\uD574\uC57C
      \uD588\uC73C\uBA74."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uD6C4\uD68C\uD588\uC5B4?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "\uC6CD \uC18C\uB9AC\uAC00 \uC7A0\uAE50 \uBA48\uCDC4\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uBB50\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uAC11\uC790\uAE30 \uBB34\uC2A8 \uB4DC\uB77C\uB9C8 \uCC0D\uB0D0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB300\uB2F5\uC774\uB098 \uD574."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC74C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uB2E4\uC2DC \uC6CD\uC744 \uD754\uB4E4\uC5C8\uB2E4.
      \uAE40\uCE58\uAC00 \uD280\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB0B4\uAC00 \uB204\uAD6C \uB9CC\uB098\uACE0 \uB204\uAD6C \uC548 \uB9CC\uB098\uB294
      \uAC78 \uC65C \uB124 \uD0D3\uC73C\uB85C \uD574."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB0B4\uAC00 \uC2EB\uC73C\uBA74 \uB0B4\uAC00 \uD5E4\uC5B4\uC9C0\uB294
      \uAC70\uC9C0. \uADF8\uAC78 \uC65C \uB124\uAC00 \uB4E4\uACE0 \uC788\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB108 \uADF8\uB7F0 \uAC70 \uB4E4\uACE0 \uB2E4\uB2C8\uB77C\uACE0 \uB0B4\uAC00
      \uB108 \uD0A4\uC6E0\uB0D0? \uBB34\uAC81\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uB9AC\uACE0 \uB108 \uB54C\uBB38\uC5D0 \uD3EC\uAE30\uD560 \uC0AC\uB78C\uC774\uBA74,
      \uC560\uCD08\uC5D0 \uB0B4 \uC0AC\uB78C \uC544\uB2C8\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB410\uC9C0? \uC774\uC0C1\uD55C \uAC70 \uBB3B\uC9C0 \uB9D0\uACE0 \uACC4\uB780\uC774\uB098
      \uAEBC\uB0B4. \uB450 \uAC1C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uB0C9\uC7A5\uACE0 \uBB38\uC744 \uC5F4\uC5C8\uB2E4. \uACC4\uB780\uC744
      \uAEBC\uB0B4\uB294 \uC190\uC774 \uC870\uAE08 \uB5A8\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB2E4\uC6B4 \uB300\uB2F5\uC774\uC5C8\uB2E4. \uC5B8\uB2C8\uB77C\uBA74
      \uAF2D \uADF8\uB807\uAC8C \uB9D0\uD588\uC744 \uAC83\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uAC83\uC774 \uC5B8\uB2C8\uC758 \uB300\uB2F5\uC778\uC9C0, D\uAC00
      \uAE30\uC5B5\uD558\uB294 \uC5B8\uB2C8\uC758 \uB300\uB2F5\uC778\uC9C0\uB294
      \uC544\uBB34\uB3C4 \uC54C \uC218 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB3C4 \uBB3B\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uB450 \uAC1C \uB9DE\uC9C0."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uB450 \uAC1C \uB9DE\uC544. \uBC18\uC219."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC54C\uC544."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  nextDialogue: {fileID: 11400000, guid: 37abeb6e02962994a827b646a664827c, type: 2}
  skipNextIfFlag: 
