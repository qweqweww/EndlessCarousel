%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter5_Staff_EntryRecord
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC11C\uB958\uD568 \uB9E8 \uC704 \uCE78\uC5D0 \uB450\uAEBC\uC6B4 \uC7A5\uBD80\uAC00
      \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uD45C\uC9C0\uC5D0 \uC801\uD78C \uAE00\uC790\uB294 \uD558\uB098\uBFD0\uC774\uB2E4.
      '\uC785\uC7A5'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCCAB \uC7A5\uC744 \uB118\uAE30\uC790 \uCEE4\uB2E4\uB797\uAC8C \uC22B\uC790\uAC00
      \uC801\uD600 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC678\uBD80 \uC785\uC7A5 \uAE30\uB85D: 4'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u20264."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "4\uBA85\uC774\uB77C\uACE0?"
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uC544\uB798\uB85C \uB124 \uC904\uC774 \uC774\uC5B4\uC84C\uB2E4. \uC774\uB984
      \uB300\uC2E0, \uC9E7\uC740 \uBB38\uC7A5\uC774 \uC801\uD600 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uCCAB \uBC88\uC9F8 \u2014 \uC9C0\uB2C8\uACE0 \uC628 \uAC83: \uB05D\uB098\uC9C0
      \uC54A\uC740 \uC5F0\uC8FC. \uBC14\uAE65\uC5D0 \uB0A8\uC740 \uAC83: \uC788\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB450 \uBC88\uC9F8 \u2014 \uC9C0\uB2C8\uACE0 \uC628 \uAC83: \uACE0\uB974\uC9C0
      \uBABB\uD55C \uC0AC\uB78C\uB4E4. \uBC14\uAE65\uC5D0 \uB0A8\uC740 \uAC83: \uC788\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uC138 \uBC88\uC9F8 \u2014 \uC9C0\uB2C8\uACE0 \uC628 \uAC83: \uB2E4\uC2DC
      \uB2EC\uB9AC\uACE0 \uC2F6\uC740 \uB2E4\uB9AC. \uBC14\uAE65\uC5D0 \uB0A8\uC740
      \uAC83: \uC788\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "'\uB124 \uBC88\uC9F8 \u2014 \uC9C0\uB2C8\uACE0 \uC628 \uAC83: \uC2DD\uC5B4
      \uBC84\uB9B0 \uC800\uB141. \uBC14\uAE65\uC5D0 \uB0A8\uC740 \uAC83: \uC788\uC74C.'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC5F0\uC8FC."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: B
    text: "\uACE0\uB974\uC9C0 \uBABB\uD55C\u2026 \uC0AC\uB78C\uB4E4."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: C
    text: "\uB2E4\uB9AC. \uC774\uAC74 \uB098\uB124. \uD655\uC2E4\uD788."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC800\uB141."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uC544\uBB34\uB3C4 \uC6C3\uC9C0 \uC54A\uC558\uB2E4. \uB9E4\uD45C\uC18C
      \uC7A5\uBD80\uC758 \uB3C4\uC7A5\uBCF4\uB2E4 \uD6E8\uC52C \uC815\uD655\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC678\uBD80\uC5D0\uC11C \uB4E4\uC5B4\uC628 \uC0AC\uB78C\uC774 \uB124
      \uBA85\uC774\uB77C\uB294 \uAC70\uC9C0. \uC6B0\uB9AC \uB137."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uADFC\uB370 \uC6B0\uB9B0 \uB2E4\uC12F\uC774\uC796\uC544."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uC190\uAC00\uB77D\uC73C\uB85C \uC0AC\uB78C \uC218\uB97C \uC14C\uB2E4.
      A, B, C, D. \uADF8\uB9AC\uACE0 X."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uD558\uB098, \uB458, \uC14B, \uB137, \uB2E4\uC12F."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: B
    text: "\uB2E4\uC12F \uBC88\uC9F8 \uC904\uC740\u2026 \uC5C6\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 09c7d92bb325cdd4f973bcb83e751243, type: 3}
    choices: []
  - speakerName: A
    text: "\uB9E4\uD45C\uC18C\uB3C4. \uC0AC\uC9C4\uB3C4. \uC77C\uC9C0\uB3C4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC774\uBC88\uC5D4 \uB300\uCDA9 \uC368\uC11C \uADF8\uB7F0
      \uAC78\uB85C \uD558\uAE30\uC5D4, \uC880 \uB9CE\uB2E4."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: X
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB2E4\uC12F \uBA85\uC774 \uC788\uC5C8\uB2E4. \uBC14\uAE65\uC5D0\uC11C
      \uC628 \uC0AC\uB78C\uC740 \uB137\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uBC14\uAE65\uC5D0 \uB0A8\uC740 \uAC83: \uC788\uC74C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uADF8 \uC904\uC774, \uB098\uD55C\uD14C\uB294 \uC5C6\uB124."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC544\uC9C1 \uBAB0\uB77C. \uB354 \uBD10."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
