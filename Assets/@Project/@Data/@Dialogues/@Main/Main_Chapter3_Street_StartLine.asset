%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_StartLine
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC70\uB9AC \uCD08\uC785, \uBC14\uB2E5\uC5D0 \uD558\uC580 \uC120\uC774
      \uAC00\uB85C\uB85C \uADF8\uC5B4\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC120 \uB4A4\uB85C \uCE78\uC774 \uC5EC\uB7EC \uAC1C \uB098\uB258\uC5B4
      \uC788\uACE0, \uCE78\uB9C8\uB2E4 \uC22B\uC790\uAC00 \uC801\uD600 \uC788\uB2E4.
      1\uBD80\uD130 8\uAE4C\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\uD37C\uB808\uC774\uB4DC \uCC28\uAC00 \uC11C\uB294 \uC790\uB9AC\uC77C\uAE4C\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: D
    text: "\uCC28\uAC00 \uC5EC\uB35F \uB300\uB098 \uB098\uB780\uD788 \uC11C?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544\uB0D0. \uC774\uAC74\u2026"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC544\uBB34\uB807\uC9C0 \uC54A\uAC8C 4\uBC88 \uCE78 \uC55E\uC5D0
      \uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB9AC\uACE0 \uBAB8\uC744 \uC219\uC5EC, \uC190\uB05D\uC744 \uC120
      \uBC14\uB85C \uB4A4\uC5D0 \uC9DA\uC5C8\uB2E4. \uD55C\uCABD \uBB34\uB98E\uC774
      \uBC14\uB2E5\uC5D0 \uB2FF\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB204\uAC00 \uAC00\uB974\uCCD0 \uC900 \uAC83\uB3C4 \uC544\uB2CC\uB370,
      \uC790\uC138\uAC00 \uC774\uC0C1\uD558\uAC8C \uBC18\uB4EF\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uBB50 \uD558\uB0D0?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5B4?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC790\uAE30 \uC190\uC744 \uB0B4\uB824\uB2E4\uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uB098 \uC774\uAC70 \uC5B4\uB5BB\uAC8C \uC54C\uC9C0?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: X
    text: "\uBAB8\uC774 \uAE30\uC5B5\uD558\uB294 \uAC70 \uC544\uB0D0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7F0\uAC00 \uBD10. \uBA38\uB9AC\uB294 \uBAA8\uB974\uACA0\uB294\uB370,
      \uC190\uC774 \uC54C\uC544."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uB807\uAC8C \uC788\uB2E4\uAC00\u2026 '\uCC28\uB837' \uD558\uBA74
      \uC5C9\uB369\uC774 \uB4E4\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uAC00 \uC5C9\uB369\uC774\uB97C \uC0B4\uC9DD \uB4E4\uC5B4 \uC62C\uB838\uB2E4.
      \uBAB8 \uC804\uCCB4\uAC00 \uC55E\uC73C\uB85C \uAE30\uC6B8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB2E4\uC74C\uC5D0 '\uD0D5' \uC18C\uB9AC\uAC00 \uB098\uBA74\u2014"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uAC70\uAE30\uC11C \uBA48\uCDC4\uB2E4. \uCD9C\uBC1C\uD558\uC9C0
      \uC54A\uACE0, \uADF8 \uC790\uC138 \uADF8\uB300\uB85C \uBA87 \uCD08\uB97C \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "C \uC528?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: C
    text: "\uC544, \uC751."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC18C\uB9AC\uAC00 \uC548 \uB098\uB2C8\uAE4C \uCD9C\uBC1C\uC744 \uBABB
      \uD558\uACA0\uB124. \uBC84\uB987\uC778\uAC00."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC6C3\uC73C\uBA74\uC11C \uC77C\uC5B4\uB0AC\uC9C0\uB9CC, \uD55C\uB3D9\uC548
      4\uBC88 \uCE78\uC744 \uB0B4\uB824\uB2E4\uBCF4\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "4\uBC88."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: A
    text: "\uC65C 4\uBC88\uC5D0 \uC130\uC5B4."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uBAB0\uB77C. \uADF8\uB0E5 \uAC70\uAE30\uAC00 \uB0B4 \uC790\uB9AC
      \uAC19\uC558\uC5B4."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
