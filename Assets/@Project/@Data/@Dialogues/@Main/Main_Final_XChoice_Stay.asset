  lines:
  - speakerName: X
    text: "\uC5EC\uAE30 \uC788\uC744\uB798."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uC5EC\uAE30\uAC00 \uB0B4\uAC00 \uCC98\uC74C \uB208 \uB72C \uB370\uACE0,
      \uC9C0\uAE08\uAE4C\uC9C0 \uC0B4\uC544\uC628 \uB370\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uACFC\uAC70\uB294 \uC5C6\uC5C8\uC9C0\uB9CC, \uC5EC\uAE30\uC11C\uBD80\uD130\uB294
      \uB2E4 \uAE30\uC5B5\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uC5EC\uAE30\uAC00 \uB0B4 \uC9D1\uC778 \uAC83
      \uAC19\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC9D1\uC774\uB77C. \uC88B\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB798."
