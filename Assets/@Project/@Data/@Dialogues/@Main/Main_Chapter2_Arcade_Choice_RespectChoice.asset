  lines:
  - speakerName: X
    text: "\uADF8 \uC0AC\uB78C\uC774 \uB2E4\uCE60\uC9C0\uB294 \uB124\uAC00 \uD63C\uC790
      \uC815\uD560 \uC77C\uC774 \uC544\uB2C8\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uB124?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: X
    text: "\uB2E4\uCE58\uB354\uB77C\uB3C4, \uADF8\uAC74 \uADF8 \uC0AC\uB78C\uB3C4
      \uAC19\uC774 \uC815\uD558\uB294 \uAC70\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uADF8\uB7F0 \uAC74, \uC0DD\uAC01\uD574 \uBCF8 \uC801 \uC5C6\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: 
    text: "B\uB294 \uD55C\uB3D9\uC548 \uB9D0\uC774 \uC5C6\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
