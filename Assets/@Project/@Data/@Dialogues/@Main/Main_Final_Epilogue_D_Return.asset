MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_D_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC791\uC740 \uC9D1. \uBD80\uC5CC\uC5D0 \uBD88\uC774 \uCF1C\uC838 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uD504\uB77C\uC774\uD32C \uC55E\uC5D0 \uC11C \uC788\uC5C8\uB2E4.
      \uAE40\uCE58\uB97C \uC798\uAC8C \uC370\uC5C8\uB2E4. \uC124\uD0D5 \uBC18 \uC21F\uAC08."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uACC4\uB780\uC744 \uB450 \uAC1C \uAE7C\uB2E4. \uD558\uB098\uB294 \uB178\uB978\uC790\uAC00
      \uD130\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC544 \uC9C4\uC9DC."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "\uAE40\uCE58\uBCF6\uC74C\uBC25\uC740 \uD0D4\uB2E4. \uBC14\uB2E5\uC774
      \uC0C8\uAE4C\uB9F8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB204\uB8FD\uC9C0\uC57C, \uC774\uAC74."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: 
    text: "D\uB294 \uD63C\uC790 \uC6C3\uB2E4\uAC00, \uC7A0\uAE50 \uC6B8\uC5C8\uB2E4.
      \uADF8\uB9AC\uACE0 \uB2E4 \uBA39\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uC5C6\uC5C8\uB2E4. \uB0B4\uC77C\uB3C4 \uC5C6\uC744
      \uAC83\uC774\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB798\uB3C4 \uB0B4\uC77C \uC544\uCE68\uC5D0 \uBA39\uC744 \uACC4\uB780\uC740,
      \uB0C9\uC7A5\uACE0\uC5D0 \uB450 \uAC1C \uB0A8\uC544 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
