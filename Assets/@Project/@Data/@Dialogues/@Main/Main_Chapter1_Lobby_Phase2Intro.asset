  m_Name: Main_Chapter1_Lobby_Phase2Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: C
    text: "\uADFC\uB370 \uC800\uCABD \uAC8C\uC2DC\uD310, \uBB50\uAC00 \uBC14\uB010
      \uAC83 \uAC19\uC9C0 \uC54A\uC544?"
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: D
    text: "\uBC14\uB00C\uAE34 \uBB50\uAC00 \uBC14\uB00C\uC5B4."
    portrait: {fileID: 21300000, guid: 2e9b1842956010b41994ab8856c49044, type: 3}
    choices: []
  - speakerName: 
    text: "\uBC29\uAE08\uAE4C\uC9C0 \uBE44\uC5B4 \uC788\uB358 \uAC8C\uC2DC\uD310\uC5D0
      \uC885\uC774 \uD55C \uC7A5\uC774 \uBD99\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: B
    text: "\u2026\uC544\uAE4C\uB294 \uBD84\uBA85 \uC5C6\uC5C8\uC5B4\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
  - speakerName: 
    text: "\uC548\uB0B4 \uB370\uC2A4\uD06C \uC606 \uBD84\uC2E4\uBB3C \uBCF4\uAD00\uD568\uB3C4,
      \uC11C\uB78D \uD558\uB098\uAC00 \uC5F4\uB824 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uBCF4\uB7EC \uAC00\uC790."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
