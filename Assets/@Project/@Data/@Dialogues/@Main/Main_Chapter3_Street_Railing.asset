%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter3_Street_Railing
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAC70\uB9AC \uAC00\uC7A5\uC790\uB9AC\uB97C \uB530\uB77C \uB0AE\uC740
      \uB09C\uAC04\uC774 \uC774\uC5B4\uC838 \uC788\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uBCF4\uB2C8, C\uAC00 \uAC78\uC73C\uBA74\uC11C \uB09C\uAC04\uC5D0
      \uC190\uC744 \uC5B9\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uB108 \uC65C \uB09C\uAC04 \uC7A1\uACE0 \uAC78\uC5B4?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC5B4?"
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uADF8\uC81C\uC57C \uC790\uAE30 \uC190\uC744 \uBCF4\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7EC\uAC8C. \uC65C \uC7A1\uACE0 \uC788\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uC544\uAE4C \uADF8\uB807\uAC8C \uB6F0\uB358 \uC560\uAC00."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uBC84\uB987\uC778\uAC00 \uBD10. \uC190\uC774 \uADF8\uB0E5 \uAC00."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: C
    text: "\uC774\uAC70 \uC7A1\uACE0 \uC788\uC73C\uBA74 \uB9C8\uC74C\uC774 \uC880
      \uB193\uC5EC. \uC606\uC5D0 \uBB50\uAC00 \uC788\uB2E4\uB294 \uAC8C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC774\uC0C1\uD55C \uBC84\uB987\uC774\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uCE58."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC190\uC744 \uB5BC\uACE0 \uAC78\uC5C8\uB2E4. \uBA87 \uAC78\uC74C
      \uB4A4, \uC190\uC740 \uB2E4\uC2DC \uB09C\uAC04 \uC704\uC5D0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uADF8\uAC78 \uBD24\uC9C0\uB9CC, \uC774\uBC88\uC5D0\uB294 \uC544\uBB34
      \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB300\uC2E0 \uAC78\uC74C\uC744 \uC870\uAE08 \uB2A6\uCDB0 C \uC606\uC5D0
      \uC130\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
