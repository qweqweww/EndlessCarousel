%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Opening
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uC815\uBB38 \uCABD \uD558\uB298\uC774 \uC870\uAE08 \uBC1D\uC544\uC838
      \uC788\uC5C8\uB2E4. \uB180\uC774\uACF5\uC6D0\uC5D0\uC11C\uB294 \uCC98\uC74C
      \uBCF4\uB294 \uC0C9\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAD11\uC7A5\uC5D0\uB294 \uB2E4\uC12F\uC774 \uBAA8\uC5EC \uC788\uC5C8\uB2E4.
      \uC544\uBB34\uB3C4 \uBA3C\uC800 \uB9D0\uC744 \uAEBC\uB0B4\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026\uC2AC\uC2AC \uC815\uD574\uC57C\uACA0\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\uBB58."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uC54C\uC796\uC544. \uB098\uAC08\uC9C0, \uC788\uC744\uC9C0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\uC624\uB298\u2026 \uC815\uD574\uC57C \uD574\uC694?"
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uB204\uAC00 \uC815\uD558\uB77C\uACE0 \uD55C \uAC74 \uC544\uB2C8\uC9C0."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: C
    text: "\uC751. \uADFC\uB370 \uC774\uB300\uB85C \uACC4\uC18D \uBBF8\uB8E8\uBA74,
      \uADF8\uAC8C \uB610 \uC815\uD55C \uAC8C \uB418\uC796\uC544."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uADF8\uAC74 \uADF8\uB807\uB124."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: C
    text: "\uAC01\uC790 \uC815\uD558\uC790. \uB204\uAC00 \uB300\uC2E0 \uC815\uD574
      \uC8FC\uB294 \uAC70 \uB9D0\uACE0."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: B
    text: "\u2026\u2026\uB124."
    portrait: {fileID: 21300000, guid: 441a73f85b437df4db47c2b015aaf9ca, type: 3}
    choices: []
  - speakerName: A
    text: "\uC815\uD558\uBA74 \uB9D0\uD574."
    portrait: {fileID: 21300000, guid: 9601c58ca14311247acb6db199a17d5f, type: 3}
    choices: []
  - speakerName: D
    text: "X\uB294?"
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\uB09C \uB2E4 \uB4E3\uACE0 \uC815\uD560\uAC8C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC21C\uC11C\uAC00 \uC65C \uADF8\uB798."
    portrait: {fileID: 21300000, guid: a527c22c19f74ae46bf161a3f4fba21a, type: 3}
    choices: []
  - speakerName: X
    text: "\uADF8\uB0E5. \uB4E4\uC5B4 \uBCF4\uACE0 \uC2F6\uC5B4\uC11C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC88B\uC544. \uADF8\uB7FC X\uAC00 \uD55C \uBA85\uC529 \uCC3E\uC544\uC640.
      \uAC01\uC790 \uC88B\uC544\uD558\uB294 \uB370 \uAC00 \uC788\uC744\uAC8C."
    portrait: {fileID: 21300000, guid: bcaf5c12b7af5204a9ca7f34c2f6d0b6, type: 3}
    choices: []
  - speakerName: 
    text: "\uB137\uC740 \uAD11\uC7A5 \uC5EC\uAE30\uC800\uAE30\uB85C \uD769\uC5B4\uC84C\uB2E4.
      \uAC01\uC790 \uAC00\uC7A5 \uC624\uB798 \uBA38\uBB3C\uB358 \uACF3\uC774 \uBCF4\uC774\uB294
      \uC790\uB9AC\uB85C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uB124 \uC0AC\uB78C\uC744 \uCC28\uB840\uB85C \uCC3E\uC544\uAC00\uAE30\uB85C
      \uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
