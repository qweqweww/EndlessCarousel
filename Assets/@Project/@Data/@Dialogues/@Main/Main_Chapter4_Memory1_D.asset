%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Chapter4_Memory1_D
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uADF8\uB0A0 \uC774\uD6C4\uB85C, \uC9D1\uC740 \uAC11\uC790\uAE30 \uC870\uC6A9\uD574\uC84C\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBD80\uBAA8\uB2D8\uC758 \uC2E0\uBC1C\uC774 \uD604\uAD00\uC5D0\uC11C \uCE58\uC6CC\uC84C\uB2E4.
      \uC2DD\uD0C1 \uC758\uC790 \uB450 \uAC1C\uAC00 \uBE44\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uB2E4\uC12F \uC0B4\uC774\uC5C8\uB2E4. \uC5B8\uB2C8\uB294 \uC5F4\uC77C\uACF1
      \uC0B4\uC774\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCCAB \uBC88\uC9F8 \uC544\uCE68."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "D, \uC77C\uC5B4\uB098. \uC720\uCE58\uC6D0 \uAC00\uC57C \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\u2026\u2026\uC5C4\uB9C8\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\u2026\u2026"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624\uB298\uBD80\uD130 \uC5B8\uB2C8\uAC00 \uAE68\uC6CC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC544\uCE68\uC740 \uAE40\uCE58\uBCF6\uC74C\uBC25\uC774\uC5C8\uB2E4. \uC5B8\uB2C8\uAC00
      \uCC98\uC74C \uD574 \uBCF8 \uC694\uB9AC\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBC14\uB2E5\uC774 \uC0C8\uAE4C\uB9E3\uAC8C \uD0D4\uACE0, \uB108\uBB34
      \uC9F0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uD0D4\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uD0C4 \uAC70 \uC544\uB2C8\uC57C. \uB204\uB8FD\uC9C0\uC57C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC9DC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uB7FC \uBB3C \uB9C8\uC154."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBB3C\uC744 \uC138 \uCEF5 \uB9C8\uC168\uB2E4. \uADF8\uB798\uB3C4
      \uD55C \uADF8\uB987\uC744 \uB2E4 \uBA39\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uADF8\uB0A0 \uBC24 \uBD80\uC5CC\uC5D0\uC11C \uD63C\uC790
      \uC694\uB9AC\uCC45\uC744 \uD3B4 \uB193\uACE0 \uC788\uC5C8\uB2E4. \uAC00\uACC4\uBD80\uB3C4
      \uC606\uC5D0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uBB3C \uB9C8\uC2DC\uB7EC \uB098\uC624\uC790, \uC5B8\uB2C8\uB294
      \uAC00\uACC4\uBD80\uB97C \uC2AC\uCA4D \uB36E\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC548 \uC790\uACE0 \uBB50 \uD574."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8\uB294?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC5B8\uB2C8\uB294 \uC5B4\uB978\uC774\uB77C \uB2A6\uAC8C \uC790\uB3C4
      \uB3FC."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8 \uACE0\uB4F1\uD559\uC0DD\uC774\uC796\uC544."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\u2026\u2026\uC2DC\uB044\uB7EC. \uB4E4\uC5B4\uAC00 \uC790."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uACA8\uC6B8\uC5D0 D\uAC00 \uC5F4\uC774 \uB0AC\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uBC24\uC0C8 \uC218\uAC74\uC744 \uAC08\uC544 \uC8FC\uC5C8\uB2E4.
      \uB2E4\uC74C \uB0A0 \uD559\uAD50\uC5D0 \uAC00\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8, \uD559\uAD50 \uC548 \uAC00?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC624\uB298\uC740 \uB561\uB561\uC774."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC120\uC0DD\uB2D8\uD55C\uD14C \uD63C\uB098."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC5B8\uB2C8\uB294 \uC548 \uD63C\uB098. \uC5B8\uB2C8\uB294 \uBB34\uC12D\uAC70\uB4E0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uAC00 \uC6C3\uB2E4\uAC00 \uAE30\uCE68\uC744 \uD588\uB2E4. \uC5B8\uB2C8\uAC00
      \uB4F1\uC744 \uB450\uB4DC\uB838\uB2E4. \uC190\uC774 \uCC28\uAC00\uC6E0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB458\uC740 \uC790\uC8FC \uC2F8\uC6E0\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uC591\uB9D0 \uC880 \uB4A4\uC9D1\uC5B4 \uBC97\uC9C0 \uB9D0\uB77C\uACE0!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC5B8\uB2C8\uB3C4 \uBA38\uB9AC\uCE74\uB77D \uB9E8\uB0A0 \uB5A8\uC5B4\uB728\uB9AC\uC796\uC544!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uADF8\uAC70\uB791 \uADF8\uAC70\uB791 \uAC19\uB0D0!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uAC19\uC544!"
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uBB38\uC774 \uCF85 \uB2EB\uD614\uB2E4. \uD55C \uC2DC\uAC04 \uB4A4, \uC5B8\uB2C8\uAC00
      \uBB38\uC744 \uB450\uB4DC\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\u2026\u2026\uBC25 \uBA39\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: D
    text: "\uC548 \uBA39\uC5B4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: "\uC5B8\uB2C8"
    text: "\uAE40\uBCF6\uC774\uC57C. \uACC4\uB780 \uB450 \uAC1C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "D\uB294 \uBB38\uC744 \uC5F4\uC5C8\uB2E4. \uACC4\uB780\uC740 \uBC18\uC219\uC774\uC5C8\uB2E4.
      \uC774\uBC88\uC5D0\uB294 \uD0C0\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB0A0 \uC774\uD6C4\uB85C \uAE40\uCE58\uBCF6\uC74C\uBC25\uC740 \uB298
      \uACC4\uB780 \uB450 \uAC1C\uC600\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC5B8\uB2C8\uB294 \uBD80\uBAA8 \uB300\uC2E0\uC774 \uC544\uB2C8\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB0E5, D\uC5D0\uAC8C \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC0AC\uB78C\uC774
      \uB418\uC5B4 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
