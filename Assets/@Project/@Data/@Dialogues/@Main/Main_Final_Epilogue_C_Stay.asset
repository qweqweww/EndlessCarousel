  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_C_Stay
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uD37C\uB808\uC774\uB4DC \uAC70\uB9AC\uC758 \uD558\uC580 \uC120\uC740
      \uC624\uB298\uB3C4 \uBC18\uB4EF\uD588\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "C\uB294 \uB2EC\uB838\uB2E4. \uAC70\uB9AC \uB05D\uAE4C\uC9C0, \uB2E4\uC2DC
      \uCC98\uC74C\uC73C\uB85C."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC804\uAD11\uD310\uC5D0\uB294 \uAC19\uC740 \uC22B\uC790\uAC00 \uB5B4\uB2E4.
      '11.02'"
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\uC5ED\uC2DC \uADF8\uB300\uB85C\uB124."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: 
    text: "C\uB294 \uC6C3\uC73C\uBA70 \uB2E4\uC2DC \uCD9C\uBC1C\uC120\uC5D0 \uC130\uB2E4.
      \uC228\uC740 \uD558\uB098\uB3C4 \uCC28\uC9C0 \uC54A\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAE30\uB85D\uC740 \uBC14\uB00C\uC9C0 \uC54A\uC558\uB2E4. \uADF8\uB798\uB3C4
      \uBC1C\uC774 \uB545\uC5D0 \uB2FF\uB294 \uB290\uB08C\uC740, \uB9E4\uBC88 \uC88B\uC558\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
