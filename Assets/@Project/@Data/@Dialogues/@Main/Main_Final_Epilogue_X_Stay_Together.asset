  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Epilogue_X_Stay_Together
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uAD11\uC7A5\uC5D0\uB294 \uC544\uC9C1 \uD568\uAED8 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC774
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uADF8\uB4E4\uC740 \uB0AE\uC5D0\uB294 \uAC01\uC790 \uC88B\uC544\uD558\uB294
      \uACF3\uC73C\uB85C \uD769\uC5B4\uC84C\uB2E4\uAC00, \uC800\uB141\uC774\uBA74
      \uAD11\uC7A5\uC73C\uB85C \uB3CC\uC544\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "X\uB294 \uAD11\uC7A5 \uD55C\uAC00\uC6B4\uB370, \uCC98\uC74C \uB208\uC744
      \uB5B4\uB358 \uC790\uB9AC\uC5D0\uC11C \uADF8\uB4E4\uC744 \uAE30\uB2E4\uB838\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uC774\uC81C X\uC5D0\uAC8C\uB294 \uAE30\uB2E4\uB9B4 \uC0AC\uB78C\uC774
      \uC788\uC5C8\uB2E4. \uADF8\uB9AC\uACE0 \uD568\uAED8 \uB5A0\uC62C\uB9B4 \uACFC\uAC70\uAC00
      \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\u2026\u2026\uC5B4\uC11C \uC640."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
