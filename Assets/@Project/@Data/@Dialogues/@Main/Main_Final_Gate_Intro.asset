  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Gate_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "\uB2E4\uC12F\uC740 \uC815\uBB38\uAE4C\uC9C0 \uD568\uAED8 \uAC78\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uCC98\uC74C \uAE7C\uC744 \uB54C\uBD80\uD130 \uADF8 \uC790\uB9AC\uC5D0
      \uC788\uB358 \uBB38. \uB298 \uB2EB\uD600 \uC788\uB358 \uBB38."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uAC00\uAE4C\uC774 \uAC00\uC790, \uBB38\uD2C8 \uC0AC\uC774\uB85C \uC544\uCE68
      \uAC19\uC740 \uACF5\uAE30\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: 
    text: "\uB5A0\uB098\uAE30\uB85C \uD55C \uC0AC\uB78C\uC5D0\uAC8C\uB294, \uBB38\uC774
      \uC870\uAE08\uC529 \uC5F4\uB824 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  nextDialogue: {fileID: 0}
