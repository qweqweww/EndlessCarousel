--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b03aabcd643edeb4d89315746360808b, type: 3}
  m_Name: Main_Final_Talk_A_Return
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speakerName: 
    text: "A\uB294 \uBC29\uC1A1 \uC2A4\uD53C\uCEE4 \uC544\uB798 \uBCA4\uCE58\uC5D0
      \uC549\uC544 \uC788\uC5C8\uB2E4. \uC190\uAC00\uB77D\uC774 \uBB34\uB98E \uC704\uC5D0\uC11C
      \uC18C\uB9AC \uC5C6\uC774 \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5C8\uB2E4."
    portrait: {fileID: 0}
    choices: []
  - speakerName: X
    text: "\uBB50 \uCCD0?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC544\uBB34\uAC83\uB3C4. \uBC84\uB987\uC774\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uC815\uD588\uC5B4. \uB098\uAC08 \uAC70\uC57C."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uB2E4\uC2DC \uC798\uD560 \uC218 \uC788\uC744\uC9C0\uB294 \uBAB0\uB77C."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: A
    text: "\uBB34\uB300\uC5D0 \uB2E4\uC2DC \uC124 \uC218 \uC788\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uACE0. \uC9D1\uB3C4 \uADF8\uB300\uB85C\uC77C \uAC70\uACE0."
    portrait: {fileID: 21300000, guid: 5bf593b62d1d28147802cc9cc8533a90, type: 3}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uADF8\uB798\uB3C4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uD55C \uBC88\uC740 \uB0B4\uAC00 \uCE58\uACE0 \uC2F6\uC5B4\uC11C \uCCD0
      \uBCF4\uACE0 \uC2F6\uC5B4."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uC5EC\uAE30\uC11C \uCE5C \uAC70, \uADF8\uAC8C \uCC98\uC74C\uC774\uC5C8\uAC70\uB4E0.
      \uC810\uC218 \uC0DD\uAC01 \uC548 \uD558\uACE0 \uCE5C \uAC70."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: X
    text: "\uC88B\uC558\uC5B4?"
    portrait: {fileID: 0}
    choices: []
  - speakerName: A
    text: "\u2026\u2026\uC88B\uC558\uC5B4."
    portrait: {fileID: 21300000, guid: f1c749ec53789e24284806aa1c95dc04, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8\uB7EC\uB2C8\uAE4C \uBC16\uC5D0\uC11C\uB3C4 \uD55C \uBC88\uC740
      \uD574 \uBD10\uC57C\uC9C0. \uD2C0\uB824\uB3C4."
    portrait: {fileID: 21300000, guid: f1c749ec53789e24284806aa1c95dc04, type: 3}
    choices: []
  - speakerName: A
    text: "\uCE58\uACE0 \uC2F6\uC73C\uBA74 \uCE58\uB77C\uACE0 \uD588\uC796\uC544.
      \uB124\uAC00."
    portrait: {fileID: 21300000, guid: 3829046e21eb2014aac420be0e636761, type: 3}
    choices: []
  - speakerName: A
    text: "\uADF8 \uB9D0, \uC0DD\uAC01\uBCF4\uB2E4 \uC624\uB798 \uB0A8\uB354\uB77C."
    portrait: {fileID: 21300000, guid: 203a15641f386d44f9c87e170550501f, type: 3}
    choices: []
  nextDialogue: {fileID: 0}
  skipNextIfFlag: 
