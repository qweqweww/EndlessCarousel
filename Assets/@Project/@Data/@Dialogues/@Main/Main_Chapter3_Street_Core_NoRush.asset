  lines:
  - speakerName: X
    text: "\uC544\uC9C1 \uBB58 \uD560\uC9C0\uB294 \uC815\uD558\uC9C0 \uC54A\uC544\uB3C4
      \uB418\uC9C0."
    portrait: {fileID: 0}
    choices: []
  - speakerName: C
    text: "\u2026\u2026"
    portrait: {fileID: 21300000, guid: 8dc8459779a07b141a804f6f6a8d01c4, type: 3}
    choices: []
  - speakerName: C
    text: "\uADF8\uB7F0\uAC00."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uB9E8\uB0A0 '\uB2E4\uC74C'\uC774 \uC815\uD574\uC838 \uC788\uC5C8\uC5B4\uC11C,
      \uC548 \uC815\uD574\uC9C4 \uAC8C \uBB34\uC11C\uC6E0\uB294\uB370."
    portrait: {fileID: 21300000, guid: c8dafde970db87447946901de2fbe24e, type: 3}
    choices: []
  - speakerName: C
    text: "\uC548 \uC815\uD574\uC84C\uB2E4\uB294 \uAC74, \uC544\uC9C1 \uC544\uBB34\uAC70\uB098
      \uB420 \uC218 \uC788\uB2E4\uB294 \uAC70\uAE30\uB3C4 \uD558\uB124."
    portrait: {fileID: 21300000, guid: 3350833a0bb0a2f44af924f3d24e6d6f, type: 3}
    choices: []
  - speakerName: B
    text: "\uB124. \uADF8\uB7F0 \uAC83 \uAC19\uC544\uC694."
    portrait: {fileID: 21300000, guid: a045b68230aa5944584404a4682be24a, type: 3}
    choices: []
